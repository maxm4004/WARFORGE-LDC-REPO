MOVE = {
    tolleranzaD = 0.02,   -- oltre il limite di così si blocca la fine fase
    tick        = 0.1,    -- secondi fra due disegni dei fili durante il trascinamento
    contattoD   = 0.05,   -- unità "a contatto" (carica)
    -- fili dalla partenza di ogni base: verde entro il limite, rosso oltre
    filoOk      = { 0.2, 0.9, 0.2 },
    filoKo      = { 1, 0.1, 0.1 },
    filoSpessore = 0.06,
    caricaColor = { r = 0.85, g = 0.45, b = 0.0 },
    tintaMirino = { 0.9, 0.4, 0.1 },
    cerchio     = { 1, 0.6, 0 },        -- cerchio del movimento dei Generali (IEF)
    muoviColor  = { r = 0.72, g = 0.56, b = 0.18 },
    -- pannello di movimento (IEF 6_move)
    giallo         = { 1, 0.8, 0.1 },   -- corridoio, perno (giallo IEF)
    tickManuale    = 0.05,              -- IEF_MOVE_MANUAL_TICK
    manigliaAvantiD = 0.07,             -- maniglia del perno davanti all'angolo (IEF 0,4")
    pernoMaxGradi  = 90,                -- perno libero: massimo per presa (ripetibile)
    margineNemicoD = 0.1,               -- l'Avanti si ferma così davanti al nemico
    allineaTol     = 0.1,
    listaMax       = 10,
    caricaPernoGradi = 45,              -- 9.6: perno iniziale della carica
    pinD           = 1,                 -- 9.3: arco frontale nemico entro 1D
    pinPernoGradi  = 45,                -- 9.3: perno massimo della pinnata
    quadratoColor  = { r = 0.45, g = 0.30, b = 0.30 },                -- righe della lista CARICHE               -- CHARGE_ALIGN_TOL di IEF
}

