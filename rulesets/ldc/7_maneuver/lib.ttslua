-- ============================================================
-- WARFORGE LDC — 7_maneuver/lib.ttslua
-- Cariche e Manovre, primo giro (regolamento 7.2-7.3, 9).
--
-- Movimento libero (9.1): si prendono e si posano le basi; ogni
-- base non può allontanarsi dalla sua posizione di partenza più
-- della velocità dell'unità (spostamento netto). Durante il
-- trascinamento un filo per base dalla partenza (verde entro il
-- limite, rosso oltre); al rilascio la base oltre il limite
-- torna al limite lungo il filo, quella che non può muovere
-- torna alla partenza. ANNULLA rimette l'unità com'era.
-- Chi non muove: fanteria e artiglieria in HOLDS o fuori
-- comando, chi ha sparato (tranne schermagliatori e artiglieria
-- a cavallo). Cavalleria in HOLDS o fuori comando: velocità di
-- pinnata, niente carica. Generali: 4D, come IEF.
-- CARICA: mirino sul bersaglio (entro la velocità di carica,
-- nell'arco frontale di 45°); poi le basi si portano a
-- contatto entro la velocità di carica. Le cariche restano per
-- la Mischia.
-- Pannello di movimento di IEF (MUOVI: avanti elastico, perno a
-- maniglia, annulla) in panel.ttslua; dichiarazione e movimento
-- di carica di IEF in charge.ttslua.
-- Rimandati: unità pinnate, terreno, interpenetrazioni, quadrato
-- d'emergenza, obbligo per i Generali di muovere per ultimi.
-- ============================================================

-- ============================================================
--                      CHI MUOVE E QUANTO
-- ============================================================

-- ============================================================
-- FUNZIONE: move_commandGeneral(slot, u)
-- Base del Generale che comanda l'unità: di Brigata, o di
-- Divisione per le unità senza Brigata.
-- ============================================================
function move_commandGeneral(slot, u)
    local m = u.meta
    local ruolo = m.brigata and DEPLOY_RUOLO.GEN_BRIGATA or DEPLOY_RUOLO.GEN_DIVISIONE
    for _, g in pairs(main_generalsOfSide(slot)) do
        local gm = g.meta
        if gm.ruolo == ruolo and gm.divisione == m.divisione and (ruolo == DEPLOY_RUOLO.GEN_DIVISIONE or gm.brigata == m.brigata) then
            return g
        end
    end
    return nil
end
-- ============================================================
-- FUNZIONE: move_outOfCommand(slot, u)
-- Fuori comando (7.3)? Ritorna vero/falso e la distanza in D.
-- ============================================================
function move_outOfCommand(slot, u)
    local g = move_commandGeneral(slot, u)
    if not g then return true, nil end
    local raggio = LDC_COMANDO_RAGGIO.tipi[u.meta.tipo or ""] or LDC_COMANDO_RAGGIO.default
    local d = main_unitDistanceD(u, g)
    return d == nil or d > raggio, d
end
-- ============================================================
-- FUNZIONE: move_unitLimit(slot, u)
-- Distanza massima per base in D, o nil e il motivo se non
-- può muovere. Ritorna limite, motivo (o nota).
-- ============================================================
function move_unitLimit(slot, u)
    local tipo = u.meta.tipo or ""
    local v = LDC_VELOCITA[tipo] or {}
    if u.generale then
        return (LDC_VELOCITA.GEN or {}).velocita or 4, "Generale"
    end

    -- 9.1 / 11: i Generali muovono dopo tutte le altre unità
    if move_generalsStarted(slot) then
        return nil, "i Generali hanno gia' mosso"
    end
    -- 9.2: la fanteria in quadrato non muove
    if main_unitFormation(u) == "quadrato" then
        return nil, "in quadrato"
    end

    local sparato = fire_hasFired(u.key)
    if sparato and not LDC_MUOVE_DOPO_TIRO[tipo] then
        return nil, "ha sparato"
    end
    -- 9.1: chi ha cambiato formazione muove alla velocità di pinnata
    if MOVE_STATE.formazione and MOVE_STATE.formazione[u.key] then
        if v.pinnata then return v.pinnata, "ha cambiato formazione: velocita' di pinnata" end
        return nil, "ha cambiato formazione"
    end

    local holds = command_unitInHolds(slot, u.meta)
    local fuori = move_outOfCommand(slot, u)
    if holds or fuori then
        local motivo = holds and "HOLDS" or "fuori comando"
        if main_unitCategory(u.meta) == CATEGORIA.CAVALLERIA and v.pinnata then
            return v.pinnata, motivo .. ": velocita' di pinnata"
        end
        return nil, motivo
    end

    if MOVE_STATE.cariche[u.key] and v.carica then
        return v.carica, "in carica"
    end
    -- 9.3: pinnata
    local pin = move_pinInfo(slot, u)
    if pin then
        if pin.libera and v.pinnata then
            return v.pinnata, "pinnata da " .. move_pinNames(pin) .. ": velocita' di pinnata"
        end
        return 0, "pinnata da " .. move_pinNames(pin) .. ": solo carica su di lei o perno di 45 gradi"
    end
    if sparato and v.dopoTiro then
        return v.dopoTiro, "ha sparato"
    end
    return v.velocita, nil
end
-- ============================================================
-- FUNZIONE: move_canCharge(slot, u)
-- Può caricare? Ritorna vero/falso e il motivo.
-- ============================================================
function move_canCharge(slot, u)
    if u.generale then return false, "Generale" end
    local v = LDC_VELOCITA[u.meta.tipo or ""] or {}
    if not v.carica then return false, "non carica" end
    if fire_hasFired(u.key) then return false, "ha sparato" end
    if command_unitInHolds(slot, u.meta) then return false, "HOLDS" end
    if move_outOfCommand(slot, u) then return false, "fuori comando" end
    if move_hasMoved(u.key) then return false, "ha gia' mosso" end
    if main_unitFormation(u) == "quadrato" then return false, "in quadrato" end
    if MOVE_STATE.formazione and MOVE_STATE.formazione[u.key] then return false, "ha cambiato formazione (9.1)" end
    if move_generalsStarted(slot) then return false, "i Generali hanno gia' mosso" end
    return true, nil
end

-- ============================================================
--                         PARTENZA
-- ============================================================

-- ============================================================
-- FUNZIONE: move_recordStart(u)
-- Posa di partenza di tutte le basi (la prima volta).
-- ============================================================
function move_recordStart(u)
    if MOVE_STATE.partenza[u.key] then return end
    local posa = {}
    for _, b in ipairs(u.basi) do
        local p, r = b.getPosition(), b.getRotation()
        posa[b.getGUID()] = { x = p.x, y = p.y, z = p.z, ry = r.y }
    end
    MOVE_STATE.partenza[u.key] = posa
    -- formazione di partenza (ANNULLA la rimette)
    local s = UNIT_STATE[u.key] or {}
    MOVE_STATE.partenzaFz = MOVE_STATE.partenzaFz or {}
    MOVE_STATE.partenzaFz[u.key] = { formazione = s.formazione, quadrato = s.quadrato }
    move_pinRecord(u.side, u)
end
-- ============================================================
-- FUNZIONE: move_baseDistanceD(u, obj)
-- Spostamento netto della base dalla partenza, in D.
-- ============================================================
function move_baseDistanceD(u, obj)
    local s = MOVE_STATE.partenza[u.key] and MOVE_STATE.partenza[u.key][obj.getGUID()]
    if not s then return 0 end
    local p = obj.getPosition()
    local dx, dz = p.x - s.x, p.z - s.z
    return main_inchToD(main_ttsToInch(math.sqrt(dx * dx + dz * dz)))
end
-- ============================================================
-- FUNZIONE: move_hasMoved(unitKey)
-- ============================================================
function move_hasMoved(unitKey)
    local posa = MOVE_STATE.partenza[unitKey]
    if not posa then return false end
    for guid, s in pairs(posa) do
        local b = getObjectFromGUID(guid)
        if b then
            local p = b.getPosition()
            if math.abs(p.x - s.x) > 0.01 or math.abs(p.z - s.z) > 0.01 then return true end
        end
    end
    return false
end
-- ============================================================
-- FUNZIONE: move_restore(u)
-- L'unità torna alla posa di partenza; carica annullata.
-- ============================================================
function move_restore(u)
    local posa = MOVE_STATE.partenza[u.key]
    if posa then
        for _, b in ipairs(u.basi) do
            local s = posa[b.getGUID()]
            if s then
                b.setPosition({ x = s.x, y = s.y, z = s.z })
                b.setRotation({ x = 0, y = s.ry, z = 0 })
            end
        end
    end
    local fz = MOVE_STATE.partenzaFz and MOVE_STATE.partenzaFz[u.key]
    if fz then
        UNIT_STATE[u.key] = UNIT_STATE[u.key] or { disordini = 0 }
        UNIT_STATE[u.key].formazione = fz.formazione
        UNIT_STATE[u.key].quadrato = fz.quadrato
    end
    MOVE_STATE.partenza[u.key] = nil
    MOVE_STATE.cariche[u.key] = nil
    for _, t in ipairs({ "budget", "lati", "dopoCarica", "pannello", "perno", "latiFini", "pinnate", "formazione", "partenzaFz" }) do
        if MOVE_STATE[t] then MOVE_STATE[t][u.key] = nil end
    end
end

-- ============================================================
--                     PRESA E RILASCIO
-- ============================================================

-- ============================================================
-- FUNZIONE: move_baseOfActive(player_color, obj)
-- Base di un'unità (o Generale) dello schieramento attivo, presa
-- da un suo giocatore in Manovra. Ritorna u, slot.
-- ============================================================
function move_baseOfActive(player_color, obj)
    if not ENGINE or ENGINE.phase ~= PHASE.MANEUVER then return nil end
    local meta = main_baseMeta(obj)
    if not meta or not meta.unitKey or meta.side ~= TURN.activeSide then return nil end
    if not main_colorInSide(player_color, meta.side) then return nil end
    local u = main_unitOrGeneral(meta.side, meta.unitKey)
    return u, meta.side
end
-- ============================================================
-- FUNZIONE: move_onPickUp(player_color, obj)
-- ============================================================
function move_onPickUp(player_color, obj)
    if not ENGINE or ENGINE.phase ~= PHASE.MANEUVER then return end
    -- pannello aperto sull'unità: prendere una base = avanti elastico
    local meta = main_baseMeta(obj)
    if MOVE_PANEL and meta and meta.unitKey == MOVE_PANEL.key and not MOVE_MANUAL and not MOVE_PIVOT
       and main_colorInSide(player_color, MOVE_PANEL.slot) then
        local pu, ps = move_panelUnit()
        if pu and move_budget(ps, pu) > 0.001 then move_manualOn() end
    end
    if move_manualOnPickUp(player_color, obj) then return end
    local u, slot = move_baseOfActive(player_color, obj)
    -- unità mossa col pannello: la presa a mano non la sposta
    if u and MOVE_STATE.pannello and MOVE_STATE.pannello[u.key] then
        local p, r = obj.getPosition(), obj.getRotation()
        MOVE_PICK[obj.getGUID()] = { x = p.x, y = p.y, z = p.z, ry = r.y }
        return
    end
    if not u then return end
    move_recordStart(u)
    local limite, motivo = move_unitLimit(slot, u)
    if not limite then
        warningToColor((u.meta.nomeDisplay or u.key) .. " non puo' muovere: " .. tostring(motivo),
            Player[player_color], "Yellow", 4, false)
    end
    if not MOVE_DRAG[u.key] then
        MOVE_DRAG[u.key] = Wait.time(function() move_drawLines(slot) end, MOVE.tick, -1) or true
    end
end
-- ============================================================
-- FUNZIONE: move_onDrop(player_color, obj)
-- La base oltre il limite torna al limite, quella che non può
-- muovere alla partenza.
-- ============================================================
function move_onDrop(player_color, obj)
    if ENGINE and ENGINE.phase == PHASE.MANEUVER and move_manualOnDrop(player_color, obj) then return end
    local u, slot = move_baseOfActive(player_color, obj)
    if not u then return end
    if MOVE_DRAG[u.key] then
        if type(MOVE_DRAG[u.key]) == "number" then Wait.stop(MOVE_DRAG[u.key]) end
        MOVE_DRAG[u.key] = nil
    end

    -- unità in carica: resta a contatto (ANNULLA per rifare)
    local fine = MOVE_STATE.dopoCarica and MOVE_STATE.dopoCarica[u.key]
    if fine and fine[obj.getGUID()] then
        local s = fine[obj.getGUID()]
        obj.setPosition({ x = s.x, y = s.y, z = s.z })
        obj.setRotation({ x = 0, y = s.ry, z = 0 })
        warningToColor("Unita' in carica: resta a contatto (ANNULLA per rifare la carica)", Player[player_color], "Yellow", 4, false)
        main_setLines("movimento", {})
        return
    end
    -- unità mossa con il pannello: conta il budget, non lo
    -- spostamento netto; a mano non si sposta (si usa MUOVI)
    if MOVE_STATE.pannello and MOVE_STATE.pannello[u.key] then
        local s = MOVE_PICK[obj.getGUID()]
        MOVE_PICK[obj.getGUID()] = nil
        if s then
            obj.setPosition({ x = s.x, y = s.y, z = s.z })
            obj.setRotation({ x = 0, y = s.ry, z = 0 })
            warningToColor("Unita' mossa col pannello: usa MUOVI (o ANNULLA per muoverla a mano)",
                Player[player_color], "Yellow", 4, false)
        end
        if MOVE_PANEL and MOVE_PANEL.key == u.key then move_panelRedraw() end
        main_refreshBaseButtons()
        return
    end

    local s = MOVE_STATE.partenza[u.key] and MOVE_STATE.partenza[u.key][obj.getGUID()]
    if s then
        local limite = move_unitLimit(slot, u)
        local p = obj.getPosition()
        if not limite then
            obj.setPosition({ x = s.x, y = s.y, z = s.z })
            obj.setRotation({ x = 0, y = s.ry, z = 0 })
        else
            local d = move_baseDistanceD(u, obj)
            if d > limite then
                local f = limite / d
                obj.setPosition({ x = s.x + (p.x - s.x) * f, y = p.y, z = s.z + (p.z - s.z) * f })
                warningToColor(string.format("%s: massimo %s, riportata al limite",
                    u.meta.nomeDisplay or u.key, main_formatD(limite)), Player[player_color], "Yellow", 3, false)
            end
        end
    end
    move_drawLines(slot)
    -- i fili restano finché un'unità è in mano
    if next(MOVE_DRAG) == nil then
        move_dragText(slot, nil)
        Wait.time(function() if next(MOVE_DRAG) == nil then main_setLines("movimento", {}) end end, 1.5)
    end
    main_refreshBaseButtons()
end
-- ============================================================
-- FUNZIONE: move_drawLines(slot)
-- Fili dalla partenza delle basi delle unità in mano.
-- ============================================================
function move_drawLines(slot)
    local linee = {}
    -- cerchi del movimento dei Generali (IEF main_generalMoveLines)
    for key, _ in pairs(MOVE_CIRCLE) do
        local g = main_unitOrGeneral(slot, key)
        local s = g and MOVE_STATE.partenza[key] and MOVE_STATE.partenza[key][g.comando.getGUID()]
        if g and not s then
            local p = g.comando.getPosition()
            s = { x = p.x, y = p.y, z = p.z }
        end
        if s then
            local r = main_dToTts(move_unitLimit(slot, g) or 0)
            local punti = {}
            for i = 0, 48 do
                local a = (i / 48) * 2 * math.pi
                table.insert(punti, { s.x + math.cos(a) * r, s.y + 0.05, s.z + math.sin(a) * r })
            end
            table.insert(linee, { points = punti, color = MOVE.cerchio, thickness = 0.05 })
        end
    end
    for key, _ in pairs(MOVE_DRAG) do
        local u = main_unitOrGeneral(slot, key)
        local posa = MOVE_STATE.partenza[key]
        if u and posa then
            local limite = move_unitLimit(slot, u) or 0
            local massimo = 0
            for _, b in ipairs(u.basi) do massimo = math.max(massimo, move_baseDistanceD(u, b)) end
            move_dragText(slot, string.format("%s: %s / %s", u.meta.nomeDisplay or u.key, main_formatD(massimo),
                main_formatD(limite)), massimo > limite + MOVE.tolleranzaD)
            -- un solo elastico per unità: dal centro del fronte alla
            -- partenza al centro del fronte attuale; rosso se anche
            -- una sola base supera la velocità (il controllo resta
            -- per base, 9.1)
            local da, a = move_frontCentre(u, posa), move_frontCentre(u)
            if da and a then
                local ok = massimo <= limite + MOVE.tolleranzaD
                table.insert(linee, {
                    points = { { da.x, da.y + 0.05, da.z }, { a.x, da.y + 0.05, a.z } },
                    color = ok and MOVE.filoOk or MOVE.filoKo, thickness = MOVE.filoSpessore,
                })
            end
        end
    end
    main_setLines("movimento", linee)
end
-- ============================================================
-- FUNZIONE: move_checkLimits(slot)
-- Fine fase: testo dell'avviso se una base è oltre il limite.
-- ============================================================
function move_checkLimits(slot)
    -- 9.4: nessuna unità finisce sopra un'altra
    for key, _ in pairs(MOVE_STATE.partenza) do
        local u = main_unitsOfSide(slot)[key]
        if u and not MOVE_STATE.cariche[key] then
            local sopra = move_overlapKey(u, slot)
            if sopra then
                local x = main_unit(sopra)
                return string.format("%s e' sopra %s: sposta una delle due", u.meta.nomeDisplay or key,
                    x and (x.meta.nomeDisplay or sopra) or sopra)
            end
        end
    end
    for key, _ in pairs(MOVE_STATE.partenza) do
        local u = main_unitOrGeneral(slot, key)
        local esente = MOVE_STATE.cariche[key] or (MOVE_STATE.pannello and MOVE_STATE.pannello[key])
        if u and not esente then
            local limite = move_unitLimit(slot, u) or 0
            for _, b in ipairs(u.basi) do
                local d = move_baseDistanceD(u, b)
                if d > limite + MOVE.tolleranzaD then
                    return string.format("%s ha mosso %s: massimo %s", u.meta.nomeDisplay or key,
                        main_formatD(d), main_formatD(limite))
                end
            end
        end
    end
    return nil
end

-- ============================================================
--                           CARICA
-- ============================================================

-- ============================================================
-- FUNZIONE: move_inChargeArc(u, t)
-- Il bersaglio è nell'arco frontale di LDC_CARICA_ARCO gradi
-- per lato (centro di una sua base, dal centro dell'unità)?
-- ============================================================
function move_inChargeArc(u, t)
    local f = main_baseForward(u.comando)
    local c = main_unitCenter(u)
    local cosMin = math.cos(math.rad(LDC_CARICA_ARCO))
    for _, b in ipairs(t.basi) do
        local p = b.getPosition()
        local dx, dz = p.x - c.x, p.z - c.z
        local len = math.sqrt(dx * dx + dz * dz)
        if len > 0 and (dx * f.x + dz * f.z) / len >= cosMin then return true end
    end
    return false
end
-- ============================================================
-- FUNZIONE: move_chargeValuta(slot, u, t)
-- Esito e testo per il mirino della carica.
-- ============================================================
function move_chargeValuta(slot, u, t)
    local v = LDC_VELOCITA[u.meta.tipo or ""] or {}
    local d = main_unitDistanceD(u, t) or 99
    local base = main_formatD(d)
    if d > (v.carica or 0) then
        return "rosso", base .. " - Fuori portata (carica " .. main_formatD(v.carica or 0) .. ")"
    end
    if not move_inChargeArc(u, t) then
        return "arancio", base .. " - Fuori dall'arco frontale di " .. LDC_CARICA_ARCO .. " gradi"
    end
    -- 9.3: la pinnata carica solo chi la pinna (tranne la
    -- cavalleria pinnata da fanteria o artiglieria)
    local pin = move_pinInfo(slot, u)
    if pin and not pin.libera then
        local suo = false
        for _, k in ipairs(pin.chi) do if k == t.key then suo = true end end
        if not suo then
            return "arancio", base .. " - Pinnata: carica solo " .. move_pinNames(pin)
        end
    end
    -- 9.6: una sola unità per lato
    local _, _, latoFine = move_chargeSideStart(u, t)
    for k, b in pairs(MOVE_STATE.cariche) do
        if b == t.key and k ~= u.key and MOVE_STATE.latiFini and MOVE_STATE.latiFini[k] == latoFine then
            local x = main_unit(k)
            return "arancio", base .. " - Lato gia' caricato da " .. (x and (x.meta.nomeDisplay or k) or k)
        end
    end
    return "ok", base .. " - Bersaglio valido"
end

-- ============================================================
--                          BOTTONI
-- ============================================================

-- ============================================================
-- FUNZIONE: move_baseButtons(obj, u, slot)
-- ============================================================
function move_baseButtons(obj, u, slot)
    local B = BASE_BUTTONS
    if slot ~= TURN.activeSide then return {} end
    local lista = {}

    if MOVE_CHARGE_PREP and MOVE_CHARGE_PREP.key == u.key then
        return { { label = "ANNULLA", click = "move_clickAnnullaCarica", color = B.annullaColor, tooltip = "Annulla la carica" } }
    end
    if MOVE_STATE.cariche[u.key] then
        table.insert(lista, { label = "IN CARICA", click = "main_baseButtonNoop", color = MOVE.caricaColor, width = 520,
            tooltip = "A contatto: la mischia nella fase Mischie" })
    elseif main_mirinoActive(u.key) then
        table.insert(lista, { label = "ANNULLA", click = "move_clickAnnullaCarica", color = B.annullaColor,
            tooltip = "Annulla la carica" })
        return lista
    elseif not u.generale and move_canCharge(slot, u) and not main_mirinoActive() then
        table.insert(lista, { label = "CARICA", click = "move_clickCarica", color = MOVE.caricaColor,
            tooltip = "Carica (" .. main_formatD((LDC_VELOCITA[u.meta.tipo or ""] or {}).carica or 0) .. ")" })
    end

    if not MOVE_STATE.cariche[u.key] and not main_mirinoActive() and not MOVE_CHARGE_PREP then
        if MOVE_PANEL and MOVE_PANEL.key == u.key then
            table.insert(lista, { label = "IN MOVIMENTO", click = "main_baseButtonNoop", color = MOVE.muoviColor, width = 620 })
        elseif move_unitLimit(slot, u) and not u.generale then
            table.insert(lista, { label = "MUOVI", click = "move_clickMuovi", color = MOVE.muoviColor,
                tooltip = "Pannello di movimento (avanti, perno)" })
        end
    end
    if u.generale then
        table.insert(lista, { label = "MUOVI", click = "move_clickCerchio",
            color = MOVE.muoviColor, width = 480,
            tooltip = "Cerchio del movimento (" .. main_formatD(move_unitLimit(slot, u) or 0) .. "); alt-click: torna alla partenza" })
    end
    if move_hasMoved(u.key) or MOVE_STATE.cariche[u.key] then
        table.insert(lista, { label = "ANNULLA", click = "move_clickAnnulla", color = B.annullaColor,
            tooltip = "Rimette l'unita' dov'era" })
    end
    return lista
end
-- ============================================================
-- FUNZIONE: move_clickOk(player_color)
-- ============================================================
function move_clickOk(player_color)
    if not ENGINE or ENGINE.phase ~= PHASE.MANEUVER or ENGINE.transitionPending then return false end
    if not main_colorInSide(player_color, TURN.activeSide) then
        warningToColor("Non e' la tua Manovra", Player[player_color], "Yellow", 3, false)
        return false
    end
    return true
end
-- ============================================================
-- FUNZIONE: move_clickAnnulla(obj, player_color, alt_click)
-- ============================================================
function move_clickAnnulla(obj, player_color, alt_click)
    if not move_clickOk(player_color) then return end
    local u, slot, mio = main_baseOwnerClick(obj, player_color)
    if not u or not mio then return end
    if MOVE_PANEL and MOVE_PANEL.key == u.key then move_panelClose() end
    move_restore(u)
    move_chargeListRefresh()
    main_refreshBaseButtons()
end
-- ============================================================
-- FUNZIONE: move_clickMuovi(obj, player_color, alt_click)
-- MUOVI: pannello di movimento (come IEF Movimento).
-- ============================================================
function move_clickMuovi(obj, player_color, alt_click)
    if not move_clickOk(player_color) then return end
    local u, slot, mio = main_baseOwnerClick(obj, player_color)
    if not u or not mio or slot ~= TURN.activeSide then return end
    move_panelOpen(Player[player_color], slot, u)
end
-- ============================================================
-- FUNZIONE: move_clickCarica(obj, player_color, alt_click)
-- CARICA: mirino sul bersaglio.
-- ============================================================
function move_clickCarica(obj, player_color, alt_click)
    if not move_clickOk(player_color) then return end
    local u, slot, mio = main_baseOwnerClick(obj, player_color)
    if not u or not mio or slot ~= TURN.activeSide then return end
    local ok, motivo = move_canCharge(slot, u)
    if not ok then
        warningToColor("Non puo' caricare: " .. tostring(motivo), Player[player_color], "Yellow", 4, false)
        return
    end
    local player = Player[player_color]
    if MOVE_PANEL then move_panelClose() end
    main_mirinoStart(player, slot, u, {
        linee    = "carica",
        tinta    = MOVE.tintaMirino,
        valuta   = function(t) return move_chargeValuta(slot, u, t) end,
        onValido = function(t)
            move_chargePrepare(player, slot, u, t)
        end,
        onChiudi = function(p)
            main_mirinoStop()
            main_refreshBaseButtons()
        end,
    })
    main_refreshBaseButtons()
end
-- ============================================================
-- FUNZIONE: move_clickAnnullaCarica(obj, player_color, alt_click)
-- ============================================================
function move_clickAnnullaCarica(obj, player_color, alt_click)
    if not move_clickOk(player_color) then return end
    main_mirinoStop()
    if MOVE_CHARGE_PREP then move_chargeChiudi(Player[player_color]) end
    main_refreshBaseButtons()
end
-- ============================================================
-- FUNZIONE: move_charges()
-- Cariche della metà turno: { [attaccante] = bersaglio } (per
-- la Mischia).
-- ============================================================
function move_charges()
    return MOVE_STATE and MOVE_STATE.cariche or {}
end

-- ============================================================
-- FUNZIONE: move_frontCentre(u, posa)
-- Centro del fronte dell'unità: basi del primo rango (rispetto
-- al fronte della base di comando), bordo anteriore. Con posa
-- (MOVE_STATE.partenza) usa le pose di partenza. Per i Generali
-- è la base stessa.
-- ============================================================
function move_frontCentre(u, posa)
    local pose = {}
    for _, b in ipairs(u.basi) do
        local s = posa and posa[b.getGUID()]
        if posa and not s then return nil end
        if s then
            table.insert(pose, { x = s.x, y = s.y, z = s.z, ry = s.ry or 0, obj = b })
        else
            local p, r = b.getPosition(), b.getRotation()
            table.insert(pose, { x = p.x, y = p.y, z = p.z, ry = r.y, obj = b })
        end
    end
    if #pose == 0 then return nil end
    if u.generale then return pose[1] end
    local ref = pose[1]
    for _, q in ipairs(pose) do if q.obj == u.comando then ref = q end end
    local a = math.rad(ref.ry)
    local F = { x = math.sin(a), z = math.cos(a) }
    local hd = main_cmToTts(u.meta.profonditaCm or CALIBRAZIONE.baseProfonditaCm) / 2
    local fronte = -math.huge
    for _, q in ipairs(pose) do q.v = q.x * F.x + q.z * F.z; fronte = math.max(fronte, q.v) end
    local cx, cz, y, n = 0, 0, ref.y, 0
    for _, q in ipairs(pose) do
        if q.v >= fronte - hd then cx, cz, n = cx + q.x, cz + q.z, n + 1 end
    end
    return { x = cx / n + F.x * hd, y = y, z = cz / n + F.z * hd }
end
-- ============================================================
--            DISTANZA E CERCHIO (IEF 0_main/general)
-- ============================================================

MOVE_CIRCLE = MOVE_CIRCLE or {}   -- [key] = true: cerchio del movimento acceso

-- ============================================================
-- FUNZIONE: move_dragTextXml()
-- Pannellino della distanza durante il trascinamento (IEF
-- txtDistGen; qui a schermo, sopra il pannello di movimento).
-- ============================================================
function move_dragTextXml()
    local P = MOVEPANEL
    return string.format([[
        <Panel id="move_drag_panel" rectAlignment="LowerCenter" offsetXY="0 330" width="460" height="56" color="%s" active="false" visibility="">
            <Text id="move_drag_text" text="" font="%s" fontStyle="Bold" fontSize="26" color="White" alignment="MiddleCenter"/>
        </Panel>]], P.bg, P.font)
end
function move_dragText(slot, testo, oltre)
    if not testo then
        UI.setAttribute("move_drag_panel", "active", "false")
        return
    end
    UI.setAttribute("move_drag_panel", "visibility", main_sideVisibility(slot))
    UI.setAttribute("move_drag_text", "text", testo)
    UI.setAttribute("move_drag_text", "color", oltre and "#FF4040" or "White")
    UI.setAttribute("move_drag_panel", "active", "true")
end
-- ============================================================
-- FUNZIONE: move_clickCerchio(obj, player_color, alt_click)
-- IEF main_generalMoveButton: accende/spegne il cerchio del
-- movimento attorno alla partenza; alt-click riporta il
-- Generale alla partenza.
-- ============================================================
function move_clickCerchio(obj, player_color, alt_click)
    if not move_clickOk(player_color) then return end
    local u, slot, mio = main_baseOwnerClick(obj, player_color)
    if not u or not mio then return end
    if alt_click then
        move_restore(u)
    elseif MOVE_CIRCLE[u.key] then
        MOVE_CIRCLE[u.key] = nil
    else
        MOVE_CIRCLE[u.key] = true
    end
    move_drawLines(slot)
    main_refreshBaseButtons()
end
