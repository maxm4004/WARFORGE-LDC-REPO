-- ============================================================
-- WARFORGE LDC — 7_maneuver/hooks.ttslua
-- ============================================================

-- ============================================================
-- FUNZIONE: before_maneuver(phaseName, phase)
-- Nuova Manovra dello schieramento attivo: nessuno ha mosso.
-- ============================================================
function before_maneuver(phaseName, phase)
    MOVE_STATE = { side = TURN.activeSide, turno = ENGINE.turn, partenza = {}, cariche = {},
                   budget = {}, lati = {}, dopoCarica = {}, pannello = {},
                   pinnate = {}, perno = {}, formazione = {}, latiFini = {} }
    MOVE_PANEL, MOVE_MANUAL, MOVE_PIVOT, MOVE_CHARGE_PREP = nil, nil, nil, nil
    MOVE_CIRCLE = {}
    MOVE_DRAG = {}
    callHandler("updateCenterPanel")
end
-- ============================================================
-- FUNZIONE: after_maneuver(phaseName, phase)
-- Le cariche restano per la Mischia.
-- ============================================================
function after_maneuver(phaseName, phase)
    move_rimettiTutti()
    main_mirinoStop()
    if MOVE_PANEL then move_panelClose() end
    if MOVE_CHARGE_PREP then move_chargeChiudi(nil) end
    for _, id in pairs(MOVE_DRAG) do if type(id) == "number" then Wait.stop(id) end end
    MOVE_DRAG = {}
    MOVE_CIRCLE = {}
    move_dragText(nil, nil)
    engine_uiSet("charge_list_army1", "active", "false")
    engine_uiSet("charge_list_army2", "active", "false")
    main_setLines("movimento", {})
end
