-- ============================================================
-- FUNZIONE: melee_phase()
-- ============================================================
function melee_phase()
    return {
        [PHASE.MELEE] = {
            title  = "MISCHIE",
            desc   = "Risoluzione delle mischie",
            before = "before_melee",
            after  = "after_melee",
            onRoll = "melee_onRoll",
            baseButtons = "melee_baseButtons",
            subphases = { "MELEE_RESOLVE" },
            allowedActions = { ACTION.CONFIRM },
            render = "1BtnClick",
            enforceOwnership = true,
            inputMode = INPUT_MODE.ACTIVE,
            buttons = {
                BTN_SINGLE = { action = ACTION.CONFIRM, label = "Mischie completate", callback = "melee_btn" },
            },
            transitions = {
                { to = PHASE.TURN_CHANGE, conditions = { COND.CONFIRM_IMMEDIATE } },
            },
        },
    }
end
