-- ============================================================
-- WARFORGE LDC — 8_melee/lib.ttslua
-- Mischie, primo giro (regolamento 10).
--
-- Flusso come IEF 8_melee: lista MISCHIE per esercito; la riga
-- (o MISCHIA sulla base) inquadra la mischia e chi attacca apre
-- la sottofase condivisa MELEE_RESOLVE; l'avversario ci entra
-- dalla sua riga. Ognuno clicca "Combatti in Mischia" (camera
-- sui dadi, sua colonna del pannello dadi) e tira, con i ritiri
-- per il morale più alto. Gli hit si applicano insieme come disordini; quelli che
-- manderebbero in rotta si ritirano dall'avversario (basta un
-- risultato superiore al morale). Perde chi ha inflitto meno
-- hit: artiglieria distrutta, fanteria non in quadrato battuta
-- dalla cavalleria distrutta, le altre fanno il test di morale
-- (fallito = un altro hit) e si ritirano da sole di 1D/2D
-- restando fronte al nemico (bloccate: un altro hit). Pareggio:
-- il difensore resta, l'attaccante si ritira. Inseguimenti e
-- sfondamenti si fanno a mano.
-- ============================================================

-- ============================================================
--                         CALCOLO
-- ============================================================

-- ============================================================
-- FUNZIONE: melee_ranks(u)
-- Basi che combattono: primo e secondo rango (quadrato: tutte).
-- ============================================================
function melee_ranks(u)
    if u.meta.formazione == "quadrato" then return #u.basi end
    local f = main_baseForward(u.comando)
    local prof = main_cmToTts(u.meta.profonditaCm or CALIBRAZIONE.baseProfonditaCm)
    local max = -math.huge
    local avanti = {}
    for i, b in ipairs(u.basi) do
        local p = b.getPosition()
        avanti[i] = p.x * f.x + p.z * f.z
        max = math.max(max, avanti[i])
    end
    local n = 0
    for i = 1, #u.basi do
        if avanti[i] >= max - prof * (LDC_MISCHIA.ranghi - 0.5) then n = n + 1 end
    end
    return n
end
-- ============================================================
-- FUNZIONE: melee_compute(u, t)
-- Dadi, soglia e ritiri di u contro t, con le righe della
-- scheda. Ritorna { dadi, soglia, ritira, righe }.
-- ============================================================
function melee_compute(u, t, colpito)
    local M = LDC_MISCHIA
    local catU, catT = main_unitCategory(u.meta), main_unitCategory(t.meta)
    local tipoU, tipoT = u.meta.tipo or "", t.meta.tipo or ""
    local righe = {}

    local dadi
    if catU == CATEGORIA.ARTIGLIERIA then
        dadi = M.dadiArtiglieria
        table.insert(righe, { "Artiglieria (mitraglia)", dadi .. "D6" })
    else
        local basi = melee_ranks(u)
        dadi = basi
        table.insert(righe, { "Basi in primo e secondo rango", tostring(basi) })
        if main_unitDisorders(u.key) > 0 then
            dadi = dadi - 1
            table.insert(righe, { "Disordinata", "-1D6" })
        end
    end
    -- colpito sul fianco/retro (10): dadi dimezzati (per difetto)
    if colpito == "FIANCO" or colpito == "RETRO" then
        dadi = math.floor(dadi / 2)
        table.insert(righe, { "Colpito sul " .. colpito:lower(), "dadi / 2" })
    end
    dadi = math.max(dadi, 0)

    local mods = {}
    local function mod(cond, testo) if cond then table.insert(mods, testo) end end
    mod(tipoU == "CAV_CORAZZIERI", "Corazzieri")
    mod(tipoU == "CAV_LANCIERI" and catT == CATEGORIA.CAVALLERIA, "Lancieri contro cavalleria")
    mod((tipoU == "CAV_CORAZZIERI" or tipoU == "CAV_DRAGONI") and tipoT == "CAV_LEGGERA", "Contro cavalleria leggera")
    mod(catU == CATEGORIA.CAVALLERIA and catT == CATEGORIA.FANTERIA and t.meta.formazione ~= "quadrato", "Cavalleria contro fanteria")
    mod(catT == CATEGORIA.ARTIGLIERIA, "Contro artiglieria sganciata")
    mod(u.meta.formazione == "colonna_attacco" and t.meta.formazione == "linea", "Colonna d'assalto contro linea")
    mod(u.meta.formazione == "quadrato" and catT == CATEGORIA.CAVALLERIA, "Quadrato contro cavalleria")
    for _, testo in ipairs(mods) do table.insert(righe, { testo, "+1" }) end
    local soglia = math.max(M.soglia - #mods, M.sogliaMin)

    local diff = (u.meta.morale or 3) - (t.meta.morale or 3)
    local ritira = nil
    if diff >= 2 then ritira = 2 elseif diff == 1 then ritira = 1 end
    if ritira then
        table.insert(righe, { "Morale piu' alto di " .. diff, "ritira " .. (ritira == 1 and "gli 1" or "1 e 2") })
    end
    -- colpito sul fianco (10): ritira i 6, anche verso il fronte
    local ritira6 = colpito == "FIANCO" or colpito == "RETRO"
    if ritira6 then table.insert(righe, { "Colpito sul " .. colpito:lower(), "ritira i 6" }) end
    table.insert(righe, { "Disordini", main_unitDisorders(u.key) .. "/" .. main_unitDisorderLimit(u.meta) })
    return { dadi = dadi, soglia = soglia, ritira = ritira, ritira6 = ritira6, righe = righe }
end

-- ============================================================
--                  SCHEDA DEL PANNELLO DADI (IEF)
-- ============================================================

-- ============================================================
-- FUNZIONE: melee_diceScheda(slot, u, t, c, attacca)
-- Scheda di un esercito nel pannello dadi, come IEF
-- melee_diceScheda: sezioni DADI e PER COLPIRE.
-- ============================================================
function melee_diceScheda(slot, u, t, c, attacca)
    local righe = { { "DADI", "", "sezione" } }
    for _, r in ipairs(c.righe) do
        if r[1] ~= "Disordini" and not tostring(r[2]):find("^%+") and not tostring(r[1]):find("^Morale") and r[2] ~= "ritira i 6" then
            table.insert(righe, { r[1], r[2] })
        end
    end
    table.insert(righe, { "Totale dadi", c.dadi .. "D6" })
    table.insert(righe, { "PER COLPIRE", "", "sezione" })
    table.insert(righe, { "Mischia: serve", LDC_MISCHIA.soglia .. "+" })
    local mods = 0
    for _, r in ipairs(c.righe) do
        if tostring(r[2]):find("^%+") then
            table.insert(righe, { r[1], r[2] .. " al dado" })
            mods = mods + 1
        end
    end
    if mods == 0 then table.insert(righe, { "Nessun modificatore", "", DICEPANEL.subColor }) end
    if c.ritira then
        table.insert(righe, { "Morale piu' alto: ritira", (c.ritira == 1) and "gli 1" or "1 e 2" })
    end
    if c.ritira6 then table.insert(righe, { "Colpito sul fianco: ritira", "i 6" }) end
    return {
        titolo      = "MISCHIA",
        sottotitolo = string.format("%s: %s %s %s", main_sideName(slot), u.meta.nomeDisplay or u.key,
            attacca and "attacca" or "difende contro", t.meta.nomeDisplay or t.key),
        righe       = righe,
        serve       = string.format("Serve %d+ su %dD6", c.soglia, c.dadi),
        soglia      = c.soglia,
    }
end

-- ============================================================
--                         MISCHIE
-- ============================================================

-- ============================================================
-- FUNZIONE: melee_start(slot)
-- Mischie della metà turno: cariche arrivate a contatto.
-- ============================================================
function melee_start(slot)
    MELEE_STATE = { side = slot, turno = ENGINE.turn, mischie = {} }
    if not slot then return end
    local mie, loro = main_unitsOfSide(slot), main_unitsOfSide(main_otherSide(slot))
    for att, dif in pairs(move_charges()) do
        local u, t = mie[att], loro[dif]
        if u and t and (main_unitDistanceD(u, t) or 99) <= MELEE.contattoD then
            local lato = MOVE_STATE.lati and MOVE_STATE.lati[att] or "FRONTE"
            table.insert(MELEE_STATE.mischie, { att = att, dif = dif, fatta = false, lato = lato })
        end
    end
    table.sort(MELEE_STATE.mischie, function(a, b) return a.att < b.att end)
    if #MELEE_STATE.mischie == 0 then
        main_warningToSide(slot, "Nessuna mischia: chiudi la fase", "Yellow", 4)
    end
end
-- ============================================================
-- FUNZIONE: melee_colpito(m, key)
-- Lato da cui è colpita l'unità key nella mischia m: "FIANCO" o
-- "RETRO" per il difensore caricato di lato, altrimenti nil.
-- ============================================================
function melee_colpito(m, key)
    if m and key == m.dif and (m.lato == "FIANCO" or m.lato == "RETRO") then return m.lato end
    return nil
end
-- ============================================================
-- FUNZIONE: melee_ofAttacker(unitKey)
-- ============================================================
function melee_ofAttacker(unitKey)
    for i, m in ipairs(MELEE_STATE.mischie) do
        if m.att == unitKey then return m, i end
    end
    return nil
end
-- ============================================================
-- FUNZIONE: melee_resolveCtx()
-- ctx di MELEE_RESOLVE se è aperta (come IEF).
-- ============================================================
function melee_resolveCtx()
    local sh = engine_subShared()
    if sh and sh.name == "MELEE_RESOLVE" then return sh.ctx, sh end
    return nil
end
-- ============================================================
-- FUNZIONE: melee_label(m)
-- "45e Ligne contro IR 4"
-- ============================================================
function melee_label(m)
    local u, t = main_unit(m.att), main_unit(m.dif)
    local nu = u and (u.meta.nomeDisplay or u.key) or m.att
    local nt = t and (t.meta.nomeDisplay or t.key) or m.dif
    return nu .. " contro " .. nt
end
-- ============================================================
-- FUNZIONE: melee_center(m)
-- Centro delle due unità (per la camera).
-- ============================================================
function melee_center(m)
    local u, t = main_unit(m.att), main_unit(m.dif)
    local pts = {}
    for _, x in ipairs({ u, t }) do
        if x then for _, b in ipairs(x.basi) do table.insert(pts, b.getPosition()) end end
    end
    if #pts == 0 then return nil end
    local cx, cy, cz = 0, 0, 0
    for _, p in ipairs(pts) do cx, cy, cz = cx + p.x, cy + p.y, cz + p.z end
    return { x = cx / #pts, y = cy / #pts + 2, z = cz / #pts }
end
-- ============================================================
-- FUNZIONE: melee_cameraToMelee(player, slot, m)
-- Come IEF melee_cameraToGroup.
-- ============================================================
function melee_cameraToMelee(player, slot, m)
    local c = melee_center(m)
    if not c or not player then return end
    player.lookAt({ position = c, pitch = 40, yaw = (slot == 1) and 0 or 180, distance = 15 })
end

-- ============================================================
--              LISTA DELLE MISCHIE (come IEF)
-- ============================================================

-- ============================================================
-- FUNZIONE: melee_listPanelXml(slot)
-- Lista delle mischie dal punto di vista di slot (righe fisse,
-- accese da melee_listRefresh). Stile ui_listPanelXml di IEF.
-- ============================================================
function melee_listPanelXml(slot)
    local righe = {}
    for i = 1, MELEE.listaMax do
        table.insert(righe, { id = string.format("melee_row_%d_%d", slot, i), testo = "", onClick = "melee_rowClick" })
    end
    local xml = ui_listPanelXml({
        id         = "melee_list_army" .. slot,
        titleId    = "melee_list_title_army" .. slot,
        titolo     = "MISCHIE",
        nota       = "Clicca una riga: inquadra la mischia; chi attacca la apre",
        visibility = main_sideVisibility(slot),
        attivo     = "false",
        righe      = righe,
        offsetXY   = LISTPANEL.offsetXY,
    })
    return xml
end
-- ============================================================
-- FUNZIONE: melee_listRefresh()
-- Testo e colore delle righe; lista accesa solo nelle Mischie.
-- ============================================================
function melee_listRefresh()
    local S = LISTPANEL
    local attivo = ENGINE and ENGINE.phase == PHASE.MELEE and #MELEE_STATE.mischie > 0
    local ctx = melee_resolveCtx()
    for slot = 1, 2 do
        UI.setAttribute("melee_list_army" .. slot, "active", attivo and "true" or "false")
        UI.setAttribute("melee_list_army" .. slot, "visibility", main_sideVisibility(slot))
        UI.setAttribute("melee_list_title_army" .. slot, "text", "MISCHIE - " .. main_sideName(slot))
        local n = math.min(#MELEE_STATE.mischie, MELEE.listaMax)
        UI.setAttribute("melee_list_army" .. slot, "height",
            tostring(2 * S.padding + S.titleH + S.noteH + S.spacing + math.max(n, 1) * (S.rowH + S.spacing)))
        for i = 1, MELEE.listaMax do
            local m = MELEE_STATE.mischie[i]
            local id = string.format("melee_row_%d_%d", slot, i)
            if m and i <= n then
                local testo, colore = melee_label(m), S.todo
                if ctx and ctx.i == i then
                    testo, colore = testo .. " - in corso", S.gold
                elseif m.fatta then
                    testo, colore = testo .. " - risolta", S.done
                end
                UI.setAttribute(id, "active", "true")
                UI.setAttribute(id, "text", testo)
                UI.setAttribute(id, "textColor", colore)
            else
                UI.setAttribute(id, "active", "false")
            end
        end
    end
end
-- ============================================================
-- FUNZIONE: melee_rowClick(player, value, id)
-- Come IEF: inquadra la mischia; chi attacca (schieramento
-- attivo) apre MELEE_RESOLVE; l'avversario, a mischia aperta,
-- ci entra.
-- ============================================================
function melee_rowClick(player, value, id)
    local slotStr, iStr = id:match("^melee_row_(%d)_(%d+)$")
    if not slotStr then return end
    local slot, i = tonumber(slotStr), tonumber(iStr)
    if not main_colorInSide(player.color, slot) then return end
    local m = MELEE_STATE.mischie[i]
    if not m then return end

    melee_cameraToMelee(player, slot, m)

    local aperta = engine_subShared()
    if aperta then
        if aperta.name == "MELEE_RESOLVE" and aperta.ctx.i == i then
            aperta.ctx["entrato" .. slot] = true
            engine_subRedraw()
            return
        end
        warningToColor("Completa prima la mischia in corso", player, "Yellow", 5, true)
        return
    end
    if ENGINE.phase ~= PHASE.MELEE or ENGINE.transitionPending then return end
    if m.fatta then
        warningToColor("Questa mischia e' gia' stata risolta", player, "Yellow", 5, true)
        return
    end
    if slot ~= TURN.activeSide then
        warningToColor("La mischia la apre chi attacca", player, "Yellow", 4, true)
        return
    end
    melee_open(player, slot, i)
end
-- ============================================================
-- FUNZIONE: melee_open(player, slot, i)
-- Apre MELEE_RESOLVE sulla mischia i.
-- ============================================================
function melee_open(player, slot, i)
    local m = MELEE_STATE.mischie[i]
    local u, t = main_unit(m.att), main_unit(m.dif)
    if not u or not t then
        m.fatta = true
        melee_listRefresh()
        main_refreshBaseButtons()
        return
    end
    local ctx = { i = i, att = slot, dif = main_otherSide(slot), unita = { [slot] = m.att, [main_otherSide(slot)] = m.dif } }
    ctx["entrato" .. slot] = true
    if engine_subOpen("MELEE_RESOLVE", nil, ctx, "melee_resolveDone") then
        printToAll("[Mischia] " .. melee_label(m), main_sideMainColor(slot))
        main_warningToSide(ctx.dif, "Mischia aperta: clicca la riga nella lista MISCHIE e combatti", "Yellow", 6)
        melee_listRefresh()
        main_refreshBaseButtons()
    end
end
-- ============================================================
-- FUNZIONE: melee_baseButtons(obj, u, slot)
-- MISCHIA sulla base dell'attaccante: scorciatoia della riga.
-- ============================================================
function melee_baseButtons(obj, u, slot)
    if slot ~= TURN.activeSide or u.generale then return {} end
    local m, i = melee_ofAttacker(u.key)
    if not m or m.fatta then return {} end
    local ctx = melee_resolveCtx()
    if ctx then
        if ctx.i == i then
            return { { label = "IN MISCHIA", click = "main_baseButtonNoop", color = MELEE.mischiaColor, width = 560 } }
        end
        return {}
    end
    return { { label = "MISCHIA", click = "melee_clickMischia", color = MELEE.mischiaColor, width = 520,
               tooltip = "Risolvi la mischia" } }
end
-- ============================================================
-- FUNZIONE: melee_clickMischia(obj, player_color, alt_click)
-- ============================================================
function melee_clickMischia(obj, player_color, alt_click)
    if not ENGINE or ENGINE.phase ~= PHASE.MELEE or ENGINE.transitionPending then return end
    if engine_subShared() then return end
    local u, slot, mio = main_baseOwnerClick(obj, player_color)
    if not u or not mio or slot ~= TURN.activeSide then return end
    local m, i = melee_ofAttacker(u.key)
    if not m or m.fatta then return end
    local player = Player[player_color]
    melee_cameraToMelee(player, slot, m)
    melee_open(player, slot, i)
end

-- ============================================================
--           SOTTOFASE MELEE_RESOLVE (come IEF)
-- ============================================================

-- ============================================================
-- FUNZIONE: melee_resolveEnter(ctx, slot, rec)
-- Apertura: dadi, soglie e ritiri dei due eserciti; le due
-- colonne del pannello dadi visibili da subito (come IEF).
-- ============================================================
function melee_resolveEnter(ctx, slot, rec)
    engine_diceClearLastRoll(1)
    engine_diceClearLastRoll(2)
    local uA, uD = main_unit(ctx.unita[ctx.att]), main_unit(ctx.unita[ctx.dif])
    ctx.calc = {}
    for _, s in ipairs({ ctx.att, ctx.dif }) do
        local mio, altro = (s == ctx.att) and uA or uD, (s == ctx.att) and uD or uA
        local c = melee_compute(mio, altro, melee_colpito(MELEE_STATE.mischie[ctx.i], mio.key))
        ctx.calc[s] = { dadi = c.dadi, soglia = c.soglia, ritira = c.ritira, ritira6 = c.ritira6 }
        ctx["scheda" .. s] = melee_diceScheda(s, mio, altro, c, s == ctx.att)
        ctx["colpi" .. s] = 0
        ctx["rolled" .. s] = c.dadi <= 0
        engine_dicePanelOpen(s, ctx["scheda" .. s])
        printToAll(string.format("[Mischia] %s: %s, %dD6, serve %d+", main_sideName(s),
            mio.meta.nomeDisplay or mio.key, c.dadi, c.soglia), main_sideMainColor(s))
    end
    if ctx["rolled" .. ctx.att] and ctx["rolled" .. ctx.dif] then
        Wait.frames(function()
            local c = melee_resolveCtx()
            if c == ctx then melee_applyHits(ctx) end
        end, 1)
    end
end
-- ============================================================
-- FUNZIONE: melee_resolveFocus(ctx, slot, player, rec)
-- Bottone della sottofase: camera sui dadi e pannello dadi.
-- ============================================================
function melee_resolveFocus(ctx, slot, player, rec)
    ctx["aiDadi" .. slot] = true
    if player then engine_diceCameraZoom(player) end
    if ctx["scheda" .. slot] and not engine_dicePanelIsOpen(slot) then
        engine_dicePanelOpen(slot, ctx["scheda" .. slot])
    end
    engine_subRedraw()
end
-- ============================================================
-- FUNZIONE: melee_resolveRoll(ctx, slot, player, rec)
-- Roll nello step TIRO: tiro dello slot, poi (morale più alto)
-- il ritiro dei falliti 1 o 1-2 con un nuovo Roll.
-- ============================================================
function melee_resolveRoll(ctx, slot, player, rec)
    if ctx["rolled" .. slot] or ctx["tirando" .. slot] then return end
    local c = ctx.calc[slot]
    local n = ctx["ritiro" .. slot] or c.dadi
    local ritiro = ctx["ritiro" .. slot] ~= nil
    ctx["tirando" .. slot] = true
    engine_diceClearLastRoll(slot)
    engine_diceSetNext(slot, n, c.soglia)
    if not engine_dicePanelIsOpen(slot) then engine_dicePanelOpen(slot, ctx["scheda" .. slot]) end

    engine_diceThrowFromBag(slot, nil, function(risultati, successi)
        local live = melee_resolveCtx()
        if live ~= ctx or ctx["rolled" .. slot] then return end
        ctx["tirando" .. slot] = nil
        ctx["colpi" .. slot] = ctx["colpi" .. slot] + (successi or 0)

        local daRitirare, sei = 0, 0
        if not ritiro then
            for _, v in ipairs(risultati or {}) do
                if c.ritira and v < c.soglia and v <= c.ritira then daRitirare = daRitirare + 1 end
                if c.ritira6 and v == 6 then sei = sei + 1 end
            end
            -- i 6 da ritirare non contano: si ritirano
            ctx["colpi" .. slot] = ctx["colpi" .. slot] - sei
            daRitirare = daRitirare + sei
        end
        engine_dicePanelOutcome(slot, string.format("%d hit", ctx["colpi" .. slot]),
            (ctx["colpi" .. slot] > 0) and DICEPANEL.okColor or DICEPANEL.koColor,
            (daRitirare > 0) and string.format("Ritira %d dadi: premi Roll", daRitirare) or nil)

        if daRitirare > 0 then
            ctx["ritiro" .. slot] = daRitirare
            warningToColor(string.format("Morale piu' alto: ritira %d dadi, premi Roll", daRitirare), player, "Yellow", 5, true)
            engine_subRedraw()
            return
        end
        ctx["rolled" .. slot] = true
        printToAll(string.format("[Mischia] %s: %d hit", main_sideName(slot), ctx["colpi" .. slot]), main_sideMainColor(slot))
        Wait.time(function() engine_diceCameraReturn(player, 0) end, 2)
        if ctx["rolled" .. ctx.att] and ctx["rolled" .. ctx.dif] then
            melee_applyHits(ctx)
        else
            engine_subRedraw()
        end
    end, player.color)
end
-- ============================================================
-- FUNZIONE: melee_applyHits(ctx)
-- Hit simultanei in disordini; quelli oltre il limite vanno in
-- coda per il tiro di rottura dell'avversario (regolamento 10.1).
-- ============================================================
function melee_applyHits(ctx)
    ctx.rotture = {}
    for _, s in ipairs({ ctx.att, ctx.dif }) do
        local altro = main_otherSide(s)
        local t = main_unit(ctx.unita[altro])
        if t then
            local limite = main_unitDisorderLimit(t.meta)
            local aggiunti = main_unitAddDisorders(t.key, ctx["colpi" .. s], limite)
            local eccesso = ctx["colpi" .. s] - aggiunti
            if eccesso > 0 then table.insert(ctx.rotture, { roller = s, dadi = eccesso }) end
        end
    end
    main_refreshBaseButtons()
    melee_nextBreak(ctx)
end
-- ============================================================
-- FUNZIONE: melee_nextBreak(ctx)
-- Prossimo tiro di rottura (step ROTTURA) o il risultato.
-- ============================================================
function melee_nextBreak(ctx)
    while #ctx.rotture > 0 do
        local r = table.remove(ctx.rotture, 1)
        local bersaglio = main_unit(ctx.unita[main_otherSide(r.roller)])
        if bersaglio then
            ctx.roller, ctx.rotturaDadi = r.roller, r.dadi
            ctx.rotturaMorale = bersaglio.meta.morale or 3
            engine_diceClearLastRoll(r.roller)
            engine_dicePanelOpen(r.roller, {
                titolo = "ROTTURA", sottotitolo = bersaglio.meta.nomeDisplay or bersaglio.key,
                righe = { { "Hit che mandano in rotta", tostring(r.dadi) }, { "Morale del bersaglio", tostring(ctx.rotturaMorale) } },
                serve = string.format("Serve piu' di %d su %dD6", ctx.rotturaMorale, r.dadi),
                soglia = ctx.rotturaMorale + 1,
            })
            printToAll(string.format("[Mischia] %d hit possono mandare in rotta %s: tira %s (serve piu' di %d)",
                r.dadi, bersaglio.meta.nomeDisplay or bersaglio.key, main_sideName(r.roller), ctx.rotturaMorale),
                main_sideMainColor(r.roller))
            engine_subStep("MELEE_RESOLVE", nil, "ROTTURA")
            return
        end
    end
    melee_result(ctx)
end
-- ============================================================
-- FUNZIONE: melee_rotturaRoll(ctx, slot, player, rec)
-- ============================================================
function melee_rotturaRoll(ctx, slot, player, rec)
    if slot ~= ctx.roller then
        warningToColor("Ora tira " .. main_sideName(ctx.roller), player, "Yellow", 3, false)
        return
    end
    if ctx.tirandoRottura then return end
    ctx.tirandoRottura = true
    engine_diceClearLastRoll(slot)
    engine_diceSetNext(slot, ctx.rotturaDadi, ctx.rotturaMorale + 1)
    engine_diceThrowFromBag(slot, nil, function(risultati, successi)
        if melee_resolveCtx() ~= ctx then return end
        ctx.tirandoRottura = nil
        Wait.time(function() engine_diceCameraReturn(player, 0) end, 2)
        local bersaglio = ctx.unita[main_otherSide(slot)]
        local rompe = (successi or 0) > 0
        engine_dicePanelOutcome(slot, rompe and "ROTTA!" or "Tiene", rompe and DICEPANEL.okColor or DICEPANEL.koColor)
        if rompe then main_unitBreak(bersaglio, "mischia") end
        main_refreshBaseButtons()
        melee_nextBreak(ctx)
    end, player.color)
end
-- ============================================================
-- FUNZIONE: melee_result(ctx)
-- Chi ha inflitto meno hit perde (10.1).
-- ============================================================
function melee_result(ctx)
    local att, dif = ctx.att, ctx.dif
    local uA, uD = main_unit(ctx.unita[att]), main_unit(ctx.unita[dif])
    if not uA or not uD then
        ctx.esito = "Mischia finita: un'unita' e' in rotta"
        engine_subStep("MELEE_RESOLVE", nil, "ESCI")
        return
    end
    if ctx["colpi" .. att] == ctx["colpi" .. dif] then
        ctx.esito = "Pareggio: " .. (uA.meta.nomeDisplay or uA.key) .. " si ritira"
        melee_message("Pareggio: " .. (uD.meta.nomeDisplay or uD.key) .. " resta, "
            .. (uA.meta.nomeDisplay or uA.key) .. " si ritira di " .. melee_retreatD(uA) .. "D")
        melee_retreat(uA, uD)
        engine_subStep("MELEE_RESOLVE", nil, "ESCI")
        return
    end
    local perde = (ctx["colpi" .. att] < ctx["colpi" .. dif]) and att or dif
    local vince = main_otherSide(perde)
    local uP, uV = main_unit(ctx.unita[perde]), main_unit(ctx.unita[vince])
    local catP, catV = main_unitCategory(uP.meta), main_unitCategory(uV.meta)
    ctx.perde = perde
    if catP == CATEGORIA.ARTIGLIERIA then
        ctx.esito = (uP.meta.nomeDisplay or uP.key) .. " distrutta"
        main_unitBreak(uP.key, "artiglieria che perde la mischia")
        engine_subStep("MELEE_RESOLVE", nil, "ESCI")
        return
    end
    if catP == CATEGORIA.FANTERIA and catV == CATEGORIA.CAVALLERIA and uP.meta.formazione ~= "quadrato" then
        ctx.esito = (uP.meta.nomeDisplay or uP.key) .. " distrutta dalla cavalleria"
        main_unitBreak(uP.key, "fanteria battuta dalla cavalleria")
        engine_subStep("MELEE_RESOLVE", nil, "ESCI")
        return
    end
    ctx.roller = perde
    engine_diceClearLastRoll(perde)
    engine_dicePanelOpen(perde, {
        titolo = "MISCHIA PERSA", sottotitolo = uP.meta.nomeDisplay or uP.key,
        righe = { { "Hit inflitti", string.format("%d contro %d", ctx["colpi" .. perde], ctx["colpi" .. vince]) },
                  { "Morale", tostring(uP.meta.morale or 3) },
                  { "Fallito: un altro hit", "" },
                  { "Poi ritirata di", melee_retreatD(uP) .. "D" } },
        serve = string.format("Test di morale: serve %d o meno su 1D6", uP.meta.morale or 3),
    })
    melee_message((uP.meta.nomeDisplay or uP.key) .. " perde la mischia: test di morale, tira " .. main_sideName(perde))
    engine_subStep("MELEE_RESOLVE", nil, "MORALE")
end
-- ============================================================
-- FUNZIONE: melee_moraleRoll(ctx, slot, player, rec)
-- Test di morale di chi perde, poi la ritirata.
-- ============================================================
function melee_moraleRoll(ctx, slot, player, rec)
    if slot ~= ctx.roller then
        warningToColor("Ora tira " .. main_sideName(ctx.roller), player, "Yellow", 3, false)
        return
    end
    if ctx.tirandoMorale then return end
    ctx.tirandoMorale = true
    engine_diceClearLastRoll(slot)
    engine_diceSetNext(slot, 1, nil)
    engine_diceThrowFromBag(slot, nil, function(risultati)
        if melee_resolveCtx() ~= ctx then return end
        ctx.tirandoMorale = nil
        Wait.time(function() engine_diceCameraReturn(player, 0) end, 2)
        local u = main_unit(ctx.unita[slot])
        local v = main_unit(ctx.unita[main_otherSide(slot)])
        local dado = risultati and risultati[1]
        local ok = u and dado and dado <= (u.meta.morale or 3)
        engine_dicePanelOutcome(slot, ok and "Test superato" or "Test fallito", ok and DICEPANEL.okColor or DICEPANEL.koColor)
        if u and not ok then
            local limite = main_unitDisorderLimit(u.meta)
            if main_unitDisorders(u.key) >= limite then
                main_unitBreak(u.key, "test di morale fallito")
                u = nil
            else
                main_unitAddDisorders(u.key, 1, limite)
            end
        end
        if u then
            ctx.esito = (u.meta.nomeDisplay or u.key) .. " si ritira di " .. melee_retreatD(u) .. "D"
            melee_message(ctx.esito .. " restando fronte al nemico")
            melee_retreat(u, v)
        else
            ctx.esito = "L'unita' sconfitta rompe"
        end
        main_refreshBaseButtons()
        engine_subStep("MELEE_RESOLVE", nil, "ESCI")
    end, player.color)
end
-- ============================================================
-- FUNZIONE: melee_resolveEsciEnter(ctx, slot, rec)
-- Step ESCI: esito per MORALE_ESITO_SECONDS, poi chiusura.
-- ============================================================
function melee_resolveEsciEnter(ctx, slot, rec)
    Wait.time(function()
        if melee_resolveCtx() == ctx then
            engine_subClose("MELEE_RESOLVE", nil, { i = ctx.i })
        end
    end, MORALE_ESITO_SECONDS)
end
-- ============================================================
-- FUNZIONE: melee_resolveDone(ctx, result, slot)
-- onDone di MELEE_RESOLVE: mischia risolta, lista ridisegnata.
-- ============================================================
function melee_resolveDone(ctx, result, slot)
    engine_dicePanelClose(1)
    engine_dicePanelClose(2)
    local m = MELEE_STATE.mischie[ctx.i]
    if m then m.fatta = true end
    melee_listRefresh()
    main_refreshBaseButtons()
    callHandler("updateCenterPanel")
end
-- ============================================================
-- FUNZIONE: melee_onRoll(player, slot)
-- Roll fuori dalla sottofase: test di Divisione in coda,
-- altrimenti avviso.
-- ============================================================
function melee_onRoll(player, slot)
    if main_divOnRoll(player, slot) then return end
    warningToColor("Nessuna mischia aperta: clicca una riga della lista MISCHIE", player, "Yellow", 4, false)
end
-- ============================================================
-- FUNZIONE: melee_retreat(u, nemico)
-- Ritirata di 1D (fanteria) o 2D (cavalleria) restando fronte
-- al nemico (10.1.1): tutte le basi indietro, lungo il proprio
-- fronte, senza girarsi. Se lungo il percorso una base passa
-- su un'altra unità (in ritirata non si interpenetra; terreno:
-- nel raffinamento), l'unità resta dov'è e prende un altro hit
-- (se è già al limite rompe).
-- Ritorna true se si è ritirata.
-- ============================================================
function melee_retreat(u, nemico)
    if not u then return false end
    local f = main_baseForward(u.comando)
    local d = main_dToTts(melee_retreatD(u))
    local dx, dz = -f.x * d, -f.z * d

    -- basi di tutte le altre unità e Generali sul tavolo
    local altre = {}
    for slot = 1, 2 do
        for _, x in pairs(main_unitsOfSide(slot)) do
            if x.key ~= u.key then for _, b in ipairs(x.basi) do table.insert(altre, b) end end
        end
    end
    -- lungo tutto il percorso (in ritirata non si interpenetra,
    -- 9.4): campioni ogni mezza profondità di base
    local passo = main_cmToTts(u.meta.profonditaCm or CALIBRAZIONE.baseProfonditaCm) / 2
    local n = math.max(1, math.ceil(d / passo))
    local rettAltre = {}
    for i, o in ipairs(altre) do rettAltre[i] = main_baseRect(o) end
    local bloccata = false
    for _, b in ipairs(u.basi) do
        local base = main_baseRect(b)
        for k = 1, n do
            local t = k / n
            local r = {}
            for i, c in ipairs(base) do r[i] = { x = c.x + dx * t, z = c.z + dz * t } end
            for _, ro in ipairs(rettAltre) do
                if main_rectsDistance(r, ro) <= 0 then bloccata = true; break end
            end
            if bloccata then break end
        end
        if bloccata then break end
    end

    local nome = u.meta.nomeDisplay or u.key
    if bloccata then
        local limite = main_unitDisorderLimit(u.meta)
        if main_unitDisorders(u.key) >= limite then
            melee_message(nome .. " non puo' ritirarsi: rompe")
            main_unitBreak(u.key, "ritirata impossibile")
        else
            main_unitAddDisorders(u.key, 1, limite)
            melee_message(nome .. " non puo' ritirarsi: prende un altro hit")
        end
        return false
    end

    for _, b in ipairs(u.basi) do
        local p = b.getPosition()
        b.setPositionSmooth({ x = p.x + dx, y = p.y, z = p.z + dz }, false, false)
    end
    return true
end
-- ============================================================
-- FUNZIONE: melee_retreatD(u)
-- ============================================================
function melee_retreatD(u)
    return main_unitCategory(u.meta) == CATEGORIA.CAVALLERIA and MELEE.ritiroCavalleria or MELEE.ritiroFanteria
end
-- ============================================================
-- FUNZIONE: melee_message(testo)
-- ============================================================
function melee_message(testo)
    printToAll("[Mischia] " .. testo, "White")
end
