-- ============================================================
-- WARFORGE LDC — 8_melee/hooks.ttslua
-- ============================================================

-- ============================================================
-- FUNZIONE: before_melee(phaseName, phase)
-- Le cariche arrivate a contatto diventano mischie.
-- ============================================================
function before_melee(phaseName, phase)
    melee_start(TURN.activeSide)
    melee_listRefresh()
    callHandler("updateCenterPanel")
end
-- ============================================================
-- FUNZIONE: after_melee(phaseName, phase)
-- Fine della metà turno: tocca all'altro schieramento o inizia
-- il turno successivo.
-- ============================================================
function after_melee(phaseName, phase)
    for slot = 1, 2 do engine_dicePanelCloseAfter(slot, MELEE.dicepanelClose) end
    engine_uiSet("melee_list_army1", "active", "false")
    engine_uiSet("melee_list_army2", "active", "false")
    fire_clearSmoke()
    main_endHalfTurn()
end

-- ============================================================
-- FUNZIONE: resume_melee(phaseName, phase)
-- Partita caricata: mischie fatte e da fare restano.
-- ============================================================
function resume_melee(phaseName, phase)
    if not MELEE_STATE or MELEE_STATE.side ~= TURN.activeSide then
        return before_melee(phaseName, phase)
    end
    MELEE_STATE.mischie = MELEE_STATE.mischie or {}
    melee_listRefresh()
    callHandler("updateCenterPanel")
end
