-- ============================================================
-- WARFORGE LDC — 8_melee/subrenderer.ttslua
-- Renderer delle sottofasi della mischia (come IEF). Solo ASCII.
-- Un renderer che ritorna false nasconde il pannello.
-- ============================================================

-- TIRO: niente pannello finché il giocatore non è entrato nella
-- mischia (riga della lista); poi il bottone a chi non ha ancora
-- tirato e non è già sui dadi.
registerSubRenderer("meleeTiro", function(rec, def, step, slot, isActor)
    local c = rec.ctx or {}
    if not c["entrato" .. slot] then return false end
    if c["rolled" .. slot] then
        return { title = def.title, wait = "In attesa di " .. main_sideName(main_otherSide(slot)) }
    end
    if c["ritiro" .. slot] then
        return { title = def.title, wait = string.format("Ritira %d dadi: premi Roll", c["ritiro" .. slot]) }
    end
    if c["aiDadi" .. slot] then
        return { title = def.title, wait = "Premi Roll" }
    end
    return { title = def.title, button = step.label }
end)

-- ROTTURA e MORALE: tira uno solo (ctx.roller)
registerSubRenderer("meleeRoller", function(rec, def, step, slot, isActor)
    local c = rec.ctx or {}
    if c.roller ~= slot then
        return { title = def.title, wait = "In attesa di " .. main_sideName(c.roller or main_otherSide(slot)) }
    end
    if c["aiDadi" .. slot] then
        return { title = def.title, wait = step.label .. ": premi Roll" }
    end
    return { title = def.title, button = step.label }
end)

-- ESCI: esito, si chiude da solo
registerSubRenderer("meleeEsci", function(rec, def, step, slot, isActor)
    local c = rec.ctx or {}
    return { title = def.title, info = c.esito, wait = "MISCHIA RISOLTA" }
end)
