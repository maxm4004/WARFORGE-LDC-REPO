-- ============================================================
-- FUNZIONE: melee_btn(player, value, id, buttonConfig)
-- "Mischie completate": solo a mischie risolte.
-- ============================================================
function melee_btn(player, value, id, buttonConfig)
    if main_divBlocks(player) then return false end
    if MELEE_ROLLING or MELEE_PENDING then
        warningToColor("C'e' una mischia in corso", player, "Yellow", 4, false)
        return false
    end
    for _, m in ipairs(MELEE_STATE.mischie) do
        if not m.fatta then
            warningToColor("Prima risolvi tutte le mischie (MISCHIA sulle unita' in carica)", player, "Yellow", 5, false)
            return false
        end
    end
    return true
end
