-- ============================================================
-- FUNZIONE: sitting_btn_all(player, value, id, buttonConfig)
-- Il giocatore sceglie lo schieramento del bottone. Per ora
-- 1 contro 1: un solo colore per schieramento.
-- Da soli: si sceglie un esercito, si cambia colore a mano e
-- si sceglie l'altro (come in IEF).
-- ============================================================
function sitting_btn_all(player, value, id, buttonConfig)
    local slot = main_sideOfButton(id)
    if not slot then return false end

    if SIDE_CHOSEN[slot] ~= nil then
        if not main_colorInSide(player.color, slot) then
            warningToColor("Esercito già scelto", player, "Yellow", 5, false)
        end
        return false
    end

    -- Chi cambia schieramento libera quello che aveva scelto
    local altro = main_otherSide(slot)
    if SIDE_CHOSEN[altro] == player.color then
        SIDE_CHOSEN[altro] = nil
    end

    local colore = main_sideMainColor(slot)
    SIDE_CHOSEN[slot] = colore
    if player.color ~= colore then
        player.changeColor(colore)
    end

    return true
end
