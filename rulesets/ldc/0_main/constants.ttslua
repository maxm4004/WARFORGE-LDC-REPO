-- ============================================================
-- WARFORGE LDC — 0_main/constants.ttslua
-- Costanti del ruleset (valori fissi). Lo stato della partita
-- sta in state.ttslua.
-- ============================================================

-- ------------------------------------------------------------
-- Identità del ruleset (lette dal Global comune e dal motore)
-- ------------------------------------------------------------
RULESET_NAME = "LDC"
VERSION      = "LA DERNIERE CHARGE - v0.1.0"

-- ------------------------------------------------------------
-- Debug
-- ------------------------------------------------------------
DEBUG = false

-- ------------------------------------------------------------
-- Azioni e condizioni del motore
-- ------------------------------------------------------------
ACTION = {
    ARMY1_CLICK = "ARMY1_CLICK",
    ARMY2_CLICK = "ARMY2_CLICK",
    CONFIRM     = "CONFIRM",
}

COND = {
    REQUIREMENT_MET       = "requirement_met",        -- entrambi gli schieramenti sono stati scelti
    BOTH_PLAYERS_SELECTED = "both_players_selected",  -- entrambi gli schieramenti hanno completato
    CONFIRM_IMMEDIATE     = "confirm_immediate",      -- il giocatore attivo ha chiuso la fase
    WINNER                = "winner",                 -- il tiro per chi inizia ha un vincitore
}

BUTTONS = {
    BTN_ARMY1  = "BTN_ARMY1",
    BTN_ARMY2  = "BTN_ARMY2",
    BTN_SINGLE = "BTN_SINGLE",
}

-- Modalità di input dei bottoni di fase:
--   FREE   tutti possono cliccare
--   OWNER  ogni schieramento clicca il suo bottone (in parallelo)
--   ACTIVE un solo bottone, solo lo schieramento attivo
INPUT_MODE = {
    FREE   = "FREE",
    OWNER  = "OWNER",
    ACTIVE = "ACTIVE",
}

PHASE = {
    SITTING      = "SITTING",
    FIELD        = "FIELD",
    DEPLOY       = "DEPLOY",
    FIRST_PLAYER = "FIRST_PLAYER",
    COMMAND      = "COMMAND",
    FIRE         = "FIRE",
    MANEUVER     = "MANEUVER",
    MELEE        = "MELEE",
    TURN_CHANGE  = "TURN_CHANGE",
}

-- ------------------------------------------------------------
-- Colori dei giocatori e schieramenti
-- ------------------------------------------------------------
COLOR = {
    RED    = "Red",
    YELLOW = "Yellow",
    GREEN  = "Green",
    BLUE   = "Blue",
    NOARMY = "Grey",
}

-- Modalità di partita
GAME_MODE = {
    ONE_VS_ONE = "1VS1",
    TWO_VS_TWO = "2VS2",
}

-- Colori di ogni schieramento per modalità. Il primo colore è
-- quello principale (bottoni, pannelli dello schieramento).
SIDE_COLORS = {
    [GAME_MODE.ONE_VS_ONE] = {
        [1] = { COLOR.RED },
        [2] = { COLOR.GREEN },
    },
    [GAME_MODE.TWO_VS_TWO] = {
        [1] = { COLOR.RED,   COLOR.YELLOW },
        [2] = { COLOR.GREEN, COLOR.BLUE },
    },
}

-- Modalità in uso: per ora fissa 1 contro 1
GAME_MODE_CURRENT = GAME_MODE.ONE_VS_ONE

SIDE_NAMES = {
    [1] = "Army1",
    [2] = "Army2",
}

-- ------------------------------------------------------------
-- Tavolo e piano verde (0_main/table.ttslua)
-- Nessuna coordinata scritta a mano: tavolo e piano verde si
-- leggono dal mod all'avvio, zone e camere si calcolano da lì.
-- Army1 gioca dal bordo a Z negativa, Army2 da quello a Z
-- positiva.
-- ------------------------------------------------------------

-- Tag del Tile del piano verde (area di gioco)
PIANO_VERDE_TAG = "piano_verde"

-- Tag dell'oggetto tavolo (se manca: tavolo di TTS)
TAVOLO_TAG = "tavolo"

-- Misura del tavolo di TTS coi raggi (unità TTS)
TAVOLO_RAGGI = {
    distanzaMax = 500,    -- oltre questa distanza dal centro si smette
    precisione  = 0.01,
}

-- Scala: unità TTS per centimetro di gioco, calibrata l'8/11/2026
-- con /execute debug_calibrate(...):
--   base di fanteria 4x3 cm  -> 0.790 (rapporto 1.333, esatto)
--   miniatura da 20 mm       -> 0.787 (modello a scala 0.944)
-- Stesso valore di IEF (CM_TO_TTS = 0.7902).
SCALA_TTS_PER_CM = 0.79

-- Scala provvisoria finché SCALA_TTS_PER_CM è nil: quella del
-- righello di TTS (1 unità = 1 pollice = 2,54 cm)
SCALA_TTS_PER_CM_DEFAULT = 1 / 2.54

-- Misure di riferimento per la calibrazione
CALIBRAZIONE = {
    baseFronteCm      = 4,     -- fronte di ogni base
    baseProfonditaCm  = 3,     -- profondità della base di fanteria
    miniaturaAltezzaMm = 20,   -- scala delle miniature
}

-- Distanze di gioco (regolamento: 1D = 6")
POLLICI_PER_D = 6
CM_PER_POLLICE = 2.54

-- Fascia di spawn: fra il bordo del piano verde e il bordo del
-- tavolo, sul lato di ogni schieramento (in unità TTS)
SPAWN = {
    distanzaDalVerde = 1.0,   -- spazio fra il piano verde e la fascia
    margineTavolo    = 0.5,   -- spazio fra la fascia e il bordo del tavolo
    finoAlTavolo     = true,  -- larga fino ai bordi laterali del tavolo (false: quanto il piano verde)
    -- linee disegnate sul tavolo attorno alle fasce
    linee        = true,
    lineeSpessore = 0.3,
    lineeAltezza  = 0.05,     -- sopra il tavolo, per non sparire nel piano
}

-- Postazioni dadi: una per colore giocatore (oggetti del mod).
-- I dadi arrivano sul vassoio (engine/dice.ttslua).
DICE_STATIONS = {
    [COLOR.RED]    = { tray = "5418fe", bag = "eb4ed3" },
    [COLOR.YELLOW] = { tray = "3787b8", bag = "fc24d1" },
    [COLOR.GREEN]  = { tray = "efb29f", bag = "1338a3" },
    [COLOR.BLUE]   = { tray = "f4a3a4", bag = "1e6d1c" },
}

-- Parabola del lancio sul tavolo LDC (vedi engine/constants;
-- da tarare con /execute debug_tiro)
DICE_THROW = {
    rollHeight = 4,
    forza      = 0.68,
    spread     = 3,
    stagger    = 0.15,
    spawnY     = 4,
}

-- ------------------------------------------------------------
-- Camere (engine/lib.ttslua). Le posizioni le calcola
-- main_buildCameraZones() dal piano verde e dai vassoi; qui
-- solo inclinazione, angolo e distanza.
-- ------------------------------------------------------------
CAMERA_ZONE = {
    ARMY_ROLL_DICES = "ArmyRollDices",
    ARMY_HOME       = "ArmyHome",
}

CAMERA_PARAMS = {
    [CAMERA_ZONE.ARMY_HOME] = {
        pitch = 40,
        yaw   = { [1] = 0, [2] = 180 },
        -- distanza = lato maggiore del piano verde × fattore
        distanzaFattore = 0.9,
        -- punto guardato: dal centro verso il proprio bordo
        -- (0 = centro, 1 = bordo)
        versoBordo = 0.5,
    },
    [CAMERA_ZONE.ARMY_ROLL_DICES] = {
        pitch    = 30,
        yaw      = { [1] = 0, [2] = 180 },
        distance = 12,
    },
}

-- Riempita all'avvio da main_buildCameraZones()
CAMERA_ZONES = {}

-- ------------------------------------------------------------
-- Pannello centrale
-- ------------------------------------------------------------
-- Barra di attesa al posto dei bottoni di fase
WAITPANEL = {
    bg        = "rgba(0,0,0,0.35)",
    textColor = "#BBBBBB",
}

CENTERPANEL = {
    doneColor     = COLOR.NOARMY,   -- bottone di chi ha completato
    doneText      = "Black",
    activeText    = "White",
}

-- ------------------------------------------------------------
-- Bottoni 3D sulle basi (0_main/buttons.ttslua), misure nello
-- spazio della base (come IEF; da tarare in TTS)
-- ------------------------------------------------------------
BASE_BUTTONS = {
    y        = 0.1,      -- sopra la base
    dietro   = 0.2,      -- dal bordo posteriore della base
    passoX   = 0.85,     -- fra due bottoni affiancati
    passoZ   = 0.55,     -- seconda fila (cartellino disordini)
    width    = 400,
    height   = 220,
    fontSize = 70,
    textColor = "White",
    disColor  = { r = 0.55, g = 0.1, b = 0.1 },
    -- colori dei bottoni speciali
    bersaglioColor = { r = 0.85, g = 0.45, b = 0.0 },
    annullaColor   = { r = 0.35, g = 0.35, b = 0.35 },
}

-- ------------------------------------------------------------
-- Mirino (0_main/mirino.ttslua, come IEF F38-F40): gettone da
-- trascinare sul bersaglio nel Fuoco e nella Carica
-- ------------------------------------------------------------
MIRINO = {
    icona    = "mirino_tiro",   -- asset UI del mod; senza, pedina colorata
    scala    = 0.20,            -- gettone con l'icona
    davanti  = 0.8,             -- pollici fra il fronte e il centro del mirino
    rotY     = 45,              -- si somma alla direzione dell'unità
    sotto    = 0.3,             -- pollici: base nemica "sotto" il mirino
    tick     = 0.1,             -- secondi fra due controlli durante il trascinamento
    colori   = { ok = "#40FF40", arancio = "#FFA020", rosso = "#FF4040" },
    linea    = { ok = { 0.2, 0.9, 0.2 }, arancio = { 1, 0.63, 0.13 }, rosso = { 1, 0.2, 0.2 }, nessuno = { 1, 0.8, 0.1 } },
    spessore = 0.08,
}

-- Pannellino del mirino sulla base di comando (posizioni di IEF
-- main_calcolaPosizionePannello, per fronte di 1..8 basi)
MIRINO_PANNELLO = {
    bg     = "rgba(0,0,0,0.70)",
    close  = "rgba(0.35,0.35,0.35,1)",
    x      = { 10, 150, 310, 470, 630, 800, 960, 1120 },
    passoX = 160,
    y      = 100,
    z      = -500,
}

-- ------------------------------------------------------------
-- Pannelli di conferma (come IEF CONFIRMPANEL): bottone d'azione
-- oro, Chiudi grigio chiaro
-- ------------------------------------------------------------
CONFIRMPANEL = {
    actionBg   = "#B8902E",
    closeBg    = "rgba(0.75,0.75,0.75,1)",
    actionText = "Black",
    closeText  = "Black",
}

-- Secondi in cui l'esito resta a schermo prima che la sottofase
-- si chiuda da sola (come IEF MORALE_ESITO_SECONDS)
MORALE_ESITO_SECONDS = 6
