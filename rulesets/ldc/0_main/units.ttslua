-- ============================================================
-- WARFORGE LDC — 0_main/units.ttslua
-- Unità sul tavolo (basi raggruppate per unitKey) e loro stato
-- di gioco: disordini e rotta (regolamento 3.4).
--
-- UNIT_STATE[unitKey] = { disordini = n } (salvato). Un'unità
-- che rompe viene tolta dal tavolo e segnata in UNIT_BROKEN
-- (servirà al Morale di Divisione).
-- ============================================================

UNIT_STATE  = UNIT_STATE  or {}
UNIT_BROKEN = UNIT_BROKEN or {}   -- [unitKey] = { side, divisione, brigata, turno }

-- ============================================================
--                         LETTURA
-- ============================================================

-- ============================================================
-- FUNZIONE: main_unitsOfSide(slot)
-- Unità dello schieramento sul tavolo (generali esclusi):
-- { [unitKey] = { key, meta, basi = { obj... }, comando = obj } }
-- meta = GMNotes della base .1 (o della prima trovata).
-- ============================================================
function main_unitsOfSide(slot)
    local unita = {}
    for _, b in ipairs(main_basesOfSide(slot)) do
        local m = b.meta
        -- le unità rotte sono distrutte a fine frame: si saltano subito
        if m.ruolo == DEPLOY_RUOLO.UNITA and m.unitKey and not UNIT_BROKEN[m.unitKey] then
            local u = unita[m.unitKey]
            if not u then
                u = { key = m.unitKey, meta = m, basi = {}, side = slot }
                unita[m.unitKey] = u
            end
            table.insert(u.basi, b.obj)
            if m.baseSeq == 1 then
                u.comando = b.obj
                u.meta = m
            end
        end
    end
    for _, u in pairs(unita) do
        u.comando = u.comando or u.basi[1]
    end
    return unita
end
-- ============================================================
-- FUNZIONE: main_generalsOfSide(slot)
-- Generali dello schieramento come "unità" di una base:
-- { [unitKey] = { key, meta, basi = { obj }, comando = obj, generale = true } }
-- ============================================================
function main_generalsOfSide(slot)
    local gen = {}
    for _, b in ipairs(main_basesOfSide(slot)) do
        local m = b.meta
        if m.ruolo ~= DEPLOY_RUOLO.UNITA and m.unitKey then
            gen[m.unitKey] = { key = m.unitKey, meta = m, basi = { b.obj }, comando = b.obj, generale = true, side = slot }
        end
    end
    return gen
end
-- ============================================================
-- FUNZIONE: main_unitOrGeneral(slot, unitKey)
-- ============================================================
function main_unitOrGeneral(slot, unitKey)
    return main_unitsOfSide(slot)[unitKey] or main_generalsOfSide(slot)[unitKey]
end
-- ============================================================
-- FUNZIONE: main_unit(unitKey)
-- Unità (come main_unitsOfSide) dalla chiave, nil se non c'è.
-- ============================================================
function main_unit(unitKey)
    for slot = 1, 2 do
        local u = main_unitsOfSide(slot)[unitKey]
        if u then u.side = slot; return u end
    end
    return nil
end
-- ============================================================
-- FUNZIONE: main_unitType(meta)
-- Dati del tipo (LDC_TIPI) dalle GMNotes.
-- ============================================================
function main_unitType(meta)
    return (meta and meta.tipo and LDC_TIPI[meta.tipo]) or {}
end
-- ============================================================
-- FUNZIONE: main_unitCategory(meta)
-- ============================================================
function main_unitCategory(meta)
    return main_unitType(meta).categoria
end

-- ============================================================
--                        GEOMETRIA
-- ============================================================

-- ============================================================
-- FUNZIONE: main_baseForward(obj)
-- Direzione del fronte della base sul piano XZ (unitaria).
-- ============================================================
function main_baseForward(obj)
    local a = math.rad(obj.getRotation().y)
    return { x = math.sin(a), z = math.cos(a) }
end
-- ============================================================
-- FUNZIONE: main_unitCenter(u)
-- ============================================================
function main_unitCenter(u)
    local x, z = 0, 0
    for _, b in ipairs(u.basi) do
        local p = b.getPosition()
        x, z = x + p.x, z + p.z
    end
    return { x = x / #u.basi, z = z / #u.basi }
end
-- ============================================================
-- FUNZIONE: main_unitDistanceInches(uA, uB)
-- Distanza fra due unità: la minima fra le loro basi.
-- ============================================================
function main_unitDistanceInches(uA, uB)
    local best = nil
    for _, a in ipairs(uA.basi) do
        for _, b in ipairs(uB.basi) do
            local d = main_distanceInches(a, b)
            if d and (not best or d < best) then best = d end
        end
    end
    return best
end
-- ============================================================
-- FUNZIONE: main_unitDistanceD(uA, uB)
-- ============================================================
function main_unitDistanceD(uA, uB)
    local p = main_unitDistanceInches(uA, uB)
    return p and main_inchToD(p) or nil
end
-- ============================================================
-- FUNZIONE: main_unitFirstRank(u)
-- Basi del primo rango: quelle più avanti lungo il fronte
-- della base di comando (entro mezza profondità di base).
-- ============================================================
function main_unitFirstRank(u)
    local f = main_baseForward(u.comando)
    local meta = u.meta or {}
    local tolleranza = main_cmToTts(meta.profonditaCm or CALIBRAZIONE.baseProfonditaCm) / 2
    local avanti, max = {}, -math.huge
    for i, b in ipairs(u.basi) do
        local p = b.getPosition()
        avanti[i] = p.x * f.x + p.z * f.z
        max = math.max(max, avanti[i])
    end
    local primo = {}
    for i, b in ipairs(u.basi) do
        if avanti[i] >= max - tolleranza then table.insert(primo, b) end
    end
    return primo
end
-- ============================================================
-- FUNZIONE: main_unitInFront(u, bersaglio)
-- Il bersaglio è davanti all'unità (semipiano del fronte)?
-- ============================================================
function main_unitInFront(u, bersaglio)
    local f = main_baseForward(u.comando)
    local c = main_unitCenter(u)
    for _, b in ipairs(bersaglio.basi) do
        local p = b.getPosition()
        if (p.x - c.x) * f.x + (p.z - c.z) * f.z > 0 then return true end
    end
    return false
end

-- ============================================================
--                     DISORDINI E ROTTA
-- ============================================================

-- ============================================================
-- FUNZIONE: main_unitDisorders(unitKey)
-- ============================================================
function main_unitDisorders(unitKey)
    local s = UNIT_STATE[unitKey]
    return s and s.disordini or 0
end
-- ============================================================
-- FUNZIONE: main_unitDisorderLimit(meta)
-- Disordini sopportati: oltre questo numero l'unità rompe.
-- ============================================================
function main_unitDisorderLimit(meta)
    return LDC_LIMITE_DISORDINI[(meta and meta.taglia) or "standard"] or LDC_LIMITE_DISORDINI.standard
end
-- ============================================================
-- FUNZIONE: main_unitAddDisorders(unitKey, n)
-- Aggiunge disordini (senza superare il limite: la rotta si
-- decide con il tiro di rottura). Ritorna i disordini aggiunti.
-- ============================================================
function main_unitAddDisorders(unitKey, n, limite)
    local s = UNIT_STATE[unitKey] or { disordini = 0 }
    UNIT_STATE[unitKey] = s
    local prima = s.disordini
    s.disordini = math.min(prima + n, limite or math.huge)
    return s.disordini - prima
end
-- ============================================================
-- FUNZIONE: main_unitBreak(unitKey, motivo)
-- L'unità rompe: basi tolte dal tavolo (3.4.3).
-- ============================================================
function main_unitBreak(unitKey, motivo)
    local u = main_unit(unitKey)
    if not u then return end
    UNIT_BROKEN[unitKey] = {
        side = u.side, divisione = u.meta.divisione, brigata = u.meta.brigata,
        turno = ENGINE.turn, motivo = motivo,
    }
    UNIT_STATE[unitKey] = nil
    printToAll("[Rotta] " .. tostring(u.meta.nomeDisplay or unitKey) .. " rompe e lascia il campo"
        .. (motivo and (" (" .. motivo .. ")") or ""), main_sideMainColor(u.side))
    local basi = {}
    for _, b in ipairs(u.basi) do table.insert(basi, b) end
    for _, b in ipairs(basi) do b.destruct() end
    -- Morale di Divisione (12): conta l'unità appena rotta
    main_divCheck(u.side, u.meta.divisione)
end
-- ============================================================
-- FUNZIONE: main_unitsReset()
-- ============================================================
function main_unitsReset()
    UNIT_STATE  = {}
    UNIT_BROKEN = {}
end

-- ============================================================
--                  FORMAZIONE E QUADRATO
-- ============================================================

-- ============================================================
-- FUNZIONE: main_unitFormation(u)
-- Formazione in gioco: "quadrato" se l'unità ha formato il
-- quadrato (UNIT_STATE), altrimenti quella del JSON.
-- ============================================================
function main_unitFormation(u)
    local s = u and UNIT_STATE[u.key]
    if s and s.quadrato then return "quadrato" end
    return u and u.meta and u.meta.formazione or nil
end
-- ============================================================
-- FUNZIONE: main_squareForm(u)
-- Dispone le basi in quadrato (9.1) attorno al centro
-- dell'unità: una base per lato rivolta all'esterno (la base di
-- comando sul fronte), le altre al centro. Salva la disposizione
-- di prima (relativa al centro) per scioglierlo.
-- ============================================================
function main_squareForm(u)
    if not u or u.generale then return end
    local ref = u.comando
    local yaw = ref.getRotation().y
    local a = math.rad(yaw)
    local f = { x = math.sin(a), z = math.cos(a) }
    local r = { x = f.z, z = -f.x }
    local rp = main_unitCenter(u)
    -- disposizione di prima, attorno al centro dell'unità
    local prima = {}
    for _, b in ipairs(u.basi) do
        local p = b.getPosition()
        local dx, dz = p.x - rp.x, p.z - rp.z
        prima[b.getGUID()] = { f = dx * f.x + dz * f.z, r = dx * r.x + dz * r.z, ry = b.getRotation().y - yaw }
    end
    local s = UNIT_STATE[u.key] or { disordini = 0 }
    UNIT_STATE[u.key] = s
    s.quadrato = { prima = prima }

    local c = main_unitCenter(u)
    local larg = main_cmToTts(u.meta.fronteCm or CALIBRAZIONE.baseFronteCm)
    local prof = main_cmToTts(u.meta.profonditaCm or CALIBRAZIONE.baseProfonditaCm)
    local off = math.max(larg / 2, prof) + prof / 2
    -- ordine: comando, poi le altre per numero di base
    local basi = { ref }
    local altre = {}
    for _, b in ipairs(u.basi) do if b ~= ref then table.insert(altre, b) end end
    table.sort(altre, function(x, y)
        return ((main_baseMeta(x) or {}).baseSeq or 0) < ((main_baseMeta(y) or {}).baseSeq or 0)
    end)
    for _, b in ipairs(altre) do table.insert(basi, b) end
    -- fronte, retro, destra, sinistra, poi al centro
    local lati = {
        { df = off,  dr = 0,    rot = 0 },
        { df = -off, dr = 0,    rot = 180 },
        { df = 0,    dr = off,  rot = 90 },
        { df = 0,    dr = -off, rot = 270 },
    }
    local centro = 0
    local nCentro = math.max(#basi - 4, 0)
    for i, b in ipairs(basi) do
        local l = lati[i]
        if not l then
            centro = centro + 1
            l = { df = (nCentro == 1) and 0 or ((centro == 1) and prof / 2 or -prof / 2), dr = 0, rot = 0 }
        end
        local p = b.getPosition()
        b.setRotation({ x = 0, y = yaw + l.rot, z = 0 })
        b.setPosition({ x = c.x + f.x * l.df + r.x * l.dr, y = p.y, z = c.z + f.z * l.df + r.z * l.dr })
    end
end
-- ============================================================
-- FUNZIONE: main_squareExit(u)
-- Scioglie il quadrato: torna la disposizione di prima, attorno
-- al centro del quadrato e col fronte della base di comando.
-- ============================================================
function main_squareExit(u)
    local s = u and UNIT_STATE[u.key]
    if not s or not s.quadrato then return end
    local prima = s.quadrato.prima or {}
    s.quadrato = nil
    local ref = u.comando
    local yaw = ref.getRotation().y
    local a = math.rad(yaw)
    local f = { x = math.sin(a), z = math.cos(a) }
    local r = { x = f.z, z = -f.x }
    local rp = main_unitCenter(u)
    for _, b in ipairs(u.basi) do
        local q = prima[b.getGUID()]
        if q then
            local p = b.getPosition()
            b.setPosition({ x = rp.x + f.x * q.f + r.x * q.r, y = p.y, z = rp.z + f.z * q.f + r.z * q.r })
            b.setRotation({ x = 0, y = yaw + q.ry, z = 0 })
        end
    end
end
