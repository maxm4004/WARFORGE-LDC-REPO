-- ============================================================
-- FUNZIONE: debug_moveToPhase(phaseName)
-- Salta a una fase, senza condizioni.
-- ============================================================
function debug_moveToPhase(phaseName)
    main_goToPhase(phaseName)
end
-- ============================================================
-- FUNZIONE: debug_reset()
-- Azzera sottofasi, dadi e completamenti, resta nella fase
-- corrente.
-- ============================================================
function debug_reset()
    engine_subInitState()
    engine_dicePanelClose(1)
    engine_dicePanelClose(2)
    engine_diceClearLastRoll(1)
    engine_diceClearLastRoll(2)
    main_resetCompleted()
    main_updateCenterPanel()
    print("[DEBUG] reset nella fase " .. tostring(ENGINE.phase))
end
-- ============================================================
-- FUNZIONE: debug_turn()
-- Stampa fase, turno e schieramento attivo.
-- ============================================================
function debug_turn()
    print("[DEBUG] fase " .. tostring(ENGINE.phase) .. ", turno " .. tostring(ENGINE.turn))
    printTable(TURN)
end

-- ============================================================
--              MISURE DEL TAVOLO E CALIBRAZIONE
-- Da console: /execute debug_...  (risultati in chat)
-- ============================================================

-- ============================================================
-- FUNZIONE: debug_fmt(v)
-- Numero con 3 decimali.
-- ============================================================
function debug_fmt(v)
    return string.format("%.3f", v or 0)
end
-- ============================================================
-- FUNZIONE: debug_selectedObjects()
-- Oggetti selezionati da tutti i giocatori seduti, con il
-- giocatore che li ha selezionati.
-- ============================================================
function debug_selectedObjects()
    local result = {}
    for _, p in ipairs(Player.getPlayers()) do
        if p.seated then
            for _, obj in ipairs(p.getSelectedObjects() or {}) do
                table.insert(result, { obj = obj, player = p })
            end
        end
    end
    return result
end
-- ============================================================
-- FUNZIONE: debug_pos()
-- Per ogni oggetto selezionato: GUID, nome, posizione,
-- rotazione, dimensioni. Senza selezione: posizione del
-- puntatore di ogni giocatore seduto.
-- ============================================================
function debug_pos()
    local sel = debug_selectedObjects()

    if #sel == 0 then
        for _, p in ipairs(Player.getPlayers()) do
            if p.seated then
                local q = p.getPointerPosition()
                print(string.format("[POS] puntatore %s: x=%s y=%s z=%s",
                    p.color, debug_fmt(q.x), debug_fmt(q.y), debug_fmt(q.z)))
            end
        end
        return
    end

    for _, s in ipairs(sel) do
        local o = s.obj
        local p, r, b = o.getPosition(), o.getRotation(), o.getBounds()
        print(string.format("[POS] %s \"%s\": pos x=%s y=%s z=%s | rot y=%s | dim x=%s y=%s z=%s%s",
            o.getGUID(), o.getName() or "",
            debug_fmt(p.x), debug_fmt(p.y), debug_fmt(p.z),
            debug_fmt(r.y),
            debug_fmt(b.size.x), debug_fmt(b.size.y), debug_fmt(b.size.z),
            main_isCardinal(o) and "" or "  (ruotato: dimensioni non affidabili)"))
    end
end
-- ============================================================
-- FUNZIONE: debug_measure()
-- Rilegge tavolo e piano verde, ricalcola le zone e le stampa.
-- ============================================================
function debug_measure()
    main_measureTable()

    local function rect(nome, a)
        if not a then print("[MISURE] " .. nome .. ": non trovato") return end
        print(string.format("[MISURE] %s: %s x %s unità | X %s..%s  Z %s..%s | superficie y=%s",
            nome, debug_fmt(a.larghezza), debug_fmt(a.profondita),
            debug_fmt(a.minX), debug_fmt(a.maxX), debug_fmt(a.minZ), debug_fmt(a.maxZ), debug_fmt(a.y)))
    end

    rect("Tavolo" .. ((TABLE_AREA and TABLE_AREA.conRaggi) and " (misurato coi raggi)" or ""), TABLE_AREA)
    rect("Piano verde", PLAY_AREA)

    if PLAY_AREA then
        local g = PLAY_AREA.gioco
        print(string.format("[MISURE] Piano verde in gioco: %.1f x %.1f cm = %.1f x %.1f\" = %.1f x %.1f D%s",
            g.cm.larghezza, g.cm.profondita, g.pollici.larghezza, g.pollici.profondita,
            g.D.larghezza, g.D.profondita,
            main_isScaleCalibrated() and "" or "  (scala NON calibrata)"))
    end

    for slot = 1, 2 do
        local f = main_spawnStrip(slot)
        if f then
            print(string.format("[MISURE] Spawn %s: %s x %s unità, Z %s..%s",
                main_sideName(slot), debug_fmt(f.larghezza), debug_fmt(f.profondita), debug_fmt(f.minZ), debug_fmt(f.maxZ)))
        else
            print("[MISURE] Spawn " .. main_sideName(slot) .. ": nessuno spazio fra piano verde e bordo del tavolo")
        end
    end
end
-- ============================================================
-- FUNZIONE: debug_cam(zona, slot, pitch, distance, yaw, versoBordo)
-- Porta la camera dei giocatori dello schieramento sulla zona
-- (es. "ArmyHome"). pitch, distance, yaw e (solo ArmyHome)
-- versoBordo, se dati, sostituiscono quelli calcolati: servono
-- a provare i valori da mettere in CAMERA_PARAMS.
-- versoBordo: punto guardato, 0 = centro del piano verde,
-- 1 = proprio bordo.
-- ============================================================
function debug_cam(zona, slot, pitch, distance, yaw, versoBordo)
    zona = zona or CAMERA_ZONE.ARMY_HOME
    slot = slot or 1
    local z = CAMERA_ZONES[zona]
    if not z then print("[CAM] Zona non trovata: " .. tostring(zona)) return end

    local p = pitch or z.pitch
    local d = distance or z.distance
    local y = yaw or z.yaw[slot]

    local pos = z.position[slot]
    local vb  = nil
    if zona == CAMERA_ZONE.ARMY_HOME then
        vb = versoBordo or CAMERA_PARAMS[CAMERA_ZONE.ARMY_HOME].versoBordo
        local area = main_gameArea()
        if area then
            local edge = main_sideEdgeZ(slot)
            pos = { x = area.cx, y = area.y, z = area.cz + (edge - area.cz) * vb }
        end
    end

    for _, player in ipairs(main_sidePlayers(slot)) do
        engine_camera(player, pos, p, y, d)
    end
    print(string.format("[CAM] %s %s: pitch=%s distance=%s yaw=%s%s", zona, main_sideName(slot),
        tostring(p), debug_fmt(d), tostring(y), vb and (" versoBordo=" .. tostring(vb)) or ""))
end
-- ============================================================
-- FUNZIONE: debug_calibrate(tipo)
-- Scala dalle misure reali degli oggetti selezionati, a
-- rotazione 0/90/180/270:
--   "base"  base di fanteria (fronte 4 cm, profondità 3 cm)
--   "mini"  miniatura (altezza CALIBRAZIONE.miniaturaAltezzaMm)
--   "piano" piano verde: misure di gioco con la scala corrente
-- Stampa la scala da incollare in SCALA_TTS_PER_CM.
-- ============================================================
function debug_calibrate(tipo)
    tipo = tipo or "base"
    local sel = debug_selectedObjects()

    if tipo == "piano" then
        debug_measure()
        return
    end

    if #sel == 0 then
        print("[CALIBRA] Seleziona prima " .. (tipo == "mini" and "una miniatura" or "una base"))
        return
    end

    local scale = {}
    for _, s in ipairs(sel) do
        local o = s.obj
        if not main_isCardinal(o) then
            print("[CALIBRA] " .. o.getGUID() .. " ruotato di " .. debug_fmt(o.getRotation().y)
                .. "°: va messo a 0, 90, 180 o 270")
        else
            local b = o.getBounds()
            -- a 90/270 i lati X e Z sono scambiati
            local ry = math.floor((o.getRotation().y + 45) / 90) % 2
            local fronte     = (ry == 0) and b.size.x or b.size.z
            local profondita = (ry == 0) and b.size.z or b.size.x

            if tipo == "mini" then
                local k = b.size.y / (CALIBRAZIONE.miniaturaAltezzaMm / 10)
                table.insert(scale, k)
                print(string.format("[CALIBRA] mini %s: altezza %s unità -> %s unità/cm",
                    o.getGUID(), debug_fmt(b.size.y), debug_fmt(k)))
            else
                local kF = fronte / CALIBRAZIONE.baseFronteCm
                local kP = profondita / CALIBRAZIONE.baseProfonditaCm
                table.insert(scale, kF)
                print(string.format("[CALIBRA] base %s: fronte %s, profondità %s unità -> %s unità/cm (dal fronte), %s (dalla profondità), rapporto %s (atteso %s)",
                    o.getGUID(), debug_fmt(fronte), debug_fmt(profondita), debug_fmt(kF), debug_fmt(kP),
                    debug_fmt(fronte / profondita), debug_fmt(CALIBRAZIONE.baseFronteCm / CALIBRAZIONE.baseProfonditaCm)))
            end
        end
    end

    if #scale == 0 then return end
    local somma = 0
    for _, k in ipairs(scale) do somma = somma + k end
    local media = somma / #scale

    print(string.format("[CALIBRA] Scala %s (%d oggetti): SCALA_TTS_PER_CM = %s",
        tipo, #scale, string.format("%.4f", media)))

    if main_isScaleCalibrated() then
        print(string.format("[CALIBRA] Scarto dalla scala in uso (%s): %+.1f%%",
            string.format("%.4f", SCALA_TTS_PER_CM), (media / SCALA_TTS_PER_CM - 1) * 100))
    end

    -- Con questa scala: piano verde e tavolo in misure di gioco
    if PLAY_AREA then
        local cm = PLAY_AREA.larghezza / media
        local cmP = PLAY_AREA.profondita / media
        print(string.format("[CALIBRA] Con questa scala il piano verde è %.1f x %.1f cm (%.1f x %.1f D)",
            cm, cmP, cm / CM_PER_POLLICE / POLLICI_PER_D, cmP / CM_PER_POLLICE / POLLICI_PER_D))
    end
    if TABLE_AREA then
        local cm = TABLE_AREA.larghezza / media
        local cmP = TABLE_AREA.profondita / media
        print(string.format("[CALIBRA] e il tavolo intero %.1f x %.1f cm (%.1f x %.1f D)",
            cm, cmP, cm / CM_PER_POLLICE / POLLICI_PER_D, cmP / CM_PER_POLLICE / POLLICI_PER_D))
    end
end
-- ============================================================
-- FUNZIONE: debug_centraPiano()
-- /execute debug_centraPiano(): piano verde al centro del
-- tavolo.
-- ============================================================
function debug_centraPiano()
    main_centerPianoVerde()
end
-- ============================================================
-- FUNZIONE: debug_raggio(x, z)
-- Tutto ciò che un raggio verticale colpisce in (x, z), e
-- l'oggetto tavolo di TTS, per capire come riconoscerlo.
-- ============================================================
function debug_raggio(x, z)
    x, z = x or 0, z or 0

    local function info(o)
        if not o then return "nil" end
        local ok1, guid = pcall(function() return o.getGUID() end)
        local ok2, nome = pcall(function() return o.getName() end)
        local ok3, tipo = pcall(function() return o.type end)
        local ok4, nick = pcall(function() return o.name end)
        return string.format("guid=%s nome=%s name=%s type=%s",
            tostring(ok1 and guid), tostring(ok2 and nome), tostring(ok4 and nick), tostring(ok3 and tipo))
    end

    local tavolo = Tables and Tables.getTableObject and Tables.getTableObject()
    print("[RAGGIO] Tables.getTableObject(): " .. info(tavolo))
    print("[RAGGIO] Tables.getTable(): " .. tostring(Tables and Tables.getTable and Tables.getTable()))

    local hits = Physics.cast({
        origin       = { x = x, y = 50, z = z },
        direction    = { x = 0, y = -1, z = 0 },
        type         = 1,
        max_distance = 100,
    }) or {}

    print(string.format("[RAGGIO] in x=%s z=%s: %d oggetti colpiti", tostring(x), tostring(z), #hits))
    for i, h in ipairs(hits) do
        print(string.format("[RAGGIO] %d) y=%s %s %s", i, debug_fmt(h.point and h.point.y),
            info(h.hit_object), (h.hit_object == tavolo) and "(= tavolo)" or ""))
    end
end
-- ============================================================
-- FUNZIONE: debug_tiro(color, dadi, rollHeight, forza, spread, spawnY)
-- Lancio di prova dalla postazione del colore, con parametri
-- della parabola al posto di quelli in DICE_THROW (nil = valore
-- in uso). Es.: /execute debug_tiro("Red", 6, 4, 0.6)
-- ============================================================
function debug_tiro(color, dadi, rollHeight, forza, spread, spawnY)
    color = color or COLOR.RED
    local slot = main_sideOfColor(color) or 1
    local opts = { rollHeight = rollHeight, forza = forza, spread = spread, spawnY = spawnY }

    engine_diceClearLastRoll(slot)
    engine_diceSetNext(slot, dadi or 6, nil)
    engine_diceThrowFromBag(slot, opts, function(risultati)
        local fuori = 0
        local st = main_diceStation(color)
        local tray = st and getObjectFromGUID(st.tray)
        if tray then
            local b = tray.getBounds()
            for _, d in ipairs(ENGINE_DICE_LAST_ROLL[slot] or {}) do
                if not d.isDestroyed() then
                    local p = d.getPosition()
                    if math.abs(p.x - b.center.x) > b.size.x / 2 or math.abs(p.z - b.center.z) > b.size.z / 2 then
                        fuori = fuori + 1
                    end
                end
            end
        end
        print(string.format("[TIRO] %s: rollHeight=%s forza=%s spread=%s spawnY=%s -> %d dadi, %d fuori dal vassoio",
            color,
            tostring(rollHeight or DICE_THROW.rollHeight), tostring(forza or DICE_THROW.forza),
            tostring(spread or DICE_THROW.spread), tostring(spawnY or DICE_THROW.spawnY),
            #risultati, fuori))
    end, color)
end
-- ============================================================
-- FUNZIONE: debug_camDadi(color, pitch, distance, yaw)
-- Camera sul vassoio del colore con inclinazione, distanza e
-- yaw di prova (nil = valori in CAMERA_PARAMS).
-- Es.: /execute debug_camDadi("Red", 45, 20, 0)
-- ============================================================
function debug_camDadi(color, pitch, distance, yaw)
    color = color or COLOR.RED
    local slot = main_sideOfColor(color) or 1
    local st = main_diceStation(color)
    local tray = st and getObjectFromGUID(st.tray)
    if not tray then print("[CAM] Vassoio non trovato per " .. tostring(color)) return end

    local par = CAMERA_PARAMS[CAMERA_ZONE.ARMY_ROLL_DICES]
    local p = pitch or par.pitch
    local d = distance or par.distance
    local y = yaw or par.yaw[slot]
    local pos = tray.getPosition()
    for _, player in ipairs(main_sidePlayers(slot)) do
        engine_camera(player, { x = pos.x, y = pos.y, z = pos.z }, p, y, d)
    end
    print(string.format("[CAM] dadi %s: pitch=%s distance=%s yaw=%s", color, tostring(p), tostring(d), tostring(y)))
end
-- ============================================================
-- FUNZIONE: debug_modello()
-- Per ogni oggetto selezionato stampa in chat i dati del
-- modello (mesh, texture, AssetBundle, scala, figli), da
-- copiare negli elementi del file esercito.
-- ============================================================
function debug_modello()
    local sel = debug_selectedObjects()
    if #sel == 0 then
        print("[MODELLO] Seleziona prima uno o più oggetti")
        return
    end

    for _, s in ipairs(sel) do
        local o = s.obj
        local d = o.getData()
        local sc = o.getScale()
        local b = o.getBounds()

        print(string.format("[MODELLO] ===== %s \"%s\" tipo=%s scala=%s/%s/%s dim=%s x %s x %s",
            o.getGUID(), o.getName() or "", tostring(d.Name),
            debug_fmt(sc.x), debug_fmt(sc.y), debug_fmt(sc.z),
            debug_fmt(b.size.x), debug_fmt(b.size.y), debug_fmt(b.size.z)))

        local function stampa(prefisso, dati)
            if dati.CustomMesh then
                local m = dati.CustomMesh
                print(prefisso .. "mesh=" .. tostring(m.MeshURL))
                print(prefisso .. "texture=" .. tostring(m.DiffuseURL))
                print(prefisso .. "normal=" .. tostring(m.NormalURL))
                print(prefisso .. "collider=" .. tostring(m.ColliderURL))
                print(prefisso .. string.format("convex=%s materiale=%s tipo_tts=%s",
                    tostring(m.Convex), tostring(m.MaterialIndex), tostring(m.TypeIndex)))
            end
            if dati.CustomAssetbundle then
                local a = dati.CustomAssetbundle
                print(prefisso .. "bundle=" .. tostring(a.AssetbundleURL))
                print(prefisso .. "bundle_secondario=" .. tostring(a.AssetbundleSecondaryURL))
                print(prefisso .. string.format("materiale=%s tipo_tts=%s",
                    tostring(a.MaterialIndex), tostring(a.TypeIndex)))
            end
            if not dati.CustomMesh and not dati.CustomAssetbundle then
                print(prefisso .. "(nessun modello personalizzato: " .. tostring(dati.Name) .. ")")
            end
        end

        stampa("[MODELLO]   ", d)

        -- figli (oggetti attaccati, es. figure sulla base)
        for i, c in ipairs(d.ChildObjects or {}) do
            local t = c.Transform or {}
            print(string.format("[MODELLO]   -- figlio %d: %s pos=%s/%s/%s scala=%s/%s/%s rotY=%s",
                i, tostring(c.Nickname or c.Name),
                debug_fmt(t.posX), debug_fmt(t.posY), debug_fmt(t.posZ),
                debug_fmt(t.scaleX), debug_fmt(t.scaleY), debug_fmt(t.scaleZ), debug_fmt(t.rotY)))
            stampa("[MODELLO]      ", c)
        end
    end
end
-- ============================================================
-- FUNZIONE: debug_lineeSpawn(visibili)
-- Mostra (true) o nasconde (false) le linee delle fasce di
-- spawn. /execute debug_lineeSpawn(false)
-- ============================================================
function debug_lineeSpawn(visibili)
    SPAWN.linee = visibili ~= false
    main_drawSpawnLines()
end
-- ============================================================
-- FUNZIONE: debug_offsetFigure(nomeModello)
-- Per la base selezionata stampa le figure attaccate già nel
-- formato di "figure" del file esercito: posizione in cm dal
-- centro della base (unità locali × scala della base / scala).
-- nomeModello: nome da usare per il campo "modello" quando la
-- figura non ha un nome in TTS (default "FIGURA").
-- ============================================================
function debug_offsetFigure(nomeModello)
    local sel = debug_selectedObjects()
    if #sel == 0 then
        print("[FIGURE] Seleziona prima una base")
        return
    end

    for _, s in ipairs(sel) do
        local o = s.obj
        local d = o.getData()
        local scalaBase = o.getScale().x
        local figli = d.ChildObjects or {}

        print(string.format("[FIGURE] ===== %s \"%s\": %d figure, scala base %s",
            o.getGUID(), o.getName() or "", #figli, debug_fmt(scalaBase)))

        local function cm(v)
            return string.format("%.2f", main_ttsToCm((v or 0) * scalaBase))
        end

        for i, c in ipairs(figli) do
            local t = c.Transform or {}
            local nome = c.Nickname
            if not nome or nome == "" then nome = nomeModello or "FIGURA" end
            local riga = string.format('{ "modello": "%s", "x": %s, "y": %s, "z": %s }%s',
                nome, cm(t.posX), cm(t.posY), cm(t.posZ), (i < #figli) and "," or "")
            print("[FIGURE] " .. riga)
        end
    end
end
