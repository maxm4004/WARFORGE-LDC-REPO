-- ============================================================
-- WARFORGE LDC — 0_main/buttons.ttslua
-- Bottoni 3D sulle basi (come IEF): su ogni unità la base di
-- comando (.1) porta i bottoni della fase in corso e un
-- cartellino con i disordini.
--
-- La fase dice quali bottoni con il campo baseButtons della sua
-- definizione: nome di una funzione (obj, unita, slot) che
-- ritorna una lista di { label, click, tooltip, color, width }.
-- click = nome di una funzione globale (obj, player_color,
-- alt_click).
-- Si ridisegnano all'ingresso in fase e quando cambia qualcosa
-- (main_refreshBaseButtons).
-- ============================================================

-- ============================================================
-- FUNZIONE: main_baseButtonNoop()
-- Click dei cartellini (non fanno nulla).
-- ============================================================
function main_baseButtonNoop() end
-- ============================================================
-- FUNZIONE: main_refreshBaseButtons()
-- Ridisegna i bottoni di tutte le unità.
-- ============================================================
-- Bottoni già sulle basi: MAIN_BTN_FIRMA[guid] = firma dei
-- bottoni disegnati. Si ricreano solo quelli cambiati: clear e
-- create su decine di basi a ogni click erano il collo di
-- bottiglia (prestazioni, Max 12/11/2026).
MAIN_BTN_FIRMA = {}

function main_refreshBaseButtons()
    local phase = ENGINE and ENGINE.phases and ENGINE.phases[ENGINE.phase]
    local provider = phase and phase.baseButtons and _G[phase.baseButtons]

    for slot = 1, 2 do
        -- bottoni voluti per base: [guid] = { obj, bottoni }
        local voluti = {}
        for _, u in pairs(main_unitsOfSide(slot)) do
            local lista = provider and provider(u.comando, u, slot) or {}
            local obj = main_buttonAnchor(u)
            voluti[obj.getGUID()] = { obj = obj, bottoni = main_baseButtonsOf(obj, u, slot, lista) }
            main_drawDisorders(u)
        end
        -- Generali: stessi bottoni (u.generale = true)
        for _, g in pairs(main_generalsOfSide(slot)) do
            local lista = provider and provider(g.comando, g, slot) or {}
            voluti[g.comando.getGUID()] = { obj = g.comando, bottoni = main_baseButtonsOf(g.comando, g, slot, lista) }
        end
        for _, b in ipairs(main_basesOfSide(slot)) do
            local guid = b.obj.getGUID()
            local v = voluti[guid]
            local firma = v and main_buttonsSignature(v.bottoni) or ""
            if MAIN_BTN_FIRMA[guid] ~= firma then
                if b.obj.clearButtons then b.obj.clearButtons() end
                if v then
                    for _, p in ipairs(v.bottoni) do b.obj.createButton(p) end
                end
                MAIN_BTN_FIRMA[guid] = firma
            end
        end
    end
end
-- ============================================================
-- FUNZIONE: main_buttonsSignature(bottoni)
-- Testo che cambia se cambia qualcosa dei bottoni.
-- ============================================================
function main_buttonsSignature(bottoni)
    local parti = {}
    for _, p in ipairs(bottoni) do
        local c = p.color
        local col = type(c) == "table" and string.format("%.3f,%.3f,%.3f", c.r or c[1] or 0, c.g or c[2] or 0, c.b or c[3] or 0) or tostring(c)
        table.insert(parti, string.format("%s|%s|%.3f|%.3f|%d|%s|%s", p.label, p.click_function,
            p.position.x, p.position.z, p.width, col, p.tooltip or ""))
    end
    return table.concat(parti, ";")
end
-- ============================================================
-- FUNZIONE: main_buttonsForget()
-- Dimentica i bottoni disegnati (partita da capo, ripristino).
-- ============================================================
function main_buttonsForget()
    MAIN_BTN_FIRMA = {}
    MAIN_TINTA = {}
end
-- ============================================================
-- FUNZIONE: main_drawBaseButtons(obj, u, slot, lista)
-- Bottoni in fila dietro la base, leggibili dal proprio lato;
-- il cartellino dei disordini davanti a sinistra.
-- ============================================================
function main_drawBaseButtons(obj, u, slot, lista)
    for _, p in ipairs(main_baseButtonsOf(obj, u, slot, lista)) do obj.createButton(p) end
    main_drawDisorders(u)
    MAIN_BTN_FIRMA[obj.getGUID()] = nil
end
-- ============================================================
-- FUNZIONE: main_baseButtonsOf(obj, u, slot, lista)
-- Parametri di createButton dei bottoni della base.
-- ============================================================
function main_baseButtonsOf(obj, u, slot, lista)
    local B = BASE_BUTTONS
    local meta = u.meta or {}
    local metaProf  = main_cmToTts(meta.profonditaCm or CALIBRAZIONE.baseProfonditaCm)
    local metaFront = main_cmToTts(meta.fronteCm or CALIBRAZIONE.baseFronteCm)

    -- Come IEF (main_drawUnitButtons): RIORDINA, INFO, poi i
    -- bottoni della fase; tutti sulla stessa riga, appena dietro
    -- la base, da sinistra; colore del giocatore. I disordini non
    -- sono un bottone: una base arancione per ogni disordine.
    local tutti = {}
    if not u.generale then
        table.insert(tutti, { label = "RIORDINA", click = "main_riordinaClick",
            tooltip = "Riordina le basi dell'unita' in formazione compatta" })
    end
    table.insert(tutti, { label = "INFO", click = "main_unitInfoOpen",
        tooltip = "Scheda dell'unita' (alt-click chiude)" })
    for _, btn in ipairs(lista) do table.insert(tutti, btn) end
    local out = {}

    local colore = main_sideMainColor(slot)
    -- rotazione 180: la x locale positiva è a sinistra di chi
    -- guarda la base da dietro; si parte dal bordo sinistro
    local cursore = metaFront / 2
    for _, btn in ipairs(tutti) do
        local w = math.max(B.width, #btn.label * B.larghezzaPerLettera)
        local mezza = w / B.unitaPerTts / 2
        table.insert(out, {
            click_function = btn.click,
            function_owner = Global,
            label          = btn.label,
            position       = { x = cursore - mezza, y = B.y, z = -(metaProf / 2 + B.dietro) },
            rotation       = { x = 0, y = 180, z = 0 },
            width          = w, height = B.height, font_size = B.fontSize,
            color          = colore, font_color = B.textColor,
            tooltip        = btn.tooltip or "",
        })
        cursore = cursore - 2 * mezza - B.spazio
    end
    return out
end
-- ============================================================
-- FUNZIONE: main_baseOwnerClick(obj, player_color)
-- Unità e schieramento della base cliccata e se il giocatore
-- appartiene a quello schieramento. Ritorna u, slot, mio.
-- ============================================================
-- ============================================================
-- FUNZIONE: main_buttonAnchor(u)
-- Base che porta i bottoni (Max 11/11/2026): unità su un solo
-- rango → base di comando; su più ranghi → ultimo rango, prima
-- base da sinistra (sinistra dell'unità, guardando il suo fronte).
-- ============================================================
function main_buttonAnchor(u)
    if u.generale or #u.basi < 2 then return u.comando end
    local f = main_baseForward(u.comando)
    local r = { x = f.z, z = -f.x }
    local hd = main_cmToTts(u.meta.profonditaCm or CALIBRAZIONE.baseProfonditaCm) / 2
    local fronte, retro = -math.huge, math.huge
    for _, b in ipairs(u.basi) do
        local p = b.getPosition()
        local v = p.x * f.x + p.z * f.z
        fronte, retro = math.max(fronte, v), math.min(retro, v)
    end
    if fronte - retro < hd then return u.comando end
    local migliore, mw = nil, nil
    for _, b in ipairs(u.basi) do
        local p = b.getPosition()
        if p.x * f.x + p.z * f.z <= retro + hd then
            local w = p.x * r.x + p.z * r.z
            if not mw or w < mw then migliore, mw = b, w end
        end
    end
    return migliore or u.comando
end
-- ============================================================
-- FUNZIONE: main_baseOwnerClick(obj, player_color)
-- ============================================================
function main_baseOwnerClick(obj, player_color)
    local meta = main_baseMeta(obj)
    if not meta or not meta.unitKey then return nil end
    local slot = meta.side
    local u = main_unitOrGeneral(slot, meta.unitKey)
    return u, slot, main_colorInSide(player_color, slot)
end

-- ============================================================
--                         EVENTI TTS
-- Presa e rilascio di oggetti: li smistano alle fasi (mirino
-- del Fuoco, poi carica e movimento).
-- ============================================================
function onObjectPickUp(player_color, obj)
    main_mirinoOnPickUp(player_color, obj)
    if move_onPickUp then move_onPickUp(player_color, obj) end
end

function onObjectDrop(player_color, obj)
    main_mirinoOnDrop(player_color, obj)
    if move_onDrop then move_onDrop(player_color, obj) end
end

-- ============================================================
-- FUNZIONE: main_drawDisorders(u)
-- Disordini sul tavolo (Max 11/11/2026): per ogni disordine una
-- base dell'unità si colora di arancione (regolamento 3.4.1:
-- "girando una base o utilizzando un marker"). Si colorano le
-- basi dall'ultima (numero di base più alto) verso la prima; la
-- base di comando per ultima. Le altre tornano bianche.
-- ============================================================
MAIN_TINTA = MAIN_TINTA or {}   -- [guid] = "dis" | "ok" già applicato

function main_drawDisorders(u)
    if not u or u.generale then return end
    local dis = main_unitDisorders(u.key)
    local basi = {}
    for _, b in ipairs(u.basi) do table.insert(basi, b) end
    table.sort(basi, function(x, y)
        if x == u.comando then return false end
        if y == u.comando then return true end
        return ((main_baseMeta(x) or {}).baseSeq or 0) > ((main_baseMeta(y) or {}).baseSeq or 0)
    end)
    for i, b in ipairs(basi) do
        -- solo se cambia (setColorTint su tutte le basi a ogni
        -- click costava caro)
        local stato = i <= dis and "dis" or "ok"
        local guid = b.getGUID()
        if MAIN_TINTA[guid] ~= stato then
            MAIN_TINTA[guid] = stato
            pcall(function() b.setColorTint(stato == "dis" and BASE_BUTTONS.disTinta or BASE_BUTTONS.normaleTinta) end)
        end
    end
end
