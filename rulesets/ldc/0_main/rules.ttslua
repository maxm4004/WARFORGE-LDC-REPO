-- ============================================================
-- WARFORGE LDC — 0_main/rules.ttslua
-- Dati del regolamento (valori in D). Per ora scritti qui per
-- i codici dei file di prova; quando l'ArmyBuilder-LDC
-- pubblicherà la tabella dei tipi si leggeranno da lì.
-- ============================================================

-- ------------------------------------------------------------
-- Categorie di unità
-- ------------------------------------------------------------
CATEGORIA = {
    FANTERIA    = "FANTERIA",
    SKIRMISH    = "SKIRMISH",
    CAVALLERIA  = "CAVALLERIA",
    ARTIGLIERIA = "ARTIGLIERIA",
    GENERALE    = "GENERALE",
}

-- ------------------------------------------------------------
-- Tipi (codice dell'ArmyBuilder -> dati di gioco)
-- calibro: solo artiglieria (leggera / media / pesante)
-- ------------------------------------------------------------
LDC_TIPI = {
    FAN_LINEA   = { categoria = CATEGORIA.FANTERIA,   nome = "Fanteria di linea" },
    FAN_LEGGERA = { categoria = CATEGORIA.FANTERIA,   nome = "Fanteria leggera" },
    SKIRMISH    = { categoria = CATEGORIA.SKIRMISH,   nome = "Schermagliatori" },
    CAV_LEGGERA = { categoria = CATEGORIA.CAVALLERIA, nome = "Cavalleria leggera" },
    CAV_LANCIERI = { categoria = CATEGORIA.CAVALLERIA, nome = "Lancieri" },
    CAV_DRAGONI = { categoria = CATEGORIA.CAVALLERIA, nome = "Dragoni" },
    CAV_CORAZZIERI = { categoria = CATEGORIA.CAVALLERIA, nome = "Corazzieri" },
    ART_PIEDI   = { categoria = CATEGORIA.ARTIGLIERIA, nome = "Artiglieria a piedi", calibro = "media" },
    ART_CAVALLO = { categoria = CATEGORIA.ARTIGLIERIA, nome = "Artiglieria a cavallo", calibro = "leggera" },
    GEN         = { categoria = CATEGORIA.GENERALE,   nome = "Generale" },
}

-- ------------------------------------------------------------
-- Armi da tiro: gittate in D (regolamento 8, tabella gittate)
-- corta / effettiva / lunga; la lunga solo per i calibri
-- elencati.
-- ------------------------------------------------------------
LDC_ARMI = {
    moschetto = { corta = 1 },
    rigato    = { corta = 1.5 },
    cannone   = { corta = 1, effettiva = 2, lunga = 3, lungaCalibri = { media = true, pesante = true } },
}

-- ------------------------------------------------------------
-- Disordini sopportati prima della rotta (3.4.1: le unità
-- standard rompono oltre tre disordini). Grandi e piccole: il
-- regolamento non lo dice (domanda aperta), per ora 3.
-- ------------------------------------------------------------
LDC_LIMITE_DISORDINI = {
    standard = 3,
    grande   = 3,
    piccola  = 3,
}

-- ------------------------------------------------------------
-- Fuoco: risultato per colpire (regolamento 8)
-- (la QRS dice 5+ per l'artiglieria a distanza corta o
-- effettiva: domanda aperta, qui il regolamento)
-- ------------------------------------------------------------
LDC_FUOCO = {
    fanteria          = 5,   -- fanterie e schermagliatori
    fanteriaVsSkirm   = 6,   -- ... contro schermagliatori
    artiglieriaVicina = 4,   -- corta o effettiva, non contro skirmish o artiglieria schierata
    artiglieriaVsMasse = 4,  -- qualsiasi distanza contro quadrati, colonne, battalion en masse
    altri             = 6,
    -- formazioni "masse" per l'artiglieria
    formazioniMasse   = { quadrato = true, colonna = true, colonna_attacco = true, colonna_marcia = true, battalion_masse = true },
    -- dadi per base del primo rango; artiglieria a distanza corta
    dadiPerBase       = 1,
    dadiArtCorta      = 2,
}

-- ------------------------------------------------------------
-- Velocità in D (regolamento 9.2) per tipo:
--   velocita = movimento normale, carica = in carica,
--   pinnata = pinnata o in HOLDS (cavalleria), dopoTiro =
--   artiglieria a cavallo che ha sparato.
-- Fanteria pinnata: il regolamento non la dà (domanda per
-- l'autore). Terreno rotto, colonna di marcia su strada e
-- artiglieria sganciata (a spinta ½D): nel raffinamento.
-- ------------------------------------------------------------
LDC_VELOCITA = {
    FAN_LINEA      = { velocita = 2, carica = 1 },
    FAN_LEGGERA    = { velocita = 2, carica = 1 },
    SKIRMISH       = { velocita = 2 },
    CAV_LEGGERA    = { velocita = 4, carica = 2, pinnata = 2 },
    CAV_LANCIERI   = { velocita = 4, carica = 2, pinnata = 2 },
    CAV_DRAGONI    = { velocita = 3, carica = 2, pinnata = 2 },
    CAV_CORAZZIERI = { velocita = 3, carica = 2, pinnata = 2 },
    ART_PIEDI      = { velocita = 2, pinnata = 0.5 },
    ART_CAVALLO    = { velocita = 3, pinnata = 0.5, dopoTiro = 2 },
    GEN            = { velocita = 4 },
}

-- Chi può muovere dopo aver sparato (regolamento 8)
LDC_MUOVE_DOPO_TIRO = { SKIRMISH = true, ART_CAVALLO = true }

-- Raggio di comando in D (7.3): oltre, l'unità conta in HOLDS
LDC_COMANDO_RAGGIO = {
    default = 2,
    tipi    = { CAV_LEGGERA = 3, CAV_LANCIERI = 3, SKIRMISH = 3 },
}

-- Carica: arco frontale (gradi per lato) per vedere il bersaglio
LDC_CARICA_ARCO = 45
