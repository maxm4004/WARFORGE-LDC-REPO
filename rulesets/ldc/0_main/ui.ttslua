-- ============================================================
-- WARFORGE LDC — 0_main/ui.ttslua
-- Pannello centrale: turno, fase, schieramenti, bottoni.
-- buildUI() è in engine/ui.ttslua.
-- ============================================================

-- ============================================================
-- FUNZIONE: getRulesetUiXml()
-- ============================================================
function getRulesetUiXml()
    -- colori dello stile in uso nelle tabelle dei pannelli
    main_styleApply()
    local S, M = STILE, STILE_MISURE
    return [[
    <Panel id="panelTop"
           rectAlignment="UpperCenter"
           width="450" height="150"
           ]] .. main_stylePanelAttrs(S.bgTop) .. [[

           offsetXY="0 -70">
        <VerticalLayout spacing="4" padding="12 12 10 10">
            <Text id="textTurno" ]] .. main_styleTextOutline() .. [[ text="" font="]] .. S.font .. [[" fontSize="]] .. M.sezione + 2 .. [["
                  color="]] .. S.sezione .. [[" alignment="MiddleCenter"/>
            <Text id="textFase" ]] .. main_styleTextOutline() .. [[ text="" font="]] .. S.font .. [[" fontSize="]] .. M.titolo + 4 .. [["
                  color="]] .. S.titolo .. [[" alignment="MiddleCenter"/>
            <Text id="textDesc" text="" font="]] .. S.font .. [[" fontSize="]] .. M.piccolo + 1 .. [["
                  color="]] .. S.tenue .. [[" alignment="MiddleCenter"/>
            <HorizontalLayout spacing="6" childAlignment="MiddleCenter" color="rgba(0,0,0,0)">
                <Text id="army1" ]] .. main_styleTextOutline() .. [[ text="Army1" font="]] .. S.font .. [[" fontSize="]] .. M.testo + 1 .. [[" color="]] .. S.tenue .. [[" alignment="MiddleCenter"/>
                <Button id="iconActiveArmy1" icon="left" iconColor="rgba(1,1,1,0)" color="rgba(0,0,0,0)" tooltip="Schieramento attivo" tooltipPosition="Below"/>
                <Button id="iconActiveArmy2" icon="right" iconColor="rgba(1,1,1,0)" color="rgba(0,0,0,0)" tooltip="Schieramento attivo" tooltipPosition="Below"/>
                <Text id="army2" ]] .. main_styleTextOutline() .. [[ text="Army2" font="]] .. S.font .. [[" fontSize="]] .. M.testo + 1 .. [[" color="]] .. S.tenue .. [[" alignment="MiddleCenter"/>
            </HorizontalLayout>
        </VerticalLayout>
    </Panel>

    <Panel id="panelBtnUp"
           rectAlignment="UpperCenter"
           width="450" height="50"
           ]] .. main_stylePanelAttrs() .. [[>
        <VerticalLayout spacing="6" padding="10 10 9 9">
            <HorizontalLayout spacing="30">
                <Button id="BTN_ARMY1" text="" font="]] .. S.font .. [[" fontSize="14"
                        color="Red" textColor="White"
                        onClick="onBtnArmy1"/>
                <Button id="BTN_ARMY2" text="" font="]] .. S.font .. [[" fontSize="14"
                        color="Green" textColor="White"
                        onClick="onBtnArmy2"/>
            </HorizontalLayout>
        </VerticalLayout>
    </Panel>

    <Panel id="panelBtnDown"
           rectAlignment="UpperCenter"
           width="450" height="50"
           ]] .. main_stylePanelAttrs() .. [[

           offsetXY="0 -223"
           active="false">
        <VerticalLayout spacing="6" padding="10 10 9 9">
            <HorizontalLayout childAlignment="MiddleCenter">
                <Button id="BTN_SINGLE" text="" width="380" font="]] .. S.font .. [[" fontSize="14"
                        color="Grey" textColor="White"
                        onClick="onBtnScelta"/>
            </HorizontalLayout>
        </VerticalLayout>
    </Panel>
    ]] .. main_waitPanelsXml() .. command_panelXml() .. fire_confirmPanelXml() .. melee_listPanelXml(1) .. melee_listPanelXml(2) .. move_panelXml() .. move_chargePanelXml() .. move_dragTextXml() .. move_chargeListXml(1) .. move_chargeListXml(2) .. main_unitInfoPanelsXml()
end
-- ============================================================
-- FUNZIONE: main_waitPanelsXml()
-- Barra "In attesa dell'altro giocatore" al posto dei bottoni di fase, una
-- per schieramento, visibile solo ai suoi giocatori.
-- ============================================================
function main_waitPanelsXml()
    local W = WAITPANEL
    local xml = ""
    for slot = 1, 2 do
        xml = xml .. string.format([[
    <Panel id="panelWait%d" rectAlignment="UpperCenter" width="%d" height="%d" color="%s"
           outline="%s" outlineSize="1 -1" offsetXY="0 -223" visibility="%s" active="false">
        <Text id="textWait%d" text="" font="%s" fontSize="%d" color="%s" alignment="MiddleCenter"/>
    </Panel>
        ]], slot, W.width, W.height, W.bg, STILE.bordo, main_sideVisibility(slot), slot, STILE.font, W.fontSize, W.textColor)
    end
    return xml
end
