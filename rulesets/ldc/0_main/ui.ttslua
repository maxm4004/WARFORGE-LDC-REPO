-- ============================================================
-- WARFORGE LDC — 0_main/ui.ttslua
-- Pannello centrale: turno, fase, schieramenti, bottoni.
-- buildUI() è in engine/ui.ttslua.
-- ============================================================

-- ============================================================
-- FUNZIONE: getRulesetUiXml()
-- ============================================================
function getRulesetUiXml()
    return [[
    <Panel id="panelTop"
           rectAlignment="UpperCenter"
           width="450" height="150"
           color="rgba(0,0,0,0.25)"
           offsetXY="0 -70">
        <VerticalLayout spacing="6" padding="10 10 10 10">
            <HorizontalLayout spacing="6" childAlignment="MiddleCenter">
                <Text id="textTurno"
                      text=""
                      fontSize="22" fontStyle="Bold"
                      outline="#000000" outlineSize="2"
                      color="Orange"/>
            </HorizontalLayout>
            <HorizontalLayout spacing="6" childAlignment="MiddleCenter">
                <Text id="textFase"
                      text=""
                      fontSize="18" fontStyle="Bold"
                      outline="#000000" outlineSize="2"
                      color="Yellow"/>
            </HorizontalLayout>
            <Text id="textDesc"
                  text=""
                  fontSize="12"
                  color="rgba(0.8,0.8,0.8,1)"
                  alignment="MiddleCenter"/>
            <HorizontalLayout spacing="6" childAlignment="MiddleCenter" color="rgba(0,0,0,0)">
                <Text id="army1" text="Army1" fontSize="14" fontStyle="Bold" color="Grey" alignment="MiddleCenter"/>
                <Button id="iconActiveArmy1" icon="left" iconColor="rgba(1,1,1,0)" color="rgba(0,0,0,0)" tooltip="Schieramento attivo" tooltipPosition="Below"/>
                <Button id="iconActiveArmy2" icon="right" iconColor="rgba(1,1,1,0)" color="rgba(0,0,0,0)" tooltip="Schieramento attivo" tooltipPosition="Below"/>
                <Text id="army2" text="Army2" fontSize="14" fontStyle="Bold" color="Grey" alignment="MiddleCenter"/>
            </HorizontalLayout>
        </VerticalLayout>
    </Panel>

    <Panel id="panelBtnUp"
           rectAlignment="UpperCenter"
           width="450" height="50"
           color="rgba(0,0,0,0.35)">
        <VerticalLayout spacing="6" padding="10 10 10 10">
            <HorizontalLayout spacing="30">
                <Button id="BTN_ARMY1" text="" fontSize="14" fontStyle="Bold"
                        color="Red" textColor="White"
                        outline="#000000" outlineSize="1"
                        onClick="onBtnArmy1"/>
                <Button id="BTN_ARMY2" text="" fontSize="14" fontStyle="Bold"
                        color="Green" textColor="White"
                        outline="#000000" outlineSize="1"
                        onClick="onBtnArmy2"/>
            </HorizontalLayout>
        </VerticalLayout>
    </Panel>

    <Panel id="panelBtnDown"
           rectAlignment="UpperCenter"
           width="450" height="50"
           color="rgba(0,0,0,0.35)"
           offsetXY="0 -223"
           active="false">
        <VerticalLayout spacing="6" padding="10 10 10 10">
            <HorizontalLayout childAlignment="MiddleCenter">
                <Button id="BTN_SINGLE" text="" width="380" fontSize="14" fontStyle="Bold"
                        color="Grey" textColor="White"
                        outline="#000000" outlineSize="1"
                        onClick="onBtnScelta"/>
            </HorizontalLayout>
        </VerticalLayout>
    </Panel>
    ]] .. main_waitPanelsXml() .. command_panelXml() .. fire_confirmPanelXml()
end
-- ============================================================
-- FUNZIONE: main_waitPanelsXml()
-- Barra "In attesa di ..." al posto dei bottoni di fase, una
-- per schieramento, visibile solo ai suoi giocatori.
-- ============================================================
function main_waitPanelsXml()
    local xml = ""
    for slot = 1, 2 do
        xml = xml .. string.format([[
    <Panel id="panelWait%d"
           rectAlignment="UpperCenter"
           width="450" height="50"
           color="%s"
           offsetXY="0 -223"
           visibility="%s"
           active="false">
        <Text id="textWait%d" text="" fontSize="14" fontStyle="Bold"
              color="%s" alignment="MiddleCenter"/>
    </Panel>
        ]], slot, WAITPANEL.bg, main_sideVisibility(slot), slot, WAITPANEL.textColor)
    end
    return xml
end
