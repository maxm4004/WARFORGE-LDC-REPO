-- Misure del testo, uguali per tutti gli stili
STILE_MISURE = {
    titolo  = 16,     -- titolo del pannello
    sezione = 12,     -- intestazione di sezione
    testo   = 13,     -- righe e valori
    piccolo = 11,     -- note
    bottone = 12,     -- testo dei bottoni
    bordo   = 1,      -- spessore del filo del bordo
}

-- Stile in uso (salvato con la partita)
STILE_NOME = STILE_NOME or "A"
STILE = STILI[STILE_NOME]

-- ============================================================
-- FUNZIONE: main_stylePanelAttrs()
-- Attributi comuni del contenitore di un pannello: sfondo e
-- filo del bordo. Uso: '<Panel ... ' .. main_stylePanelAttrs() .. '>'
-- ============================================================
function main_stylePanelAttrs(bg)
    return string.format('color="%s" outline="%s" outlineSize="%d %d"',
        bg or STILE.bg, STILE.bordo, STILE_MISURE.bordo, -STILE_MISURE.bordo)
end
-- ============================================================
-- FUNZIONE: main_styleTitle(testo)
-- Titolo di un pannello nello stile (A: maiuscolo).
-- ============================================================
function main_styleTitle(testo)
    testo = tostring(testo or "")
    if not STILE.maiuscolo then return testo end
    -- string.upper non tocca le lettere accentate (UTF-8)
    local accenti = { ["à"] = "À", ["è"] = "È", ["é"] = "É", ["ì"] = "Ì", ["ò"] = "Ò", ["ù"] = "Ù",
                      ["â"] = "Â", ["ê"] = "Ê", ["î"] = "Î", ["ô"] = "Ô", ["û"] = "Û", ["ç"] = "Ç",
                      ["ë"] = "Ë", ["ï"] = "Ï", ["ü"] = "Ü", ["ö"] = "Ö", ["ä"] = "Ä" }
    testo = testo:gsub("\195[\128-\191]", function(c) return accenti[c] or c end)
    return (testo:upper())
end
-- ============================================================
-- FUNZIONE: main_styleTextOutline()
-- Contorno del testo dove lo stile lo vuole (A: nero, come il
-- pannello centrale originale); "" altrimenti.
-- ============================================================
function main_styleTextOutline()
    if not STILE.contorno then return "" end
    return string.format('outline="%s" outlineSize="1 -1"', STILE.contorno)
end
-- ============================================================
-- FUNZIONE: main_styleBorder()
-- Solo il filo del bordo (per i pannelli con sfondo già scritto).
-- ============================================================
function main_styleBorder()
    return string.format('outline="%s" outlineSize="%d %d"', STILE.bordo, STILE_MISURE.bordo, -STILE_MISURE.bordo)
end
-- ============================================================
-- FUNZIONE: main_styleApply()
-- Porta i colori dello stile in uso nelle tabelle dei pannelli
-- (lette quando si costruisce l'XML e quando si ridisegna).
-- ============================================================
function main_styleApply()
    local S = STILE
    if COMMAND_PANEL then
        COMMAND_PANEL.font       = S.font
        COMMAND_PANEL.bg         = S.bg
        COMMAND_PANEL.rowBg      = S.riga
        COMMAND_PANEL.actionBg   = S.azione
        COMMAND_PANEL.closeBg    = S.secondario
        COMMAND_PANEL.titleColor = S.titolo
        COMMAND_PANEL.textColor  = S.testo
        COMMAND_PANEL.noteColor  = S.tenue
        COMMAND_PANEL.statoColor = {
            DA_TIRARE = S.tenue, FALLITA = S.ko, ATTIVA = S.ok, HOLDS = S.ko,
        }
    end
    if MOVEPANEL then
        MOVEPANEL.font     = S.font
        MOVEPANEL.bg       = S.bg
        MOVEPANEL.gold     = S.titolo
        MOVEPANEL.grey     = S.tenue
        MOVEPANEL.btnOn    = S.azione
        MOVEPANEL.btnOff   = S.spento
        MOVEPANEL.undo1    = S.secondario
        MOVEPANEL.undo2    = S.secondario
        MOVEPANEL.close    = S.secondario
        MOVEPANEL.manualOn = S.scelto
    end
    if SUBPANEL then
        SUBPANEL.bg       = S.bg
        SUBPANEL.btnColor = S.azione
    end
    if CONFIRMPANEL then
        CONFIRMPANEL.actionBg   = S.azione
        CONFIRMPANEL.actionText = S.azioneTesto
        CONFIRMPANEL.closeBg    = S.secondario
        CONFIRMPANEL.closeText  = S.secondarioTesto
    end
    -- WAITPANEL: resta nello stile originale come il pannello
    -- centrale (Max 12/11)
    if MIRINO_PANNELLO then
        MIRINO_PANNELLO.bg    = S.bg
        MIRINO_PANNELLO.close = S.secondario
    end
    if UNITINFO then
        UNITINFO.font, UNITINFO.bg, UNITINFO.rowBg = S.font, S.bg, S.secondario
        UNITINFO.titleColor, UNITINFO.sectionColor = S.titolo, S.sezione
        UNITINFO.textColor, UNITINFO.subColor = S.testo, S.tenue
        UNITINFO.okColor, UNITINFO.warnColor, UNITINFO.koColor = S.ok, S.avviso, S.ko
        UNITINFO.closeText = S.secondarioTesto
    end
    if LISTPANEL then
        LISTPANEL.font, LISTPANEL.bg, LISTPANEL.rowBg = S.font, S.bg, S.riga
        LISTPANEL.gold, LISTPANEL.grey = S.titolo, S.tenue
        LISTPANEL.todo, LISTPANEL.done = S.testo, S.ok
    end
    if SHOOTINFO then
        SHOOTINFO.bg, SHOOTINFO.gold, SHOOTINFO.grey = S.bg, S.titolo, S.tenue
        SHOOTINFO.bonus, SHOOTINFO.malus = S.ok, S.ko
        SHOOTINFO.font, SHOOTINFO.testo = S.font, S.testo
    end
    if DICEPANEL then
        DICEPANEL.font, DICEPANEL.bg = S.font, S.bg
        DICEPANEL.titleColor, DICEPANEL.textColor, DICEPANEL.subColor = S.titolo, S.testo, S.tenue
        DICEPANEL.okColor, DICEPANEL.koColor = S.ok, S.ko
        DICEPANEL.bordo = main_styleBorder()
    end
    if SUBPANEL then
        SUBPANEL.btnText = S.azioneTesto
        SUBPANEL.font    = S.font
        SUBPANEL.bordo   = main_styleBorder()
    end
end
-- ============================================================
-- FUNZIONE: main_styleSet(nome, player)
-- Cambia stile in partita (!stile A): tabelle, UI rifatta e
-- pannelli ridisegnati appena la UI è pronta.
-- ============================================================
function main_styleSet(nome, player)
    nome = string.upper(tostring(nome or ""))
    if not STILI[nome] then
        local msg = "Stili disponibili: A (Come IEF), B (Stato maggiore), C (Moderno), D (Classico)"
        if player then warningToColor(msg, player, "Yellow", 5, true) else printToAll(msg, LOG_AVVISO) end
        return
    end
    STILE_NOME = nome
    STILE = STILI[nome]
    main_styleApply()
    callHandler("buildUI")
    engine_uiWhenReady(function()
        Wait.frames(function()
            if main_redrawAllPanels then main_redrawAllPanels() end
        end, 2)
    end)
    printToAll("Stile dei pannelli: " .. nome .. " - " .. STILE.nome, LOG_COLORE)
end
-- ============================================================
-- FUNZIONE: main_redrawAllPanels()
-- Dopo una UI rifatta (cambio di stile): ogni pannello aperto
-- torna com'era.
-- ============================================================
function main_redrawAllPanels()
    local function prova(fn)
        if type(fn) == "function" then
            local ok, err = pcall(fn)
            if not ok then printToAll("[stile] " .. tostring(err), LOG_AVVISO) end
        end
    end
    prova(function() callHandler("updateCenterPanel") end)
    prova(command_redrawPanel)
    if MOVE_PANEL then prova(move_panelRedraw) end
    prova(move_chargeListRefresh)
    prova(melee_listRefresh)
    prova(main_unitInfoRefresh)
    prova(engine_subRedraw)
    prova(engine_dicePanelRedraw)
end
