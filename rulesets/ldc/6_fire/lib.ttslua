-- ============================================================
-- WARFORGE LDC — 6_fire/lib.ttslua
-- Fuoco (regolamento 8), flusso copiato da IEF 7_shoot:
--
--   1. FUOCO sulla base dell'unità: mirino davanti al fronte
--      (0_main/mirino, copia del mirino di IEF F38-F40).
--   2. Mirino rilasciato su un bersaglio valido: cono di tiro
--      disegnato, basi che tirano (arancio) e basi raggiunte
--      (azzurro) evidenziate, scheda del tiro (TIRATORE /
--      BERSAGLIO, DADI / PER COLPIRE) e conferma Tiro / Chiudi
--      al giocatore che tira. La camera NON si muove.
--   3. Tiro: sottofase FIRE_ROLL (come IEF SHOOT_ROLL), camera
--      sui dadi, "Premi Roll". Il pannello diventa visibile a
--      tutti.
--   4. Roll: facce ed esito nella scheda; gli hit diventano
--      disordini; fumo davanti alle basi che hanno sparato.
--   5. Se gli hit manderebbero in rotta il bersaglio: step
--      ROTTURA, Roll dei dadi in eccesso, serve più del morale
--      del bersaglio (regolamento 8).
--   6. ESCI: esito per MORALE_ESITO_SECONDS, poi la sottofase si
--      chiude da sola e la camera torna.
--
-- Regole di LDC: gittate in D (moschetto 1D, rigato 1D½,
-- cannone 1D/2D/3D), dadi = basi del primo rango (2 per base
-- per l'artiglieria a distanza corta), soglie 5+/6+/4+, la
-- fanteria tira al bersaglio più vicino nel cono, l'artiglieria
-- sceglie. Le unità in HOLDS possono sparare.
-- Rimandati: coperture e capisaldi, linea di vista (terreno),
-- abitati, rigato, quadrato, tiro attraverso gli skirmish (8.1),
-- bombardamento del Generale, artiglieria a cavallo.
-- ============================================================

-- ============================================================
--                        CHI PUÒ SPARARE
-- ============================================================

-- ============================================================
-- FUNZIONE: fire_weapon(u)
-- Arma da tiro dell'unità (LDC_ARMI), nil se non spara.
-- ============================================================
function fire_weapon(u)
    local cat = main_unitCategory(u.meta)
    if cat ~= CATEGORIA.FANTERIA and cat ~= CATEGORIA.SKIRMISH and cat ~= CATEGORIA.ARTIGLIERIA then
        return nil
    end
    return u.meta.arma and LDC_ARMI[u.meta.arma] or nil
end
-- ============================================================
-- FUNZIONE: fire_maxRangeD(u)
-- Gittata massima dell'unità in D.
-- ============================================================
function fire_maxRangeD(u)
    local arma = fire_weapon(u)
    if not arma then return 0 end
    local calibro = main_unitType(u.meta).calibro
    if arma.lunga and (not arma.lungaCalibri or arma.lungaCalibri[calibro or ""]) then
        return arma.lunga
    end
    return arma.effettiva or arma.corta or 0
end

-- ============================================================
--                 CONO DI TIRO (copiato da IEF)
-- ============================================================

-- ============================================================
-- FUNZIONE: fire_rectIEF(obj)
-- Rettangolo della base nel formato di IEF main_baseRectOfType:
-- { x, z, fx, fz, rx, rz, hw, hd, corners }.
-- ============================================================
function fire_rectIEF(obj)
    local meta = main_baseMeta(obj) or {}
    local hw = main_cmToTts(meta.fronteCm or CALIBRAZIONE.baseFronteCm) / 2
    local hd = main_cmToTts(meta.profonditaCm or CALIBRAZIONE.baseProfonditaCm) / 2
    local p = obj.getPosition()
    local f = main_baseForward(obj)
    local r = { x = f.z, z = -f.x }          -- destra della base
    local rect = { x = p.x, z = p.z, fx = f.x, fz = f.z, rx = r.x, rz = r.z, hw = hw, hd = hd, obj = obj, corners = {} }
    for _, sw in ipairs({ -1, 1 }) do
        for _, sd in ipairs({ -1, 1 }) do
            table.insert(rect.corners, {
                x = p.x + r.x * hw * sw + f.x * hd * sd,
                z = p.z + r.z * hw * sw + f.z * hd * sd,
            })
        end
    end
    return rect
end
-- ============================================================
-- FUNZIONE: shoot_coneOf(rects, angoloGradi)  (IEF, invariata)
-- Cono di tiro dell'unità: parte dalla linea del fronte, fra gli
-- angoli esterni sinistro e destro, e si allarga di angoloGradi
-- per lato.
-- ============================================================
function shoot_coneOf(rects, angoloGradi)
    local r0 = rects[1]
    local c = { fx = r0.fx, fz = r0.fz, rx = r0.rx, rz = r0.rz,
                s0 = -math.huge, tL = math.huge, tR = -math.huge,
                tan = math.tan(math.rad(math.min(angoloGradi or 45, 89))),
                tutto = (angoloGradi or 45) >= 180 }
    for _, r in ipairs(rects) do
        for _, k in ipairs(r.corners) do
            local s = k.x * c.fx + k.z * c.fz
            local t = k.x * c.rx + k.z * c.rz
            if s > c.s0 then c.s0 = s end
            if t < c.tL then c.tL = t end
            if t > c.tR then c.tR = t end
        end
    end
    return c
end
-- ============================================================
-- FUNZIONE: shoot_pointInCone(c, x, z)  (IEF, invariata)
-- ============================================================
function shoot_pointInCone(c, x, z)
    if c.tutto then return true end
    local s = x * c.fx + z * c.fz - c.s0
    if s < -0.001 then return false end
    if s < 0 then s = 0 end
    local t = x * c.rx + z * c.rz
    return t >= c.tL - s * c.tan and t <= c.tR + s * c.tan
end
-- ============================================================
-- FUNZIONE: shoot_rectInCone(c, rect)  (IEF, invariata)
-- Vero se almeno un angolo (o il centro) della base è nel cono.
-- ============================================================
function shoot_rectInCone(c, rect)
    if shoot_pointInCone(c, rect.x, rect.z) then return true end
    for _, k in ipairs(rect.corners) do
        if shoot_pointInCone(c, k.x, k.z) then return true end
    end
    return false
end
-- ============================================================
-- FUNZIONE: fire_cone(u)
-- Cono di tiro dell'unità dalle basi del primo rango.
-- ============================================================
function fire_cone(u)
    local rects = {}
    for _, b in ipairs(main_unitFirstRank(u)) do table.insert(rects, fire_rectIEF(b)) end
    return shoot_coneOf(rects, FIRE_ARCO), rects
end
-- ============================================================
-- FUNZIONE: fire_unitInCone(cono, t)
-- ============================================================
function fire_unitInCone(cono, t)
    for _, b in ipairs(t.basi) do
        if shoot_rectInCone(cono, fire_rectIEF(b)) then return true end
    end
    return false
end
-- ============================================================
-- FUNZIONE: fire_coneLines(cono, rangeUnits)
-- Linee del cono (lati e limite di gittata) come IEF
-- shoot_range_and_target: lati a FIRE_ARCO, archi attorno agli
-- angoli esterni e segmento davanti al fronte.
-- ============================================================
function fire_coneLines(cono, rangeUnits, y)
    local function punto(sv, tv)
        local x, z = cono.fx * sv + cono.rx * tv, cono.fz * sv + cono.rz * tv
        return { x, y, z }
    end
    local angolo = math.rad(math.min(FIRE_ARCO, 89))
    local segmenti = 30
    local cosA, sinA = math.cos(angolo), math.sin(angolo)
    local sx, dx, arco = {}, {}, {}
    for i = 0, segmenti do
        local k = (i / segmenti) * rangeUnits
        table.insert(sx, punto(cono.s0 + k * cosA, cono.tL - k * sinA))
        table.insert(dx, punto(cono.s0 + k * cosA, cono.tR + k * sinA))
    end
    local meta = math.floor(segmenti / 2)
    for i = 0, meta do
        local ang = -angolo + angolo * (i / meta)
        table.insert(arco, punto(cono.s0 + rangeUnits * math.cos(ang), cono.tL + rangeUnits * math.sin(ang)))
    end
    for i = 0, meta do
        local ang = angolo * (i / meta)
        table.insert(arco, punto(cono.s0 + rangeUnits * math.cos(ang), cono.tR + rangeUnits * math.sin(ang)))
    end
    local col = FIRE_COLORI.cono
    local linee = {}
    -- riempimento: righe parallele al fronte, da un lato all'altro
    -- del cono, fino al limite di gittata (archi compresi)
    local F = FIRE_CONO_RIEMPI
    if F and F.attivo and F.passo > 0 then
        local d = F.passo / 2
        while d < rangeUnits do
            local apertura
            if d <= rangeUnits * cosA then
                apertura = d * sinA / cosA
            else
                apertura = math.sqrt(math.max(rangeUnits * rangeUnits - d * d, 0))
            end
            table.insert(linee, {
                points = { punto(cono.s0 + d, cono.tL - apertura), punto(cono.s0 + d, cono.tR + apertura) },
                color = F.colore, thickness = F.spessore,
            })
            d = d + F.passo
        end
    end
    table.insert(linee, { points = sx,   color = col, thickness = 0.1 })
    table.insert(linee, { points = dx,   color = col, thickness = 0.1 })
    table.insert(linee, { points = arco, color = col, thickness = 0.1 })
    return linee
end

-- ============================================================
--                         BERSAGLI
-- ============================================================

-- ============================================================
-- FUNZIONE: fire_targets(slot, u)
-- Unità nemiche a portata e nel cono: { [unitKey] = { dist } }.
-- La fanteria solo la più vicina (8).
-- ============================================================
function fire_targets(slot, u)
    local max = fire_maxRangeD(u)
    local cat = main_unitCategory(u.meta)
    local cono = fire_cone(u)
    local lista, minDist = {}, math.huge

    for key, t in pairs(main_unitsOfSide(main_otherSide(slot))) do
        local d = main_unitDistanceD(u, t)
        if d and d <= max and fire_unitInCone(cono, t) then
            lista[key] = { dist = d }
            minDist = math.min(minDist, d)
        end
    end

    if cat == CATEGORIA.FANTERIA or cat == CATEGORIA.SKIRMISH then
        for key, info in pairs(lista) do
            if info.dist > minDist + FIRE_TOLLERANZA_VICINO_D then lista[key] = nil end
        end
    end
    return lista
end

-- ============================================================
--                       CALCOLO DEL TIRO
-- ============================================================

-- ============================================================
-- FUNZIONE: fire_compute(u, t, dist)
-- Dadi e soglia del tiro di u contro t a distanza dist (D), con
-- le voci della scheda come IEF (shoot_numDiceBreakdown /
-- shoot_hitBreakdown). Ritorna { dadi, soglia, banda,
-- primoRango, vociDadi, vociColpire, sogliaTesto }.
-- ============================================================
function fire_compute(u, t, dist)
    local F = LDC_FUOCO
    local arma = fire_weapon(u) or {}
    local catU = main_unitCategory(u.meta)
    local catT = main_unitCategory(t.meta)

    local banda = "lunga"
    if dist <= (arma.corta or 0) then
        banda = "corta"
    elseif arma.effettiva and dist <= arma.effettiva then
        banda = "effettiva"
    end

    local primo = #main_unitFirstRank(u)
    local perBase = F.dadiPerBase
    if catU == CATEGORIA.ARTIGLIERIA and banda == "corta" then perBase = F.dadiArtCorta end
    local dadi = primo * perBase

    local vociDadi = {
        { "Basi in primo rango", tostring(primo) },
        { "Dadi per base", tostring(perBase) .. ((perBase > 1) and " (artiglieria corta)" or "") },
    }

    local soglia, motivo
    if catU == CATEGORIA.ARTIGLIERIA then
        if F.formazioniMasse[main_unitFormation(t) or ""] then
            soglia, motivo = F.artiglieriaVsMasse, "contro " .. tostring(main_unitFormation(t))
        elseif banda ~= "lunga" and catT ~= CATEGORIA.SKIRMISH and catT ~= CATEGORIA.ARTIGLIERIA then
            soglia, motivo = F.artiglieriaVicina, "artiglieria a distanza " .. banda
        else
            soglia, motivo = F.altri, (banda == "lunga") and "distanza lunga" or ("contro " .. tostring(catT):lower())
        end
    else
        if catT == CATEGORIA.SKIRMISH then
            soglia, motivo = F.fanteriaVsSkirm, "contro schermagliatori"
        else
            soglia, motivo = F.fanteria, "fanteria"
        end
    end
    local vociColpire = { { motivo, soglia .. "+" } }

    return {
        dadi = dadi, soglia = soglia, banda = banda, primoRango = primo,
        vociDadi = vociDadi, vociColpire = vociColpire,
        sogliaTesto = string.format("serve %d+", soglia),
    }
end

-- ============================================================
--                  SCHEDA DEL TIRO (stile IEF)
-- ============================================================

-- ============================================================
-- FUNZIONE: fire_infoShow(player, d)
-- Contenuto della scheda come IEF shoot_infoShow, con i dati di
-- LDC. d = { u, t, dist, c, raggiunte }.
-- ============================================================
function fire_infoShow(player, d)
    local S = SHOOTINFO
    local function set(id, testo, colore)
        engine_uiSet(id, "text", testo or "")
        if colore then engine_uiSet(id, "color", colore) end
        engine_uiSet(id, "active", (testo and testo ~= "") and "true" or "false")
    end
    local u, t, c = d.u, d.t, d.c
    local nomeU = u.meta.nomeDisplay or u.key
    local nomeT = t.meta.nomeDisplay or t.key
    local tipoU = main_unitType(u.meta).nome or tostring(u.meta.tipo)
    local tipoT = main_unitType(t.meta).nome or tostring(t.meta.tipo)
    local arma  = tostring(u.meta.arma or "?")

    set("shootinfo_title", string.format("%s con %s tira su %s", nomeU, arma, nomeT))
    local cat = main_unitCategory(u.meta)
    set("shootinfo_note", (cat == CATEGORIA.ARTIGLIERIA) and "L'artiglieria sceglie il bersaglio nel cono di tiro"
        or "Bersaglio obbligato: il piu' vicino nel cono di tiro")

    -- Colonna TIRATORE
    local L = {
        { "TIRATORE", S.gold },
        { tipoU },
        { string.format("Arma: %s  -  gittata %s", arma, main_formatD(fire_maxRangeD(u))) },
        { string.format("Distanza: %s (%s)", main_formatD(d.dist), c.banda) },
        { string.format("Basi in primo rango: %d/%d", c.primoRango, #u.basi) },
        { "Morale: " .. tostring(u.meta.morale or "?") },
    }
    if command_unitInHolds(u.meta.side or TURN.activeSide, u.meta) then
        table.insert(L, { "In HOLDS: puo' sparare", S.grey })
    end

    -- Colonna BERSAGLIO
    local dis = main_unitDisorders(t.key)
    local lim = main_unitDisorderLimit(t.meta)
    local R = {
        { "BERSAGLIO", S.gold },
        { tipoT },
        { "Formazione: " .. tostring(main_unitFormation(t) or "?") },
        { "Morale: " .. tostring(t.meta.morale or "?") },
        { string.format("Disordini: %d/%d", dis, lim), (dis > 0) and S.malus or nil },
        { string.format("Basi in campo: %d", #t.basi) },
        { string.format("Basi raggiunte: %d", d.raggiunte or 0) },
    }
    for i = 1, S.colRows do
        local l, r = L[i], R[i]
        set("shootinfo_L" .. i, l and l[1] or "", l and (l[2] or "White") or nil)
        set("shootinfo_R" .. i, r and r[1] or "", r and (r[2] or "White") or nil)
    end
    local righeCol = math.max(math.min(#L, S.colRows), math.min(#R, S.colRows))

    -- Parte bassa: DADI (D) e PER COLPIRE (C)
    local D = { { "DADI", "", S.gold } }
    for _, v in ipairs(c.vociDadi) do table.insert(D, { v[1], v[2] }) end
    table.insert(D, { "Totale dadi", c.dadi .. "D6" })
    local B = { { "PER COLPIRE", "", S.gold } }
    for _, v in ipairs(c.vociColpire) do table.insert(B, { v[1], v[2] }) end
    table.insert(B, { "Hit = disordini", "", S.grey })
    if dis + 1 > lim then
        table.insert(B, { "Ogni hit ora manda in rotta:", "", S.malus })
        table.insert(B, { "ritiro, serve piu' di", tostring(t.meta.morale or 3), S.malus })
    end

    local function scriviColonna(lato, lista)
        for i = 1, S.rows do
            local b = lista[i]
            local id = "shootinfo_" .. lato .. i
            if b then
                engine_uiSet(id, "active", "true")
                engine_uiSet(id .. "_l", "text", b[1])
                engine_uiSet(id .. "_l", "color", (b[3] and b[2] == "") and b[3] or "White")
                engine_uiSet(id .. "_v", "text", b[2] or "")
                engine_uiSet(id .. "_v", "color", b[3] or "White")
            else
                engine_uiSet(id, "active", "false")
            end
        end
    end
    scriviColonna("D", D)
    scriviColonna("C", B)
    local righeB = math.max(math.min(#D, S.rows), math.min(#B, S.rows))

    engine_uiSet("shootinfo_stato", "active", "false")
    engine_uiSet("shootinfo_faces", "active", "false")
    engine_uiSet("shootinfo_esito", "active", "false")

    S.hBase = 2 * S.padding + S.titleH + S.noteH + righeCol * S.rowH + righeB * S.rowH + 2 * 5 + 8
    engine_uiSet("shoot_info_panel", "height", tostring(S.hBase))
    engine_uiSet("shoot_info_panel", "visibility", player.color)
    engine_uiSet("shoot_info_panel", "active", "true")
end
-- ============================================================
-- FUNZIONE: fire_confirmPanelXml()
-- Tiro / Chiudi sotto la scheda (come IEF confirm_panel_shoot).
-- ============================================================
function fire_confirmPanelXml()
    return [[
        <Panel id="confirm_panel_shoot"
        rectAlignment="LowerCenter"
        width="440" height="50"
        color="rgba(0,0,0,0.00)"
        offsetXY="0 100"
        active="false">
        <HorizontalLayout spacing="8" padding="10 10 10 10" childAlignment="MiddleCenter" childForceExpandWidth="false" position="0 -100 0">
            <Button id="btnShootVeloce" text="]] .. DADI_ETICHETTE.veloce .. [[" font="]] .. STILE.font .. [[" fontSize="13" color="]] .. CONFIRMPANEL.actionBg .. [[" textColor="]] .. CONFIRMPANEL.actionText .. [[" preferredWidth="130" preferredHeight="34" onClick="fire_Confirm" tooltip="La camera resta qui, i dadi partono subito" tooltipPosition="Above"/>
            <Button id="btnShoot" text="]] .. DADI_ETICHETTE.vassoio .. [[" font="]] .. STILE.font .. [[" fontSize="13" color="]] .. CONFIRMPANEL.actionBg .. [[" textColor="]] .. CONFIRMPANEL.actionText .. [[" preferredWidth="130" preferredHeight="34" onClick="fire_Confirm" tooltip="Camera sul vassoio, poi Roll" tooltipPosition="Above"/>
            <Button id="btnShootCancel" text="Chiudi" font="]] .. STILE.font .. [[" fontSize="13" color="]] .. CONFIRMPANEL.closeBg .. [[" textColor="]] .. CONFIRMPANEL.closeText .. [[" preferredWidth="130" preferredHeight="34" onClick="fire_Chiudi"/>
        </HorizontalLayout>
        </Panel>
    ]] .. shoot_infoPanelXml()
end

-- ============================================================
--                         BOTTONI
-- ============================================================

-- ============================================================
-- FUNZIONE: fire_baseButtons(obj, u, slot)
-- Bottoni della fase sulla base di comando (0_main/buttons).
-- ============================================================
function fire_baseButtons(obj, u, slot)
    local B = BASE_BUTTONS
    if slot ~= TURN.activeSide then return {} end
    if (FIRE_SEL and FIRE_SEL.tiratore == u.key) or (FIRE_PREP and FIRE_PREP.u.key == u.key) then
        return { { label = "ANNULLA", click = "fire_clickAnnulla", color = B.annullaColor,
                   tooltip = "Annulla il tiro" } }
    end
    if FIRE_STATE.sparato[u.key] then
        return {}   -- il fumo davanti alle basi segna chi ha sparato
    end
    if fire_weapon(u) and not FIRE_SEL and not FIRE_PREP and not fire_rollRec(slot) then
        return { { label = "FUOCO", click = "fire_clickFuoco",
                   tooltip = string.format("Spara (gittata %s)", main_formatD(fire_maxRangeD(u))) } }
    end
    return {}
end
-- ============================================================
-- FUNZIONE: fire_clickOk(player_color)
-- ============================================================
function fire_clickOk(player_color)
    if not ENGINE or ENGINE.phase ~= PHASE.FIRE or ENGINE.transitionPending then return false end
    if not main_colorInSide(player_color, TURN.activeSide) then
        warningToColor("Non e' il tuo Fuoco", Player[player_color], "Yellow", 3, false)
        return false
    end
    if fire_rollRec(TURN.activeSide) then
        warningToColor("Completa prima il tiro in corso", Player[player_color], "Yellow", 4, false)
        return false
    end
    return true
end
-- ============================================================
-- FUNZIONE: fire_clickFuoco(obj, player_color, alt_click)
-- FUOCO: mirino davanti all'unità.
-- ============================================================
function fire_clickFuoco(obj, player_color, alt_click)
    if not fire_clickOk(player_color) then return end
    local u, slot, mio = main_baseOwnerClick(obj, player_color)
    if not u or not mio or slot ~= TURN.activeSide then return end
    if FIRE_STATE.sparato[u.key] then
        warningToColor("Questa unita' ha gia' sparato in questo turno", Player[player_color], "Yellow", 5, true)
        return
    end
    fire_Reset()
    fire_mirinoStart(Player[player_color], slot, u)
    main_refreshBaseButtons()
end
-- ============================================================
-- FUNZIONE: fire_clickAnnulla(obj, player_color, alt_click)
-- ============================================================
function fire_clickAnnulla(obj, player_color, alt_click)
    if not fire_clickOk(player_color) then return end
    fire_Chiudi(Player[player_color])
end

-- ============================================================
--                 MIRINO (0_main/mirino, come IEF)
-- ============================================================

-- ============================================================
-- FUNZIONE: fire_mirinoValuta(sel, t)
-- Esito ("ok"|"arancio"|"rosso") e testo per il mirino.
-- ============================================================
function fire_mirinoValuta(sel, t)
    local u = main_unitsOfSide(sel.slot)[sel.tiratore]
    local d = u and main_unitDistanceD(u, t) or 0
    local function esci(esito, causa)
        return esito, main_formatD(d) .. (causa and (" - Bersaglio non valido: " .. causa) or " - Bersaglio valido")
    end
    if sel.bersagli[t.key] then return esci("ok", nil) end
    if not u or d > fire_maxRangeD(u) then return esci("rosso", "fuori gittata") end
    if not fire_unitInCone(fire_cone(u), t) then return esci("arancio", "fuori dal cono di tiro") end
    return esci("arancio", "c'e' un bersaglio piu' vicino")
end
-- ============================================================
-- FUNZIONE: fire_mirinoStart(player, slot, u)
-- ============================================================
function fire_mirinoStart(player, slot, u)
    local sel = { slot = slot, tiratore = u.key, bersagli = fire_targets(slot, u), player = player }
    FIRE_SEL = sel
    main_mirinoStart(player, slot, u, {
        linee    = "fuoco",
        valuta   = function(t) return fire_mirinoValuta(sel, t) end,
        onValido = function(t)
            if FIRE_SEL ~= sel then return end
            FIRE_SEL = nil
            fire_prepare(player, sel, t)
        end,
        onChiudi = function(p)
            if fire_clickOk(p.color) then fire_Chiudi(p) end
        end,
    })
end
-- ============================================================
-- FUNZIONE: fire_mirinoStop()
-- ============================================================
function fire_mirinoStop()
    FIRE_SEL = nil
    main_mirinoStop()
end

-- ============================================================
--            PREPARAZIONE, CONFERMA E ANNULLO (IEF)
-- ============================================================

-- ============================================================
-- FUNZIONE: fire_prepare(player, sel, t)
-- Bersaglio valido (come IEF shoot_range_and_target): cono,
-- evidenziazioni, scheda e Tiro / Chiudi. Camera ferma.
-- ============================================================
function fire_prepare(player, sel, t)
    local u = main_unitsOfSide(sel.slot)[sel.tiratore]
    if not u then return end
    local dist = sel.bersagli[t.key].dist
    local c = fire_compute(u, t, dist)

    local cono = fire_cone(u)
    local raggiunte = 0
    for _, b in ipairs(t.basi) do
        if shoot_rectInCone(cono, fire_rectIEF(b)) then
            b.highlightOn(FIRE_COLORI.raggiunte)
            raggiunte = raggiunte + 1
        end
    end
    local primo = main_unitFirstRank(u)
    for _, b in ipairs(primo) do b.highlightOn(FIRE_COLORI.pronte) end

    local y = u.comando.getPosition().y + 0.06
    main_setLines("fuoco", fire_coneLines(cono, main_inchToTts(fire_maxRangeD(u) * POLLICI_PER_D), y))

    FIRE_PREP = { slot = sel.slot, u = u, t = t, dist = dist, c = c, player = player, primo = primo }
    fire_infoShow(player, { u = u, t = t, dist = dist, c = c, raggiunte = raggiunte })
    engine_uiSet("confirm_panel_shoot", "active", "true")
    engine_uiSet("confirm_panel_shoot", "visibility", player.color)
    main_refreshBaseButtons()
end
-- ============================================================
-- FUNZIONE: fire_ResetLines(tieniInfo)
-- Toglie cono, evidenziazioni e conferma (come IEF
-- shoot_ResetLines); con tieniInfo la scheda resta (diventa il
-- pannello del tiro).
-- ============================================================
function fire_ResetLines(tieniInfo)
    fire_mirinoStop()
    main_setLines("fuoco", {})
    if not tieniInfo then shoot_infoHide() end
    local p = FIRE_PREP
    if p then
        for _, b in ipairs(p.t.basi or {}) do if not b.isDestroyed() then b.highlightOff() end end
        for _, b in ipairs(p.primo or {}) do if not b.isDestroyed() then b.highlightOff() end end
    end
    engine_uiSet("confirm_panel_shoot", "active", "false")
end
-- ============================================================
-- FUNZIONE: fire_Reset()
-- ============================================================
function fire_Reset()
    fire_ResetLines(false)
    FIRE_PREP = nil
end
-- ============================================================
-- FUNZIONE: fire_Chiudi(player, value, id)
-- Chiudi della conferma (e ANNULLA sulla base): niente tiro.
-- ============================================================
function fire_Chiudi(player, value, id)
    if player and not main_colorInSide(player.color, TURN.activeSide) then return end
    if fire_rollRec(TURN.activeSide) then return end
    fire_Reset()
    main_refreshBaseButtons()
end
-- ============================================================
-- FUNZIONE: fire_Confirm(player, value, id)
-- Tiro (come IEF shoot_Confirm): apre la sottofase FIRE_ROLL,
-- camera sui dadi, "Premi Roll".
-- ============================================================
function fire_Confirm(player, value, id)
    local p = FIRE_PREP
    if not p or not player or not main_colorInSide(player.color, p.slot) then return end
    -- Tiro veloce (camera ferma, dadi subito) o Tiro classico
    local veloce = id == "btnShootVeloce"
    engine_diceSetModo(player, veloce)
    if fire_rollRec(p.slot) then
        warningToColor("Completa prima il tiro in corso", player, "Yellow", 5, true)
        return
    end

    local ctx = {
        shooterKey   = p.u.key,
        targetKey    = p.t.key,
        targetSlot   = main_otherSide(p.slot),
        shooterLabel = p.u.meta.nomeDisplay or p.u.key,
        targetLabel  = p.t.meta.nomeDisplay or p.t.key,
        dadi         = p.c.dadi,
        soglia       = p.c.soglia,
        sogliaTesto  = p.c.sogliaTesto,
        morale       = p.t.meta.morale or 3,
        arma         = p.u.meta.arma,
    }
    fire_ResetLines(true)
    FIRE_PREP = nil

    if not engine_subOpen("FIRE_ROLL", p.slot, ctx, nil) then
        shoot_infoHide()
        return
    end
    if ctx.dadi <= 0 then
        ctx.motivo = "Nessuna base in primo rango"
        shoot_infoStato(ctx.motivo, SHOOTINFO.malus)
        engine_subStep("FIRE_ROLL", p.slot, "ESCI")
        return
    end
    engine_diceCameraZoom(player)
    if veloce then
        engine_diceTiroVeloce(player)
    else
        shoot_infoStato(string.format("Premi Roll: tira %dD6 (%s)", ctx.dadi, ctx.sogliaTesto), SHOOTINFO.gold)
    end
    main_refreshBaseButtons()
end

-- ============================================================
--                 SOTTOFASE FIRE_ROLL (come IEF)
-- ============================================================

-- ============================================================
-- FUNZIONE: fire_rollRec(slot)
-- FIRE_ROLL aperta per lo slot o nil.
-- ============================================================
function fire_rollRec(slot)
    local rec = slot and engine_subPrivate(slot)
    if rec and rec.name == "FIRE_ROLL" then return rec end
    return nil
end
-- ============================================================
-- FUNZIONE: fire_rollFocus(ctx, slot, player, rec)
-- Bottone della sottofase: camera sui dadi.
-- ============================================================
function fire_rollFocus(ctx, slot, player, rec)
    if player then engine_diceCameraZoom(player) end
end
-- ============================================================
-- FUNZIONE: fire_rollDo(ctx, slot, player, rec)
-- Roll nello step TIRO: hit in disordini, fumo, eventuale
-- rottura.
-- ============================================================
function fire_rollDo(ctx, slot, player, rec)
    if ctx.inVolo then return end
    ctx.inVolo = true
    printToAll(string.format("[FUOCO] %s tira %dD6 su %s: %s",
        ctx.shooterLabel, ctx.dadi, ctx.targetLabel, ctx.sogliaTesto), LOG_COLORE)
    shoot_infoStato("Tiro in corso...", SHOOTINFO.gold)
    engine_diceClearLastRoll(slot)
    engine_diceSetNext(slot, ctx.dadi, ctx.soglia)
    -- fumo e suono al momento dello sparo, non dopo la lettura dei
    -- dadi (Max 13/11: il suono partiva molto dopo)
    if not ctx.fumo then
        ctx.fumo = true
        fire_spawnSmoke(ctx.shooterKey)
    end

    engine_diceThrowFromBag(slot, nil, function(risultati, successi)
        ctx.inVolo = false
        if fire_rollRec(slot) ~= rec or rec.step ~= "TIRO" then return end

        FIRE_STATE.sparato[ctx.shooterKey] = true

        local colpi = successi or 0
        ctx.colpi = colpi
        shoot_infoRisultati(risultati, ctx.soglia, colpi)

        local t = main_unit(ctx.targetKey)
        if not t then
            engine_subStep("FIRE_ROLL", slot, "ESCI")
            return
        end
        local limite = main_unitDisorderLimit(t.meta)
        local aggiunti = main_unitAddDisorders(t.key, colpi, limite)
        local eccesso = colpi - aggiunti
        printToAll(string.format("[FUOCO] %d hit: %s a %d/%d disordini", colpi, ctx.targetLabel,
            main_unitDisorders(t.key), limite), LOG_COLORE)
        main_refreshBaseButtons()

        if eccesso > 0 then
            ctx.rottura = eccesso
            engine_subStep("FIRE_ROLL", slot, "ROTTURA")
            local auto = engine_diceVeloce(player)
            engine_uiSet("shootinfo_stato", "text", string.format(auto and "ROTTURA: tiro automatico, %dD6, serve piu' di %d" or "ROTTURA: premi Roll, %dD6, serve piu' di %d", eccesso, ctx.morale))
            -- tiro veloce: anche la rottura parte da sola
            if auto then Wait.time(function() if fire_rollRec(slot) == rec and rec.step == "ROTTURA" then engine_diceRoll_start(player) end end, 1.5) end
            engine_uiSet("shootinfo_stato", "color", SHOOTINFO.malus)
            engine_uiSet("shootinfo_stato", "active", "true")
            shoot_infoAltezza(true, true, true)
            printToAll(string.format("[FUOCO] %d hit possono mandare in rotta %s: ritiro, serve piu' di %d",
                eccesso, ctx.targetLabel, ctx.morale), LOG_COLORE)
            return
        end
        Wait.time(function() engine_diceCameraReturn(player, 0) end, 2)
        engine_subStep("FIRE_ROLL", slot, "ESCI")
    end, player.color)
end
-- ============================================================
-- FUNZIONE: fire_rotturaDo(ctx, slot, player, rec)
-- Roll nello step ROTTURA: basta un risultato superiore al
-- morale del bersaglio e l'unità rompe (regolamento 8).
-- ============================================================
function fire_rotturaDo(ctx, slot, player, rec)
    if ctx.inVolo then return end
    ctx.inVolo = true
    shoot_infoStato("Tiro della rottura in corso...", SHOOTINFO.gold)
    engine_diceClearLastRoll(slot)
    engine_diceSetNext(slot, ctx.rottura, ctx.morale + 1)

    engine_diceThrowFromBag(slot, nil, function(risultati, successi)
        ctx.inVolo = false
        if fire_rollRec(slot) ~= rec or rec.step ~= "ROTTURA" then return end
        Wait.time(function() engine_diceCameraReturn(player, 0) end, 2)

        local rompe = (successi or 0) > 0
        shoot_infoRisultati(risultati, ctx.morale + 1, successi or 0)
        engine_uiSet("shootinfo_esito", "text", rompe and "ROTTA! L'UNITA' LASCIA IL CAMPO" or "TIENE: GLI HIT VANNO PERSI")
        engine_uiSet("shootinfo_esito", "color", rompe and SHOOTINFO.bonus or SHOOTINFO.malus)
        if rompe then
            ctx.motivo = ctx.targetLabel .. " rompe"
            main_unitBreak(ctx.targetKey, "fuoco")
        else
            ctx.motivo = ctx.targetLabel .. " tiene"
            printToAll("[FUOCO] " .. ctx.targetLabel .. " tiene: gli hit della rottura vanno persi", LOG_COLORE)
        end
        main_refreshBaseButtons()
        engine_subStep("FIRE_ROLL", slot, "ESCI")
    end, player.color)
end
-- ============================================================
-- FUNZIONE: fire_rollEsciEnter(ctx, slot, rec)
-- Step ESCI: esito per MORALE_ESITO_SECONDS, poi chiusura.
-- ============================================================
function fire_rollEsciEnter(ctx, slot, rec)
    Wait.time(function()
        local live = fire_rollRec(slot)
        if live == rec and live.step == "ESCI" then
            shoot_infoHide()
            engine_subClose("FIRE_ROLL", slot, nil)
            main_refreshBaseButtons()
            callHandler("updateCenterPanel")
        end
    end, MORALE_ESITO_SECONDS)
end
-- ============================================================
-- FUNZIONE: fire_onRoll(player, slot)
-- Roll fuori dalla sottofase (phase.onRoll): test di Morale di
-- Divisione in coda, altrimenti avviso.
-- ============================================================
function fire_onRoll(player, slot)
    if main_divOnRoll(player, slot) then return end
    warningToColor("Scegli prima chi spara: FUOCO sulla base, mirino sul bersaglio, poi Tiro", player, "Yellow", 4, false)
end
-- ============================================================
-- FUNZIONE: fire_hasFired(unitKey)
-- Ha sparato in questa metà turno? (per la Manovra)
-- ============================================================
function fire_hasFired(unitKey)
    return FIRE_STATE and FIRE_STATE.sparato and FIRE_STATE.sparato[unitKey] == true
end

-- ============================================================
--                         FUMO DEL TIRO
-- ============================================================

-- ============================================================
-- FUNZIONE: fire_smokeTemplate(nome)
-- Oggetto sul tavolo da copiare (nome o tag uguale), o nil.
-- ============================================================
function fire_smokeTemplate(nome)
    for _, o in ipairs(getObjectsWithTag(nome) or {}) do return o end
    for _, o in ipairs(getAllObjects()) do
        if o.getName() == nome and not o.hasTag(FIRE_SMOKE.tag) and not o.hasTag(FIRE_SMOKE.cacheTag) then return o end
    end
    return nil
end
-- ============================================================
-- FUNZIONE: fire_smokeSource(nome)
-- Da dove si prende il fumo, in quest'ordine:
--   1. ovatta (modello statico), se FIRE_SMOKE.modo = "ovatta"
--      e c'è l'URL del modello
--   2. URL in FIRE_SMOKE.bundle
--   3. oggetto sul tavolo con quel nome o tag (si copia)
-- Il fumo NON va registrato fra gli asset della UI del mod.
-- Ritorna { modello = obj } o { url, secondario, scala, da }, o nil.
-- ============================================================
function fire_smokeSource(nome)
    -- ovatta per prima: se c'è l'URL vince sul fumo animato
    local O = FIRE_SMOKE.ovatta
    if FIRE_SMOKE.modo == "ovatta" and O and O.mesh ~= "" then
        return { ovatta = true, scala = O.scala[nome] or { 1, 1, 1 }, da = "ovatta" }
    end
    -- poi l'URL del bundle (vince su un vecchio oggetto sul tavolo)
    local b = FIRE_SMOKE.bundle[nome] or {}
    if b.url and b.url ~= "" then
        return { url = b.url, secondario = b.secondario, scala = b.scala or 1, da = "URL in FIRE_SMOKE" }
    end
    local modello = fire_smokeTemplate(nome)
    if modello then return { modello = modello, da = "oggetto sul tavolo" } end
    -- Niente asset della UI: un AssetBundle registrato fra gli
    -- asset della UI resta caricato da Unity e lo stesso bundle
    -- non si carica più come oggetto (prova di Max, 10/11/2026).
    return nil
end
-- ============================================================
-- FUNZIONE: fire_spawnSmokeAt(nome, basi)
-- Un fumo davanti a ogni base della lista. Ritorna la fonte.
-- ============================================================
function fire_spawnSmokeAt(nome, basi)
    local S = FIRE_SMOKE
    local fonte = fire_smokeSource(nome)
    if not fonte then
        print("[FUOCO] fumo '" .. nome .. "' non trovato: ne' oggetto sul tavolo, ne' URL in FIRE_SMOKE.bundle")
        return nil
    end

    for i, b in ipairs(basi) do
        local meta = main_baseMeta(b) or {}
        local prof = main_cmToTts(meta.profonditaCm or CALIBRAZIONE.baseProfonditaCm)
        local p, r = b.getPosition(), b.getRotation()
        local f = main_baseForward(b)
        local davanti = (S.bundle[nome] and S.bundle[nome].davantiCm) or S.davantiCm
        local d = prof / 2 + main_cmToTts(davanti)
        local pos = { x = p.x + f.x * d, y = p.y + S.altezza, z = p.z + f.z * d }
        local rot = { x = 0, y = (r.y + S.rotY) % 360, z = 0 }
        local function pronto(o)
            o.addTag(S.tag)
            o.setLock(true)
            -- suono: una volta per unità, non per ogni base
            if i == 1 then fire_smokeEffects(o, false) end
        end
        if fonte.ovatta then
            if i == 1 and not FIRE_OVATTA_ANNUNCIATA then
                FIRE_OVATTA_ANNUNCIATA = true
                printToAll("Fumo del tiro: ovatta", LOG_COLORE)
            end
            -- fiocco statico appoggiato sul tavolo davanti alla base
            local O, k = FIRE_SMOKE.ovatta, fonte.scala
            spawnObjectData({
                data = {
                    Name = "Custom_Model",
                    Nickname = nome,
                    Locked = true,
                    Transform = { posX = pos.x, posY = p.y, posZ = pos.z, rotX = 0, rotY = rot.y, rotZ = 0,
                                  scaleX = k[1], scaleY = k[2], scaleZ = k[3] },
                    ColorDiffuse = O.colore,
                    CustomMesh = {
                        MeshURL = O.mesh, DiffuseURL = "", NormalURL = "", ColliderURL = "",
                        Convex = true, MaterialIndex = 0, TypeIndex = 0, CastShadows = true,
                    },
                },
                callback_function = function(o)
                    o.addTag(S.tag)
                    o.setLock(true)
                    o.interactable = false
                end,
            })
        elseif fonte.modello then
            local data = fonte.modello.getData()
            data.Tags = nil
            data.GUID = nil
            data.Locked = true
            data.Transform.posX, data.Transform.posY, data.Transform.posZ = pos.x, pos.y, pos.z
            data.Transform.rotX, data.Transform.rotY, data.Transform.rotZ = rot.x, rot.y, rot.z
            spawnObjectData({ data = data, callback_function = pronto })
        else
            spawnObjectData({
                data = {
                    Name = "Custom_AssetBundle",
                    Nickname = nome,
                    Locked = true,
                    Transform = { posX = pos.x, posY = pos.y, posZ = pos.z, rotX = rot.x, rotY = rot.y, rotZ = rot.z,
                                  scaleX = fonte.scala, scaleY = fonte.scala, scaleZ = fonte.scala },
                    CustomAssetbundle = {
                        AssetbundleURL = fonte.url, AssetbundleSecondaryURL = fonte.secondario or "",
                        MaterialIndex = 0, TypeIndex = 0, LoopingEffectIndex = 0,
                    },
                },
                callback_function = pronto,
            })
        end
    end
    return fonte
end
-- ============================================================
-- FUNZIONE: fire_smokeEffects(o, stampa)
-- A bundle caricato: avvia l'effetto (suono) del fumo. I suoni
-- di un AssetBundle di TTS sono "trigger effects" o "looping
-- effects": non partono da soli, li avvia lo script.
-- stampa = true elenca gli effetti in console (debug).
-- ============================================================
function fire_smokeEffects(o, stampa)
    Wait.condition(function()
        if not o or o.isDestroyed() or not o.AssetBundle then return end
        local trigger = o.AssetBundle.getTriggerEffects() or {}
        local looping = o.AssetBundle.getLoopingEffects() or {}
        if stampa then
            print(string.format("[DEBUG] effetti del bundle: %d trigger, %d looping", #trigger, #looping))
            for _, e in ipairs(trigger) do print("  trigger " .. tostring(e.index) .. ": " .. tostring(e.name)) end
            for _, e in ipairs(looping) do print("  looping " .. tostring(e.index) .. ": " .. tostring(e.name)) end
        end
        local E = FIRE_SMOKE.effetto
        if E.tipo == "trigger" and #trigger > 0 then
            o.AssetBundle.playTriggerEffect(E.indice or 0)
        elseif E.tipo == "looping" and #looping > 0 then
            o.AssetBundle.playLoopingEffect(E.indice or 0)
        elseif #trigger > 0 then
            o.AssetBundle.playTriggerEffect(0)
        elseif #looping > 0 then
            o.AssetBundle.playLoopingEffect(0)
        end
    end, function()
        return o == nil or o.isDestroyed() or not o.loading_custom
    end, 10)
end
-- ============================================================
-- FUNZIONE: fire_preloadSmoke()
-- Una copia di ogni fumo sotto il tavolo (bloccata, non
-- interagibile): Unity tiene il bundle caricato e i fumi del
-- tiro compaiono subito. Una sola volta per partita.
-- ============================================================
function fire_preloadSmoke()
    -- ovatta: niente copie nascoste (si toglie quelle dei bundle)
    local O = FIRE_SMOKE.ovatta
    if FIRE_SMOKE.modo == "ovatta" and O and O.mesh ~= "" then
        for _, o in ipairs(getObjectsWithTag(FIRE_SMOKE.cacheTag) or {}) do o.destruct() end
        -- fumi animati rimasti sul tavolo (partite salvate prima)
        for _, o in ipairs(getObjectsWithTag(FIRE_SMOKE.tag) or {}) do
            if o.AssetBundle or o.name == "Custom_AssetBundle" then o.destruct() end
        end
        return
    end
    -- copie nascoste: si tengono solo quelle con l'URL attuale
    -- (bundle cambiato: via la vecchia copia)
    local presenti = {}
    for _, o in ipairs(getObjectsWithTag(FIRE_SMOKE.cacheTag) or {}) do
        local b = FIRE_SMOKE.bundle[o.getName()]
        local c = o.getCustomObject and o.getCustomObject() or {}
        local url = c.assetbundle or c.url
        if b and url and url ~= b.url then
            o.destruct()
        else
            presenti[o.getName()] = true
        end
    end
    local y = ((TABLE_AREA and TABLE_AREA.y) or 1) - FIRE_SMOKE.cacheSotto
    for i, nome in ipairs({ FIRE_SMOKE.moschetto, FIRE_SMOKE.cannone }) do
        local b = FIRE_SMOKE.bundle[nome]
        if not presenti[nome] and b and b.url ~= "" then
            spawnObjectData({
                data = {
                    Name = "Custom_AssetBundle",
                    Nickname = nome,
                    Locked = true,
                    Transform = { posX = i * 2, posY = y, posZ = 0, rotX = 0, rotY = 0, rotZ = 0,
                                  scaleX = b.scala or 1, scaleY = b.scala or 1, scaleZ = b.scala or 1 },
                    CustomAssetbundle = {
                        AssetbundleURL = b.url, AssetbundleSecondaryURL = b.secondario or "",
                        MaterialIndex = 0, TypeIndex = 0, LoopingEffectIndex = 0,
                    },
                },
                callback_function = function(o)
                    o.addTag(FIRE_SMOKE.cacheTag)
                    o.setLock(true)
                    o.interactable = false
                end,
            })
        end
    end
end
-- ============================================================
-- FUNZIONE: fire_spawnSmoke(unitKey)
-- Fumo davanti a ogni base del primo rango dell'unità.
-- ============================================================
function fire_spawnSmoke(unitKey)
    local u = main_unit(unitKey)
    if not u then return end
    local nome = (u.meta.arma == "cannone") and FIRE_SMOKE.cannone or FIRE_SMOKE.moschetto
    local basi = main_unitFirstRank(u)
    fire_spawnSmokeAt(nome, basi)
    fire_playShotSound(nome, basi)
end
-- ============================================================
-- FUNZIONE: fire_playShotSound(nome, basi)
-- Suono dello sparo: un bundle a parte, solo audio 2D (si sente
-- anche con la camera sul vassoio dei dadi), uno per unità,
-- tolto dopo FIRE_SMOKE.suono.durata secondi (Max 14/11).
-- ============================================================
function fire_playShotSound(nome, basi)
    local S = FIRE_SMOKE.suono
    -- 1) MP3 nel lettore musicale di TTS: lo sentono tutti, ovunque
    --    sia la camera (Max 14/11: i bundle solo audio non si caricano)
    local mp3 = S and S.mp3 and S.mp3[nome]
    if mp3 and mp3 ~= "" and MusicPlayer then
        pcall(function()
            MusicPlayer.repeat_track = false
            MusicPlayer.setCurrentAudioclip({ url = mp3, title = (nome == FIRE_SMOKE.cannone) and "Cannone" or "Moschetti" })
        end)
        Wait.condition(function() pcall(function() MusicPlayer.play() end) end,
            function() return MusicPlayer.loaded end, 5)
        return
    end
    -- 2) bundle solo audio
    local url = S and S[nome]
    if not url or url == "" or not basi or not basi[1] then return end
    local p = basi[1].getPosition()
    spawnObjectData({
        data = {
            Name = "Custom_AssetBundle",
            Nickname = "suono_" .. nome,
            Locked = true,
            Transform = { posX = p.x, posY = p.y - 3, posZ = p.z, rotX = 0, rotY = 0, rotZ = 0,
                          scaleX = 1, scaleY = 1, scaleZ = 1 },
            CustomAssetbundle = { AssetbundleURL = url, AssetbundleSecondaryURL = "", MaterialIndex = 0, TypeIndex = 0 },
        },
        callback_function = function(o)
            o.addTag(FIRE_SMOKE.tagSuono or "ldc_suono")
            o.interactable = false
            Wait.time(function() if o and not o.isDestroyed() then o.destruct() end end, S.durata or 12)
        end,
    })
end
-- ============================================================
-- FUNZIONE: fire_clearSmoke()
-- ============================================================
function fire_clearSmoke()
    local lista = {}
    for _, o in ipairs(getObjectsWithTag(FIRE_SMOKE.tag) or {}) do table.insert(lista, o) end
    for _, o in ipairs(getObjectsWithTag(FIRE_SMOKE.tagSuono or "ldc_suono") or {}) do table.insert(lista, o) end
    for _, o in ipairs(lista) do o.destruct() end
end
