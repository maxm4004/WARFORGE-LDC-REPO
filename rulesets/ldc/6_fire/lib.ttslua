-- ============================================================
-- WARFORGE LDC — 6_fire/lib.ttslua
-- Fuoco, primo giro (regolamento 8).
--
-- FUOCO sulla base della tua unità -> mirino da trascinare sul
-- bersaglio (come IEF) -> scheda nel pannello dadi -> Roll.
-- Lo script calcola distanza (D), gittata, dadi (1 per base del
-- primo rango, 2 per base per l'artiglieria a distanza corta) e
-- soglia; gli hit diventano disordini. Se gli hit manderebbero
-- il bersaglio in rotta, i dadi in eccesso si ritirano: basta un
-- risultato superiore al morale del bersaglio e l'unità rompe,
-- altrimenti quegli hit sono persi.
-- La fanteria tira al bersaglio più vicino, l'artiglieria
-- sceglie. Le unità in HOLDS possono sparare.
-- Rimandati: coperture, linea di vista, abitati, quadrato,
-- bombardamento del Generale.
-- ============================================================

-- ============================================================
--                        CHI PUÒ SPARARE
-- ============================================================

-- ============================================================
-- FUNZIONE: fire_weapon(u)
-- Arma da tiro dell'unità (LDC_ARMI), nil se non spara.
-- ============================================================
function fire_weapon(u)
    local cat = main_unitCategory(u.meta)
    if cat ~= CATEGORIA.FANTERIA and cat ~= CATEGORIA.SKIRMISH and cat ~= CATEGORIA.ARTIGLIERIA then
        return nil
    end
    return u.meta.arma and LDC_ARMI[u.meta.arma] or nil
end
-- ============================================================
-- FUNZIONE: fire_maxRangeD(u)
-- Gittata massima dell'unità in D.
-- ============================================================
function fire_maxRangeD(u)
    local arma = fire_weapon(u)
    if not arma then return 0 end
    local calibro = main_unitType(u.meta).calibro
    if arma.lunga and (not arma.lungaCalibri or arma.lungaCalibri[calibro or ""]) then
        return arma.lunga
    end
    return arma.effettiva or arma.corta or 0
end
-- ============================================================
-- FUNZIONE: fire_targets(slot, u)
-- Unità nemiche a portata e davanti: { [unitKey] = { dist } }.
-- La fanteria solo la più vicina (8).
-- ============================================================
function fire_targets(slot, u)
    local max = fire_maxRangeD(u)
    local cat = main_unitCategory(u.meta)
    local lista, minDist = {}, math.huge

    for key, t in pairs(main_unitsOfSide(main_otherSide(slot))) do
        local d = main_unitDistanceD(u, t)
        if d and d <= max and main_unitInFront(u, t) then
            lista[key] = { dist = d }
            minDist = math.min(minDist, d)
        end
    end

    if cat == CATEGORIA.FANTERIA or cat == CATEGORIA.SKIRMISH then
        for key, info in pairs(lista) do
            if info.dist > minDist + FIRE_TOLLERANZA_VICINO_D then lista[key] = nil end
        end
    end
    return lista
end

-- ============================================================
--                       CALCOLO DEL TIRO
-- ============================================================

-- ============================================================
-- FUNZIONE: fire_compute(u, t, dist)
-- Dadi e soglia del tiro di u contro t a distanza dist (D).
-- Ritorna { dadi, soglia, banda, primoRango, righe }.
-- ============================================================
function fire_compute(u, t, dist)
    local F = LDC_FUOCO
    local arma = fire_weapon(u) or {}
    local catU = main_unitCategory(u.meta)
    local catT = main_unitCategory(t.meta)

    local banda = "lunga"
    if dist <= (arma.corta or 0) then
        banda = "corta"
    elseif arma.effettiva and dist <= arma.effettiva then
        banda = "effettiva"
    end

    local primo = #main_unitFirstRank(u)
    local perBase = F.dadiPerBase
    if catU == CATEGORIA.ARTIGLIERIA and banda == "corta" then perBase = F.dadiArtCorta end
    local dadi = primo * perBase

    local soglia, motivo
    if catU == CATEGORIA.ARTIGLIERIA then
        if F.formazioniMasse[t.meta.formazione or ""] then
            soglia, motivo = F.artiglieriaVsMasse, "contro " .. tostring(t.meta.formazione)
        elseif banda ~= "lunga" and catT ~= CATEGORIA.SKIRMISH and catT ~= CATEGORIA.ARTIGLIERIA then
            soglia, motivo = F.artiglieriaVicina, "distanza " .. banda
        else
            soglia, motivo = F.altri, (banda == "lunga") and "distanza lunga" or "contro " .. tostring(catT):lower()
        end
    else
        if catT == CATEGORIA.SKIRMISH then
            soglia, motivo = F.fanteriaVsSkirm, "contro schermagliatori"
        else
            soglia, motivo = F.fanteria, "fanteria"
        end
    end

    local righe = {
        { "Distanza", main_formatD(dist) .. " (" .. banda .. ")" },
        { "Basi in primo rango", tostring(primo) },
        { "Dadi", primo .. " x " .. perBase .. " = " .. dadi .. "D6" },
        { "Per colpire", soglia .. "+ (" .. motivo .. ")" },
        { "Disordini del bersaglio", main_unitDisorders(t.key) .. "/" .. main_unitDisorderLimit(t.meta) },
    }
    return { dadi = dadi, soglia = soglia, banda = banda, primoRango = primo, righe = righe }
end

-- ============================================================
--                         BOTTONI
-- ============================================================

-- ============================================================
-- FUNZIONE: fire_baseButtons(obj, u, slot)
-- Bottoni della fase sulla base di comando (0_main/buttons).
-- Solo sulle unità dello schieramento attivo: il bersaglio si
-- sceglie col mirino.
-- ============================================================
function fire_baseButtons(obj, u, slot)
    local B = BASE_BUTTONS
    if slot ~= TURN.activeSide then return {} end

    if (FIRE_PENDING and FIRE_PENDING.tiratore == u.key) or (FIRE_SEL and FIRE_SEL.tiratore == u.key) then
        return { { label = "ANNULLA", click = "fire_clickAnnulla", color = B.annullaColor,
                   tooltip = "Annulla il tiro (prima del Roll)" } }
    end
    if FIRE_STATE.sparato[u.key] then
        return { { label = "SPARATO", click = "main_baseButtonNoop", color = B.annullaColor,
                   tooltip = "Ha gia' sparato: non potra' muovere" } }
    end
    if fire_weapon(u) and not FIRE_SEL and not FIRE_PENDING then
        return { { label = "FUOCO", click = "fire_clickFuoco",
                   tooltip = string.format("Spara (gittata %s)", main_formatD(fire_maxRangeD(u))) } }
    end
    return {}
end
-- ============================================================
-- FUNZIONE: fire_clickOk(player_color)
-- Il click viene dallo schieramento attivo in fase di Fuoco?
-- ============================================================
function fire_clickOk(player_color)
    if not ENGINE or ENGINE.phase ~= PHASE.FIRE or ENGINE.transitionPending then return false end
    if not main_colorInSide(player_color, TURN.activeSide) then
        warningToColor("Non e' il tuo Fuoco", Player[player_color], "Yellow", 3, false)
        return false
    end
    if FIRE_ROLLING then
        warningToColor("Aspetta che i dadi si fermino", Player[player_color], "Yellow", 3, false)
        return false
    end
    return true
end
-- ============================================================
-- FUNZIONE: fire_clickFuoco(obj, player_color, alt_click)
-- FUOCO: compare il mirino davanti all'unità.
-- ============================================================
function fire_clickFuoco(obj, player_color, alt_click)
    if not fire_clickOk(player_color) then return end
    local u, slot, mio = main_baseOwnerClick(obj, player_color)
    if not u or not mio or slot ~= TURN.activeSide then return end
    if FIRE_PENDING or FIRE_SEL or FIRE_STATE.sparato[u.key] then return end
    fire_mirinoStart(Player[player_color], slot, u)
    main_refreshBaseButtons()
end
-- ============================================================
-- FUNZIONE: fire_clickAnnulla(obj, player_color, alt_click)
-- ============================================================
function fire_clickAnnulla(obj, player_color, alt_click)
    if not fire_clickOk(player_color) then return end
    fire_annulla(Player[player_color])
end
-- ============================================================
-- FUNZIONE: fire_annulla(player)
-- Toglie mirino e tiro in sospeso (non la rottura).
-- ============================================================
function fire_annulla(player)
    if FIRE_PENDING and FIRE_PENDING.fase == "rottura" then
        if player then warningToColor("Il tiro della rottura non si annulla", player, "Yellow", 3, false) end
        return
    end
    fire_mirinoStop()
    FIRE_PENDING = nil
    if TURN.activeSide then engine_dicePanelClose(TURN.activeSide) end
    main_refreshBaseButtons()
end
-- ============================================================
-- FUNZIONE: fire_chooseTarget(player, sel, t)
-- Bersaglio valido: scheda nel pannello dadi e Roll.
-- ============================================================
function fire_chooseTarget(player, sel, t)
    local u = main_unitsOfSide(sel.slot)[sel.tiratore]
    if not u then return end

    local dist = sel.bersagli[t.key].dist
    local c = fire_compute(u, t, dist)
    FIRE_PENDING = {
        slot = sel.slot, tiratore = u.key, bersaglio = t.key, fase = "tiro",
        dadi = c.dadi, soglia = c.soglia,
        nome = (u.meta.nomeDisplay or u.key) .. " su " .. (t.meta.nomeDisplay or t.key),
    }

    engine_diceClearLastRoll(sel.slot)
    engine_dicePanelOpen(sel.slot, {
        titolo      = "FUOCO",
        sottotitolo = FIRE_PENDING.nome,
        righe       = c.righe,
        serve       = "Serve " .. c.soglia .. "+ su " .. c.dadi .. "D6",
    })
    engine_diceCameraZoom(player)
    warningToColor("Premi Roll sul vassoio dei dadi", player, "Yellow", 4, false)
    main_refreshBaseButtons()
end

-- ============================================================
--                  MIRINO (come IEF F38-F40)
-- FUOCO: un gettone davanti al fronte dell'unità. Il giocatore
-- lo trascina su un'unità nemica: verde = bersaglio valido,
-- arancio = a portata ma non valido (non il più vicino, fuori
-- dall'arco), rosso = fuori gittata, col motivo nel pannellino
-- sulla base. Rilasciato su un bersaglio valido si apre la
-- scheda del tiro; altrimenti torna al suo posto.
-- ============================================================

-- ============================================================
-- FUNZIONE: fire_uiIconUrl(nome)
-- URL di un asset della UI del mod (come IEF main_uiIconUrl).
-- ============================================================
function fire_uiIconUrl(nome)
    local ok, assets = pcall(function() return UI.getCustomAssets() end)
    if not ok or type(assets) ~= "table" then return nil end
    local cerca = string.lower(nome)
    for _, a in ipairs(assets) do
        if a.name and string.lower(a.name) == cerca and a.url and a.url ~= "" then return a.url end
    end
    return nil
end
-- ============================================================
-- FUNZIONE: fire_mirinoStart(player, slot, u)
-- ============================================================
function fire_mirinoStart(player, slot, u)
    fire_mirinoStop()
    local M = FIRE_MIRINO

    -- centro del fronte del primo rango e direzione del fronte
    local primo = main_unitFirstRank(u)
    local f = main_baseForward(u.comando)
    local cx, cz = 0, 0
    for _, b in ipairs(primo) do local p = b.getPosition(); cx, cz = cx + p.x, cz + p.z end
    cx, cz = cx / #primo, cz / #primo
    local hd = main_cmToTts(u.meta.profonditaCm or CALIBRAZIONE.baseProfonditaCm) / 2
    local origine = { x = cx + f.x * hd, z = cz + f.z * hd }
    local d = main_inchToTts(M.davanti)
    local y = u.comando.getPosition().y + 0.15

    local sel = {
        slot = slot, tiratore = u.key, bersagli = fire_targets(slot, u),
        player = player, host = u.comando, fronte = #primo,
        origine = origine,
        start = { x = origine.x + f.x * d, y = y, z = origine.z + f.z * d },
        rot = { x = 0, y = u.comando.getRotation().y + M.rotY, z = 0 },
        cache = {},
    }
    FIRE_SEL = sel

    local function pronto(o)
        if FIRE_SEL ~= sel then o.destruct(); return end
        o.setName("Mirino")
        sel.obj = o
    end
    local url = fire_uiIconUrl(M.icona)
    if url then
        spawnObjectData({
            data = {
                Name = "Custom_Token",
                Transform = { posX = sel.start.x, posY = sel.start.y, posZ = sel.start.z,
                              rotX = sel.rot.x, rotY = sel.rot.y, rotZ = sel.rot.z,
                              scaleX = M.scala, scaleY = 1, scaleZ = M.scala },
                CustomImage = {
                    ImageURL = url, ImageSecondaryURL = "", ImageScalar = 1, WidthScale = 0,
                    CustomToken = { Thickness = 0.1, MergeDistancePixels = 15, StandUp = false, Stackable = false },
                },
            },
            callback_function = pronto,
        })
    else
        spawnObject({
            type = "Checker_white", position = { sel.start.x, sel.start.y, sel.start.z },
            rotation = { sel.rot.x, sel.rot.y, sel.rot.z }, scale = { 0.45, 0.45, 0.45 }, sound = false,
            callback_function = function(o)
                o.setColorTint({ 1, 0.8, 0.1 })
                pronto(o)
            end,
        })
    end
    fire_mirinoPannello(sel, "Trascina il mirino sul bersaglio", "#FFFFFF")
end
-- ============================================================
-- FUNZIONE: fire_mirinoStop()
-- ============================================================
function fire_mirinoStop()
    local sel = FIRE_SEL
    if not sel then return end
    FIRE_SEL = nil
    if sel.waitId then Wait.stop(sel.waitId) end
    if sel.obj and not sel.obj.isDestroyed() then sel.obj.destruct() end
    fire_mirinoEvidenzia(sel, nil)
    if sel.host and not sel.host.isDestroyed() then sel.host.UI.setXml("") end
    main_setLines("fuoco", {})
end
-- ============================================================
-- FUNZIONE: fire_mirinoPannello(sel, testo, colore)
-- Pannellino sulla base di comando: testo e Chiudi (posizione
-- come IEF main_calcolaPosizionePannello).
-- ============================================================
function fire_mirinoPannello(sel, testo, colore)
    local h = sel.host
    if not h or h.isDestroyed() then return end
    if not sel.pannello then
        sel.pannello = true
        local x = ({ 10, 150, 310, 470, 630, 800, 960, 1120 })[sel.fronte] or (10 - 160 * (sel.fronte - 1))
        h.UI.setXml(string.format([[
            <Panel id="panelMirino" active="true" color="%s" width="760" height="90" offsetXY="0 405" position="%f %f %f" rotation="-90 0 0" visibility="%s">
                <HorizontalLayout spacing="10" padding="16 16 10 10" childAlignment="MiddleCenter" childForceExpandWidth="false">
                    <Text id="txtMirino" text="%s" fontStyle="Normal" fontSize="20" color="%s" alignment="MiddleCenter" preferredWidth="560"/>
                    <Button id="btnMirinoChiudi" text="Chiudi" fontSize="18" color="%s" textColor="White" preferredWidth="140" preferredHeight="50" onClick="Global/fire_mirinoChiudi"/>
                </HorizontalLayout>
            </Panel>
            ]], FIRE_PANNELLO.bg, x, 100, -500, sel.player.color, testo, colore, FIRE_PANNELLO.close))
        return
    end
    h.UI.setAttribute("txtMirino", "text", testo)
    h.UI.setAttribute("txtMirino", "color", colore)
end
-- ============================================================
-- FUNZIONE: fire_mirinoChiudi(player, value, id)
-- Chiudi del pannellino.
-- ============================================================
function fire_mirinoChiudi(player, value, id)
    if not fire_clickOk(player.color) then return end
    fire_annulla(player)
end
-- ============================================================
-- FUNZIONE: fire_mirinoUnitaSotto(sel, x, z)
-- Unità nemica sotto il mirino: la base più vicina entro
-- FIRE_MIRINO.sotto pollici. Ritorna l'unità o nil.
-- ============================================================
function fire_mirinoUnitaSotto(sel, x, z)
    local meglio, dMin = nil, main_inchToTts(FIRE_MIRINO.sotto)
    for _, t in pairs(main_unitsOfSide(main_otherSide(sel.slot))) do
        for _, b in ipairs(t.basi) do
            local d = main_pointRectDistance(x, z, main_baseRect(b))
            if d <= dMin then meglio, dMin = t, d end
        end
    end
    return meglio
end
-- ============================================================
-- FUNZIONE: fire_mirinoValuta(sel, t)
-- Esito ("ok"|"arancio"|"rosso") e testo per il bersaglio t.
-- ============================================================
function fire_mirinoValuta(sel, t)
    if sel.cache[t.key] then return sel.cache[t.key].esito, sel.cache[t.key].testo end
    local u = main_unitsOfSide(sel.slot)[sel.tiratore]
    local d = u and main_unitDistanceD(u, t) or 0
    local function esci(esito, causa)
        local testo = main_formatD(d) .. (causa and (" - Bersaglio non valido: " .. causa) or " - Bersaglio valido")
        sel.cache[t.key] = { esito = esito, testo = testo }
        return esito, testo
    end
    if sel.bersagli[t.key] then return esci("ok", nil) end
    if not u or d > fire_maxRangeD(u) then return esci("rosso", "fuori gittata") end
    if not main_unitInFront(u, t) then return esci("arancio", "fuori dall'arco di tiro") end
    return esci("arancio", "c'e' un bersaglio piu' vicino")
end
-- ============================================================
-- FUNZIONE: fire_mirinoEvidenzia(sel, t, esito)
-- ============================================================
function fire_mirinoEvidenzia(sel, t, esito)
    local key = t and t.key
    if sel.sopra and sel.sopra.key ~= key then
        for _, b in ipairs(sel.sopra.basi) do
            if not b.isDestroyed() then b.highlightOff() end
        end
    end
    sel.sopra = t
    if t then
        for _, b in ipairs(t.basi) do b.highlightOn(FIRE_MIRINO.linea[esito] or FIRE_MIRINO.linea.rosso) end
    end
end
-- ============================================================
-- FUNZIONE: fire_mirinoTick()
-- Durante il trascinamento: linea, evidenziazione e testo.
-- ============================================================
function fire_mirinoTick()
    local sel = FIRE_SEL
    if not sel or not sel.obj or sel.obj.isDestroyed() then return end
    local p = sel.obj.getPosition()
    local t = fire_mirinoUnitaSotto(sel, p.x, p.z)
    local esito, testo = nil, nil
    if t then esito, testo = fire_mirinoValuta(sel, t) end

    local o = sel.origine
    local y = sel.start.y - 0.1
    main_setLines("fuoco", { {
        points = { { o.x, y, o.z }, { p.x, y, p.z } },
        color = FIRE_MIRINO.linea[esito or "nessuno"], thickness = FIRE_MIRINO.spessore,
    } })

    if not t then
        fire_mirinoEvidenzia(sel, nil)
        sel.bersaglio = nil
        fire_mirinoPannello(sel, "", "#FFFFFF")
        return
    end
    sel.bersaglio = (esito == "ok") and t or nil
    fire_mirinoEvidenzia(sel, t, esito)
    fire_mirinoPannello(sel, testo, FIRE_MIRINO.colori[esito] or "#FFFFFF")
end
-- ============================================================
-- FUNZIONE: fire_mirinoOnPickUp(player_color, obj)
-- ============================================================
function fire_mirinoOnPickUp(player_color, obj)
    local sel = FIRE_SEL
    if not sel or obj ~= sel.obj then return end
    if sel.player.color ~= player_color then return end
    if sel.waitId then Wait.stop(sel.waitId) end
    sel.waitId = Wait.time(fire_mirinoTick, FIRE_MIRINO.tick, -1)
end
-- ============================================================
-- FUNZIONE: fire_mirinoOnDrop(player_color, obj)
-- ============================================================
function fire_mirinoOnDrop(player_color, obj)
    local sel = FIRE_SEL
    if not sel or obj ~= sel.obj then return end
    if sel.waitId then Wait.stop(sel.waitId); sel.waitId = nil end
    fire_mirinoTick()
    if sel.bersaglio then
        local t = sel.bersaglio
        fire_mirinoStop()
        fire_chooseTarget(sel.player, sel, t)
        return
    end
    -- non valido: il mirino torna al suo posto
    Wait.frames(function()
        if FIRE_SEL ~= sel or not sel.obj or sel.obj.isDestroyed() then return end
        sel.obj.setPosition(Vector(sel.start.x, sel.start.y, sel.start.z))
        sel.obj.setRotation(Vector(sel.rot.x, sel.rot.y, sel.rot.z))
        sel.obj.setVelocity(Vector(0, 0, 0))
        main_setLines("fuoco", {})
        fire_mirinoEvidenzia(sel, nil)
        fire_mirinoPannello(sel, "Trascina il mirino sul bersaglio", "#FFFFFF")
    end, 2)
end

-- ============================================================
--                            TIRO
-- ============================================================

-- ============================================================
-- FUNZIONE: fire_onRoll(player, slot)
-- Bottone 3D Roll durante il Fuoco (phase.onRoll).
-- ============================================================
function fire_onRoll(player, slot)
    if slot ~= TURN.activeSide then
        warningToColor("Non e' il tuo Fuoco", player, "Yellow", 3, false)
        return
    end
    if FIRE_ROLLING then return end
    local pend = FIRE_PENDING
    if not pend or pend.slot ~= slot then
        warningToColor("Scegli prima chi spara: FUOCO sulla base, poi il mirino sul bersaglio", player, "Yellow", 4, false)
        return
    end

    FIRE_ROLLING = true
    engine_diceClearLastRoll(slot)
    engine_diceSetNext(slot, pend.dadi, nil)
    engine_diceThrowFromBag(slot, nil, function(risultati)
        FIRE_ROLLING = false
        if ENGINE.phase ~= PHASE.FIRE then return end
        engine_diceCameraReturn(player)
        fire_resolve(slot, pend, risultati or {})
        main_refreshBaseButtons()
        callHandler("updateCenterPanel")
    end, player.color)
end
-- ============================================================
-- FUNZIONE: fire_resolve(slot, pend, risultati)
-- ============================================================
function fire_resolve(slot, pend, risultati)
    local t = main_unit(pend.bersaglio)
    if not t then FIRE_PENDING = nil; return end
    local colore = main_sideMainColor(slot)

    if pend.fase == "rottura" then
        FIRE_PENDING = nil
        local rompe = false
        for _, v in ipairs(risultati) do
            if v > pend.morale then rompe = true end
        end
        if rompe then
            fire_outcome(slot, "ROTTA!", true)
            main_unitBreak(pend.bersaglio, "fuoco")
        else
            fire_outcome(slot, "Tiene: hit persi", false)
            printToAll("[Fuoco] " .. (t.meta.nomeDisplay or t.key) .. " tiene: gli hit della rottura vanno persi", colore)
        end
        return
    end

    -- Tiro normale
    FIRE_STATE.sparato[pend.tiratore] = true
    local colpiti = 0
    for _, v in ipairs(risultati) do
        if v >= pend.soglia then colpiti = colpiti + 1 end
    end

    local limite = main_unitDisorderLimit(t.meta)
    local aggiunti = main_unitAddDisorders(t.key, colpiti, limite)
    local eccesso = colpiti - aggiunti
    printToAll(string.format("[Fuoco] %s: %d hit, %d disordini (%d/%d)", pend.nome, colpiti, aggiunti,
        main_unitDisorders(t.key), limite), colore)

    if eccesso <= 0 then
        FIRE_PENDING = nil
        fire_outcome(slot, colpiti .. " hit", colpiti > 0)
        return
    end

    -- Hit che manderebbero in rotta: si ritirano contro il morale
    local morale = t.meta.morale or 3
    FIRE_PENDING = {
        slot = slot, tiratore = pend.tiratore, bersaglio = pend.bersaglio, fase = "rottura",
        dadi = eccesso, morale = morale, nome = pend.nome,
    }
    engine_dicePanelOpen(slot, {
        titolo      = "ROTTURA",
        sottotitolo = pend.nome,
        righe       = {
            { "Hit del tiro", tostring(colpiti) },
            { "Disordini", main_unitDisorders(t.key) .. "/" .. limite },
            { "Hit che mandano in rotta", tostring(eccesso) },
            { "Morale del bersaglio", tostring(morale) },
        },
        serve       = "Ritira " .. eccesso .. "D6: serve piu' di " .. morale,
    })
    printToAll("[Fuoco] " .. eccesso .. " hit possono mandarlo in rotta: premi Roll (serve piu' di " .. morale .. ")", colore)
end
-- ============================================================
-- FUNZIONE: fire_outcome(slot, testo, buono)
-- ============================================================
function fire_outcome(slot, testo, buono)
    if not engine_dicePanelIsOpen(slot) then return end
    engine_dicePanelOutcome(slot, testo, buono and DICEPANEL.okColor or DICEPANEL.koColor)
end
-- ============================================================
-- FUNZIONE: fire_hasFired(unitKey)
-- Ha sparato in questa metà turno? (per la Manovra)
-- ============================================================
function fire_hasFired(unitKey)
    return FIRE_STATE and FIRE_STATE.sparato and FIRE_STATE.sparato[unitKey] == true
end
