-- ============================================================
-- FUNZIONE: fire_btn(player, value, id, buttonConfig)
-- "Fuoco completato": lo schieramento attivo chiude la fase
-- (solo lui arriva qui: main_canUseButton, modalità ACTIVE).
-- Non con un tiro in corso (come IEF shoot_btn_army*: la camera
-- torna sui dadi) né con un test di Divisione in sospeso.
-- ============================================================
function fire_btn(player, value, id, buttonConfig)
    if main_divBlocks(player) then return false end
    local slot = TURN.activeSide
    if fire_rollRec(slot) then
        warningToColor("Completa prima il tiro in corso", player, "Yellow", 4, false)
        engine_diceCameraZoom(player)
        return false
    end
    if FIRE_SEL or FIRE_PREP then fire_Reset() end
    return true
end
