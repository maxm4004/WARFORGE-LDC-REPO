-- Chi ha sparato in questa metà turno (salvato): non potrà
-- muovere nella Manovra (regolamento 8), salvo schermagliatori
-- e artiglieria a cavallo.
-- FIRE_STATE = { side, turno, sparato = { [unitKey] = true } }
FIRE_STATE = FIRE_STATE or { side = nil, turno = nil, sparato = {} }

-- Tiratore col mirino in mano (non salvato; il mirino è in
-- 0_main/mirino): { slot, tiratore = unitKey, player,
--   bersagli = { [unitKey] = { dist } } }
FIRE_SEL = nil

-- Bersaglio scelto, scheda e conferma a schermo (non salvato):
-- { slot, u, t, dist, c, player, primo }
FIRE_PREP = nil
