-- ============================================================
-- FUNZIONE: before_fire(phaseName, phase)
-- Nuovo Fuoco dello schieramento attivo: nessuno ha ancora
-- sparato; fumi precaricati.
-- ============================================================
function before_fire(phaseName, phase)
    FIRE_STATE = { side = TURN.activeSide, turno = ENGINE.turn, sparato = {} }
    FIRE_SEL   = nil
    FIRE_PREP  = nil
    fire_preloadSmoke()
    callHandler("updateCenterPanel")
end
-- ============================================================
-- FUNZIONE: after_fire(phaseName, phase)
-- Chi ha sparato resta segnato (fumo) per la Manovra.
-- ============================================================
function after_fire(phaseName, phase)
    fire_Reset()
    shoot_infoHide()
    -- il fumo sparisce alla fine del Fuoco (Max 14/11)
    fire_clearSmoke()
end
