-- ============================================================
-- WARFORGE LDC — 6_fire/constants.ttslua
-- Costanti della fase (valori fissi). I dati del regolamento
-- (gittate, soglie, dadi) sono in 0_main/rules.ttslua.
-- ============================================================

-- Tolleranza per "bersaglio più vicino" della fanteria (D)
FIRE_TOLLERANZA_VICINO_D = 0.05

-- Secondi prima di chiudere il pannello dadi a fine fase
FIRE_DICEPANEL_CLOSE = 3

-- Cono di tiro (come IEF IEF_SHOOTING.angle): dalla linea del
-- fronte, fra gli angoli esterni delle basi del primo rango, si
-- allarga di FIRE_ARCO gradi per lato. Il regolamento LDC non
-- dà un arco di tiro: si tiene quello di IEF (vedi dubbi).
FIRE_ARCO = 45

-- Colori come IEF: basi che tirano (arancio), basi raggiunte del
-- bersaglio (azzurro), linee del cono (giallo)
FIRE_COLORI = {
    pronte    = { 1, 0.549, 0 },
    raggiunte = { 0.2, 0.6, 1 },
    cono      = { 1, 0.8, 0.1 },
}

-- Riempimento del cono (Max 12/11): righe gialle parallele al
-- fronte, con trasparenza (alfa). Con spessore = passo le righe
-- si toccano e l'area è piena. Prova in partita:
--   /execute debug_cono(passo, spessore, alfa)
FIRE_CONO_RIEMPI = {
    attivo   = true,
    passo    = 0.25,              -- distanza fra le righe (unità TTS)
    spessore = 0.25,              -- spessore delle righe
    colore   = { 1, 0.8, 0.1, 0.35 },   -- provato da Max in TTS (12/11)
}

-- ============================================================
-- PANNELLO INFO TIRO (copiato da IEF 7_shoot/constants)
-- Visibile al giocatore che tira dal rilascio del mirino sul
-- bersaglio fino al tiro o a Chiudi; dopo "Tiro" lo vedono
-- tutti. Tiro / Chiudi stanno in confirm_panel_shoot.
-- ============================================================
SHOOTINFO = SHOOTINFO or {
    width     = 560,
    colWidth  = 262,
    padding   = 12,
    titleH    = 24,
    noteH     = 16,
    rowH      = 17,
    gap       = 6,
    colRows   = 7,     -- righe per colonna (Tiratore / Bersaglio)
    rows      = 8,     -- righe per colonna della parte bassa (Dadi / Per colpire)
    valWidth  = 80,    -- larghezza della colonna valori (Dadi / Per colpire)
    bg        = "rgba(0,0,0,0.70)",
    gold      = "#FFD833",
    grey      = "#BBBBBB",
    bonus     = "#5BD35B",
    malus     = "#FF6B6B",
    statoH    = 22,
    esitoH    = 26,
    maxFaces  = 16,
    faceSize  = 28,
    faceGap   = 4,
    faceKo    = "rgba(1,1,1,0.3)",
}

-- ------------------------------------------------------------
-- Fumo del tiro: segna chi ha sparato (Max, 9/11/2026). Un fumo
-- (AssetBundle) davanti a ogni base del primo rango che ha
-- sparato, girato di 180° rispetto alla base. Si copia l'oggetto
-- sul tavolo con quel nome o tag; se non c'è, si crea dagli URL
-- qui sotto. Tolto a fine metà turno.
-- Attenzione: il fumo NON va registrato fra gli asset della UI
-- del mod, altrimenti Unity tiene il bundle già caricato e
-- l'oggetto non si vede.
-- ------------------------------------------------------------
FIRE_SMOKE = {
    -- "ovatta": fiocco statico (modello 3D leggero, come l'ovatta
    -- sul tavolo vero; Max 13/11); "bundle": fumo animato col
    -- suono (lento da caricare)
    modo      = "bundle",   -- nuvola ferma senza audio (Max 14/11, assets/*_smoke_fermo); "ovatta" per il fiocco
    ovatta = {
        -- URL del modello ovatta.obj caricato nel cloud di Steam
        -- (vuoto = si usa il bundle)
        mesh   = "https://steamusercontent-a.akamaihd.net/ugc/10536444511985845720/396156C0A5AFC8E254A98E19C9D590506AFBDD83/",
        colore = { r = 0.93, g = 0.93, b = 0.90 },
        -- scala del fiocco: larghezza, altezza, profondità
        scala  = {
            musket_smoke = { 0.9, 0.55, 0.8 },
            cannon_smoke = { 1.3, 0.8, 1.2 },
        },
    },
    moschetto = "musket_smoke",
    cannone   = "cannon_smoke",
    -- AssetBundle (se non c'è l'oggetto sul tavolo da copiare)
    bundle = {
        musket_smoke = { url = "https://steamusercontent-a.akamaihd.net/ugc/11350658864073046023/C959AA1AE096E71F0C00093DF96F8101C7AFA856/", secondario = "", scala = 1 },
        -- davantiCm: il fumo del cannone un po' più vicino (Max 14/11)
        cannon_smoke = { url = "https://steamusercontent-a.akamaihd.net/ugc/16737035121159087751/3F9245921FBDF22EE6DFC85FD3D967ECB8592DE1/", secondario = "", scala = 1, davantiCm = -1.0 },
    },
    -- suono dello sparo: bundle solo audio (assets/*_suono), uno per
    -- unità; vuoto = niente suono
    suono = {
        musket_smoke = "",
        cannon_smoke = "",
        durata = 12,     -- secondi, poi l'oggetto si toglie
    },
    -- effetto del bundle da avviare (il suono): "trigger" o
    -- "looping" e indice; nil = il primo che c'è
    effetto   = { tipo = nil, indice = 0 },
    davantiCm = 0.5,     -- dal bordo anteriore della base al centro del fumo
    altezza   = 0.05,    -- sopra la base
    rotY      = 180,     -- rispetto alla base
    tag       = "ldc_smoke",
    -- copie nascoste sotto il tavolo per tenere i bundle già
    -- caricati: al tiro il fumo (e il suono) compare subito
    cacheTag  = "ldc_smoke_cache",
    cacheSotto = 3,      -- unità sotto la superficie del tavolo
}
