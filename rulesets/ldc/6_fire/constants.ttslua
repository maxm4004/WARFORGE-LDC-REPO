-- ============================================================
-- WARFORGE LDC — 6_fire/constants.ttslua
-- Costanti della fase (valori fissi). I dati del regolamento
-- (gittate, soglie, dadi) sono in 0_main/rules.ttslua.
-- ============================================================

-- Tolleranza per "bersaglio più vicino" della fanteria (D)
FIRE_TOLLERANZA_VICINO_D = 0.05

-- Secondi prima di chiudere il pannello dadi a fine fase
FIRE_DICEPANEL_CLOSE = 3

-- ------------------------------------------------------------
-- Fumo del tiro: segna chi ha sparato (Max, 9/11/2026). Un fumo
-- (AssetBundle) davanti a ogni base del primo rango che ha
-- sparato, girato di 180° rispetto alla base. Si copia l'oggetto
-- sul tavolo con quel nome o tag; se non c'è, si crea dagli URL
-- qui sotto. Tolto a fine metà turno.
-- ------------------------------------------------------------
FIRE_SMOKE = {
    moschetto = "musket_smoke",
    cannone   = "cannon_smoke",
    -- AssetBundle (se non c'è l'oggetto sul tavolo da copiare)
    bundle = {
        musket_smoke = { url = "", secondario = "", scala = 1 },
        cannon_smoke = { url = "", secondario = "", scala = 1 },
    },
    davantiCm = 1.5,     -- dal bordo anteriore della base al centro del fumo
    altezza   = 0.05,    -- sopra la base
    rotY      = 180,     -- rispetto alla base
    tag       = "ldc_smoke",
}
