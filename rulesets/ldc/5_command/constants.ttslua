-- ============================================================
-- WARFORGE LDC — 5_command/constants.ttslua
-- Costanti della fase (valori fissi).
-- Regolamento 7.1-7.2, QRS "Fase di comando".
-- ============================================================

-- Stato di ogni gruppo di attivazione (Brigata, o unità di una
-- Divisione senza Brigata) nella fase di Comando
COMMAND_STATO = {
    DA_TIRARE = "DA_TIRARE",   -- il Generale non ha ancora tirato
    FALLITA   = "FALLITA",     -- test fallito, si può ritirare (Riprova); a fine Comando HOLDS
    ATTIVA    = "ATTIVA",      -- attivata
    HOLDS     = "HOLDS",       -- in HOLDS fino al prossimo Comando
}

-- Il CiC ritira un test fallito se è entro questa distanza
-- dalla Brigata (D, bordo-bordo come IEF, base più vicina)
COMMAND_RITIRO_D = 4

-- Ritiri del CiC per metà turno (ogni turno, per giocatore):
-- massimo 3, uno per test fallito. nil = nessun limite
COMMAND_RITIRI_MAX = 3

-- Secondi prima di chiudere il pannello dadi a fine fase
COMMAND_DICEPANEL_CLOSE = 3

-- Pannello Comando a livelli (Divisione -> Brigate), colori da
-- STILE (0_main/style.ttslua, main_styleApply)
COMMAND_PANEL = {
    righeMax      = 16,         -- righe al massimo (Divisioni + Brigate aperte)
    width         = 700,       -- coppia Tiro veloce / Vassoio (Max 14/11)
    rowHeight     = 30,
    headerHeight  = 24,
    padding       = 12,
    spacing       = 3,
    rientro       = 28,         -- rientro delle Brigate sotto la Divisione
    nomeWidth     = 230,
    competenzaWidth = 120,      -- "Incompetente (2)", tabella 7.1 (Max 12/11, era "Gen 4")
    btnH          = 24,
    font          = "warforge_font",
    rowBg         = "rgba(1,1,1,0.06)",
    actionBg      = "#B8902E",
    closeBg       = "rgba(0.45,0.45,0.45,1)",
    dadoLato      = 24,                       -- faccia del dado (asset d1..d6)
    rectAlignment = "LowerCenter",   -- un solo pannello, in basso al centro (Max)
    offsetXY      = "0 90",
    evidenzia     = { 1, 0.85, 0.1 },-- basi del gruppo scelto
    filoCiC       = { 0.72, 0.52, 0.04 },
    bg            = "rgba(0,0,0,0.70)",
    titleColor    = "#FFD833",
    textColor     = "White",
    noteColor     = "#BBBBBB",
    -- colore del testo di ogni stato
    statoColor = {
        DA_TIRARE = "#BBBBBB",
        FALLITA   = "#FF6B6B",
        ATTIVA    = "#5BD35B",
        HOLDS     = "#FF6B6B",
    },
    -- Max 12/11: Attivata / Non Attivata (fallito o HOLDS)
    statoTesto = {
        DA_TIRARE = "da attivare",
        FALLITA   = "Non Attivata",
        ATTIVA    = "Attivata",
        HOLDS     = "Non Attivata",
    },
}

-- Marker HOLDS: testo 3D sul tavolo dietro la base del Generale
-- (la cosa più semplice per ora; da tarare in TTS)
COMMAND_MARKER = {
    attivo   = false,     -- testo HOLDS sul tavolo spento (Max 11/11)
    testo     = "HOLDS",
    colore    = { r = 1, g = 0.15, b = 0.15 },
    fontSize  = 64,
    dietroCm  = 2,            -- dal bordo posteriore della base del Generale
    altezzaY  = 0.15,         -- sopra il tavolo
    rotX      = 90,           -- disteso sul tavolo
    yaw       = { [1] = 0, [2] = 180 },   -- leggibile dal proprio lato
    scala     = 1,
}

-- Esito dell'attivazione sul tavolo: disco e anello attorno al
-- Generale che attiva (Max 14/11), visibili anche al nemico
COMMAND_ANELLI = {
    attivo    = true,
    colori    = {
        ATTIVA  = { 0.25, 0.85, 0.3 },     -- Attivata
        HOLDS   = { 0.9, 0.2, 0.15 },      -- Non Attivata
        FALLITA = { 1, 0.6, 0.1 },         -- fallito, Riprova possibile
    },
    alfa      = 0.30,     -- trasparenza del disco
    passo     = 0.25,     -- righe del disco (come il cono di tiro)
    spessore  = 0.12,     -- anello
    lati      = 48,
    margineCm = 0.6,      -- oltre gli angoli della base
    altezzaY  = 0.05,     -- sopra il tavolo
}

-- Tag dei marker HOLDS, per schieramento
COMMAND_MARKER_TAG = { [1] = "ldc_holds1", [2] = "ldc_holds2" }
