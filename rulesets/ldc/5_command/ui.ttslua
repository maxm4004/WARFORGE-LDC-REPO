-- ============================================================
-- WARFORGE LDC — 5_command/ui.ttslua
-- Pannello Comando a livelli (Max 12/11/2026), in basso al
-- centro:
--   Attivazione - Army2
--   + 2a Divisione ...                     (primo livello)
--   - 3a Divisione ...                     (aperta: clic sul nome)
--         Brigata Kister   Competenza 4  da attivare   [Attiva]
--         Brigata Maucune  Competenza 2  Non Attivata  [5] [Riprova]
-- Un clic sulla Divisione apre o chiude le sue Brigate; il
-- pannello cresce e cala con le righe visibili. Il nome della
-- Brigata inquadra le sue basi. Niente messaggi sotto il
-- titolo, niente Fermo: un test fallito resta "Non Attivata"
-- (Riprova se il CiC può). Colori da STILE (0_main/style).
-- Lo vedono tutti; bottoni e apertura solo lo schieramento attivo.
-- ============================================================

-- Divisioni aperte: COMMAND_APERTE[slot][divId] = true (non salvato)
COMMAND_APERTE = COMMAND_APERTE or { [1] = {}, [2] = {} }

-- Riga i del pannello: chiave del gruppo (Brigata) o Divisione
COMMAND_ROWS    = {}
COMMAND_DIVROWS = {}

-- ============================================================
-- FUNZIONE: command_panelHeight(righe)
-- ============================================================
function command_panelHeight(righe)
    local P = COMMAND_PANEL
    return P.padding * 2 + P.headerHeight
        + righe * P.rowHeight + (righe + 1) * P.spacing
end
-- ============================================================
-- FUNZIONE: command_panelXml()
-- Righe fisse (COMMAND_PANEL.righeMax): si accendono quelle che
-- servono. Riga: rientro, nome (bottone), Generale, stato,
-- facce dei dadi, Attiva / Riprova.
-- ============================================================
function command_panelXml()
    local P, S, M = COMMAND_PANEL, STILE, STILE_MISURE
    local righe = ""
    for i = 1, P.righeMax do
        righe = righe .. string.format([[
            <HorizontalLayout id="cmdRow%d" active="false" spacing="6" padding="6 8 0 0" childForceExpandWidth="false"
                              preferredHeight="%d" childAlignment="MiddleLeft" color="%s">
                <Text id="cmdInd%d" text="" preferredWidth="%d" active="false"/>
                <Button id="cmdNome%d" text="" font="%s" fontSize="%d" textColor="%s" color="rgba(0,0,0,0)"
                        textAlignment="MiddleLeft" preferredWidth="%d" onClick="command_clickNome"/>
                <Text id="cmdGen%d" text="" font="%s" fontSize="%d" color="%s" alignment="MiddleLeft" preferredWidth="%d"/>
                <Text id="cmdStato%d" text="" font="%s" fontSize="%d" color="%s" alignment="MiddleLeft" preferredWidth="104"/>
                <Image id="cmdDado%d" image="" preserveAspect="true" preferredWidth="%d" preferredHeight="%d" active="false"/>
                <Image id="cmdDadoR%d" image="" preserveAspect="true" preferredWidth="%d" preferredHeight="%d" active="false"/>
                <Button id="cmdTira%d" text="Attiva" font="%s" fontSize="%d" preferredWidth="70" preferredHeight="%d"
                        color="%s" textColor="%s" onClick="command_clickTira" active="false"/>
                <Button id="cmdRitira%d" text="Riprova" font="%s" fontSize="%d" preferredWidth="70" preferredHeight="%d"
                        color="%s" textColor="%s" onClick="command_clickRitira" active="false"
                        tooltip="Il CiC ritira il dado" tooltipPosition="Above"/>
            </HorizontalLayout>
]], i, P.rowHeight, S.riga,
            i, P.rientro,
            i, S.font, M.testo, S.testo, P.nomeWidth,
            i, S.font, M.piccolo, S.tenue, P.competenzaWidth,
            i, S.font, M.testo, S.tenue,
            i, P.dadoLato, P.dadoLato, i, P.dadoLato, P.dadoLato,
            i, S.font, M.bottone, P.btnH, S.azione, S.azioneTesto,
            i, S.font, M.bottone, P.btnH, S.azione, S.azioneTesto)
    end

    return string.format([[
    <Panel id="cmdPanel" active="false" rectAlignment="%s" offsetXY="%s"
           width="%d" height="%d" %s>
        <VerticalLayout padding="%d %d %d %d" spacing="%d" childForceExpandHeight="false" childAlignment="UpperCenter">
            <Text id="cmdTitolo" ]] .. main_styleTextOutline() .. [[ text="Attivazione" font="%s" fontSize="%d" color="%s"
                  alignment="MiddleCenter" preferredHeight="%d"/>
%s
        </VerticalLayout>
    </Panel>
]], P.rectAlignment, P.offsetXY, P.width, command_panelHeight(P.righeMax), main_stylePanelAttrs(),
        P.padding, P.padding, P.padding, P.padding, P.spacing,
        S.font, M.titolo, S.titolo, P.headerHeight,
        righe)
end
-- ============================================================
-- FUNZIONE: command_rowText(d)
-- Testo dello stato (i dadi si vedono come facce).
-- ============================================================
function command_rowText(d)
    return COMMAND_PANEL.statoTesto[d.stato] or d.stato
end
-- ============================================================
-- FUNZIONE: command_divisionsOf(slot)
-- Divisioni in ordine, ognuna con i suoi gruppi in ordine:
-- { { divId, gruppi = { key, ... } }, ... }
-- ============================================================
function command_divisionsOf(slot)
    local st = COMMAND_STATE[slot]
    local elenco, perDiv = {}, {}
    for _, key in ipairs(st.ordine) do
        local g = st.gruppi[key]
        local divId = g and g.divId or "?"
        if not perDiv[divId] then
            perDiv[divId] = { divId = divId, gruppi = {} }
            table.insert(elenco, perDiv[divId])
        end
        table.insert(perDiv[divId].gruppi, key)
    end
    return elenco
end
-- ============================================================
-- FUNZIONE: command_panelRows(slot)
-- Righe visibili in ordine: { tipo = "div", divId, aperta } e,
-- sotto le Divisioni aperte, { tipo = "gruppo", key }.
-- ============================================================
function command_panelRows(slot)
    local aperte = COMMAND_APERTE[slot] or {}
    local righe = {}
    for _, div in ipairs(command_divisionsOf(slot)) do
        local aperta = aperte[div.divId] == true
        table.insert(righe, { tipo = "div", divId = div.divId, aperta = aperta, gruppi = div.gruppi })
        if aperta then
            for _, key in ipairs(div.gruppi) do
                table.insert(righe, { tipo = "gruppo", key = key })
            end
        end
    end
    return righe
end
-- ============================================================
-- FUNZIONE: command_divSummary(slot, gruppi)
-- Riassunto della Divisione chiusa: "2 di 3 attivate".
-- ============================================================
function command_divSummary(slot, gruppi)
    local st = COMMAND_STATE[slot]
    local attive = 0
    for _, key in ipairs(gruppi) do
        if st.gruppi[key].stato == COMMAND_STATO.ATTIVA then attive = attive + 1 end
    end
    return string.format("%d di %d attivate", attive, #gruppi), attive == #gruppi
end
-- ============================================================
-- FUNZIONE: command_toggleDivision(slot, divId)
-- ============================================================
function command_toggleDivision(slot, divId)
    COMMAND_APERTE[slot] = COMMAND_APERTE[slot] or {}
    COMMAND_APERTE[slot][divId] = (not COMMAND_APERTE[slot][divId]) or nil
    command_redrawPanel()
end
-- ============================================================
-- FUNZIONE: command_openDivisionOf(slot, key)
-- Apre la Divisione del gruppo (tiro in corso: la riga si vede).
-- ============================================================
function command_openDivisionOf(slot, key)
    local g = command_group(slot, key)
    if not g then return end
    COMMAND_APERTE[slot] = COMMAND_APERTE[slot] or {}
    COMMAND_APERTE[slot][g.divId] = true
end
-- ============================================================
-- FUNZIONE: command_redrawPanel()
-- Aggiorna il pannello; lo spegne fuori dalla fase di Comando.
-- ============================================================
function command_redrawPanel()
    local P, S = COMMAND_PANEL, STILE
    local slot = TURN and TURN.activeSide
    local st = slot and COMMAND_STATE[slot]
    COMMAND_ROWS, COMMAND_DIVROWS = {}, {}

    if not ENGINE or ENGINE.phase ~= PHASE.COMMAND or not st then
        engine_uiSet("cmdPanel", "active", "false")
        return
    end

    local elenco = command_panelRows(slot)
    local righe = math.min(#elenco, P.righeMax)
    engine_uiSet("cmdPanel", "active", "true")
    engine_uiSet("cmdPanel", "height", tostring(command_panelHeight(math.max(righe, 1))))
    engine_uiSet("cmdTitolo", "text", "Attivazione - " .. main_sideName(slot))

    local visibili = main_sideVisibility(slot)
    local inVolo = COMMAND_ROLLING or COMMAND_PENDING ~= nil

    for i = 1, P.righeMax do
        local r = elenco[i]
        local row = "cmdRow" .. i
        if not r then
            engine_uiSet(row, "active", "false")
        elseif r.tipo == "div" then
            -- primo livello: Divisione (clic = apri / chiudi)
            local div = st.divisioni[r.divId]
            COMMAND_DIVROWS[i] = r.divId
            local riassunto, tutte = command_divSummary(slot, r.gruppi)
            engine_uiSet(row, "active", "true")
            engine_uiSet(row, "color", S.rigaLivello1)
            engine_uiSet("cmdInd" .. i, "active", "false")
            engine_uiSet("cmdNome" .. i, "text", (r.aperta and "-  " or "+  ") .. (div and div.nome or tostring(r.divId)))
            engine_uiSet("cmdNome" .. i, "textColor", S.titolo)
            engine_uiSet("cmdGen" .. i, "text", div and ("Competenza " .. tostring(div.valore)) or "")
            engine_uiSet("cmdStato" .. i, "text", r.aperta and "" or riassunto)
            engine_uiSet("cmdStato" .. i, "color", tutte and S.ok or S.tenue)
            for _, nome in ipairs({ "cmdTira", "cmdRitira", "cmdDado", "cmdDadoR" }) do
                engine_uiSet(nome .. i, "active", "false")
            end
        else
            -- secondo livello: Brigata (o Senza Brigata)
            local key = r.key
            local d = st.gruppi[key]
            COMMAND_ROWS[i] = key
            local focus = COMMAND_FOCUS and COMMAND_FOCUS.key == key
            engine_uiSet(row, "active", "true")
            engine_uiSet(row, "color", focus and S.rigaScelta or S.riga)
            engine_uiSet("cmdInd" .. i, "active", "true")
            engine_uiSet("cmdNome" .. i, "text", d.nome)
            engine_uiSet("cmdNome" .. i, "textColor", S.testo)
            engine_uiSet("cmdGen" .. i, "text", d.valore and ("Competenza " .. tostring(d.valore)) or "-")
            engine_uiSet("cmdStato" .. i, "text", command_rowText(d))
            engine_uiSet("cmdStato" .. i, "color", P.statoColor[d.stato] or S.testo)

            -- Bottoni: solo lo schieramento attivo, solo quelli utili
            local scelta = COMMAND_PENDING and COMMAND_PENDING.key == key
            local tira   = d.stato == COMMAND_STATO.DA_TIRARE and (not inVolo or scelta)
            local ritira = d.stato == COMMAND_STATO.FALLITA and command_canReroll(slot, key) and (not inVolo or scelta)
            for nome, acceso in pairs({ cmdTira = tira, cmdRitira = ritira }) do
                engine_uiSet(nome .. i, "active", acceso and "true" or "false")
                engine_uiSet(nome .. i, "visibility", visibili)
            end
            -- bottone del tiro scelto: si tira coi dadi del vassoio
            engine_uiSet("cmdTira" .. i, "text", (scelta and COMMAND_PENDING.tipo == "tiro") and "Dadi" or "Attiva")
            engine_uiSet("cmdRitira" .. i, "text", (scelta and COMMAND_PENDING.tipo == "ritiro") and "Dadi" or "Riprova")
            -- facce dei dadi tirati (asset d1..d6)
            engine_uiSet("cmdDado" .. i, "active", d.tiro and "true" or "false")
            if d.tiro then engine_uiSet("cmdDado" .. i, "image", "d" .. tostring(d.tiro)) end
            engine_uiSet("cmdDadoR" .. i, "active", d.ritiro and "true" or "false")
            if d.ritiro then engine_uiSet("cmdDadoR" .. i, "image", "d" .. tostring(d.ritiro)) end
        end
    end

end
