-- ============================================================
-- WARFORGE LDC — 5_command/ui.ttslua
-- Pannello Comando (uno solo, in basso al centro, come chiesto
-- da Max: niente scheda separata nel pannello dadi). In cima la
-- riga del tiro scelto (Brigata, Generale, cosa serve) e poi
-- l'esito; resta visibile anche con la camera sui dadi.
-- Il nome della Brigata è un bottone: inquadra la Brigata e ne
-- illumina le basi.
-- Per ogni Divisione una riga di intestazione
-- (nome e Generale di Divisione), poi una riga per Brigata (e
-- una per le unità senza Brigata) con Generale, stato e bottoni
-- Tira / CiC (ritiro) / HOLDS. Lo vedono tutti; i bottoni solo
-- lo schieramento attivo.
-- Righe fisse (COMMAND_PANEL.righeMax): si accendono quelle
-- che servono.
-- ============================================================

-- ============================================================
-- FUNZIONE: command_panelHeight(righe)
-- ============================================================
function command_panelHeight(righe)
    local P = COMMAND_PANEL
    return P.padding * 2 + P.headerHeight + P.footerHeight + P.sceltaHeight
        + righe * P.rowHeight + (righe + 3) * P.spacing
end
-- ============================================================
-- FUNZIONE: command_panelXml()
-- XML del pannello (dentro getRulesetUiXml), grafica dei
-- pannelli di IEF: sfondo 70%, titolo oro, font warforge_font,
-- righe chiare, bottoni oro/grigio come la conferma di IEF.
-- Riga: nome della Brigata (inquadra), Generale, stato, dado
-- (e dado del ritiro), Attiva / Riprova / Fermo.
-- ============================================================
function command_panelXml()
    local P = COMMAND_PANEL
    local righe = ""
    for i = 1, P.righeMax do
        righe = righe .. string.format([[
            <HorizontalLayout id="cmdRow%d" active="false" spacing="6" childForceExpandWidth="false"
                              preferredHeight="%d" childAlignment="MiddleLeft">
                <Button id="cmdNome%d" text="" font="%s" fontSize="14" fontStyle="Bold" textColor="%s" color="%s"
                        textAlignment="MiddleLeft" preferredWidth="250" onClick="command_clickNome"/>
                <Text id="cmdGen%d" text="" font="%s" fontSize="12" color="%s" alignment="MiddleCenter" preferredWidth="48"/>
                <Text id="cmdStato%d" text="" font="%s" fontSize="13" fontStyle="Bold" color="%s" alignment="MiddleLeft" preferredWidth="92"/>
                <Image id="cmdDado%d" image="" preserveAspect="true" preferredWidth="%d" preferredHeight="%d" active="false"/>
                <Image id="cmdDadoR%d" image="" preserveAspect="true" preferredWidth="%d" preferredHeight="%d" active="false"/>
                <Button id="cmdTira%d" text="Attiva" font="%s" fontSize="13" preferredWidth="66"
                        color="%s" textColor="Black" onClick="command_clickTira" active="false"/>
                <Button id="cmdRitira%d" text="Riprova" font="%s" fontSize="13" preferredWidth="70"
                        color="%s" textColor="Black" onClick="command_clickRitira" active="false"
                        tooltip="Il CiC ritira il dado" tooltipPosition="Above"/>
                <Button id="cmdHolds%d" text="Fermo" font="%s" fontSize="13" preferredWidth="60"
                        color="%s" textColor="Black" onClick="command_clickHolds" active="false"
                        tooltip="La Brigata resta ferma (HOLDS)" tooltipPosition="Above"/>
            </HorizontalLayout>
]], i, P.rowHeight,
            i, P.font, P.textColor, P.rowBg,
            i, P.font, P.noteColor,
            i, P.font, P.textColor,
            i, P.dadoLato, P.dadoLato, i, P.dadoLato, P.dadoLato,
            i, P.font, P.actionBg,
            i, P.font, P.actionBg,
            i, P.font, P.closeBg)
    end

    return string.format([[
    <Panel id="cmdPanel" active="false" rectAlignment="%s" offsetXY="%s"
           width="%d" height="%d" color="%s">
        <VerticalLayout padding="%d %d %d %d" spacing="%d" childForceExpandHeight="false" childAlignment="UpperCenter">
            <Text id="cmdTitolo" text="COMANDO" font="%s" fontSize="16" fontStyle="Bold" color="%s"
                  alignment="MiddleCenter" preferredHeight="%d"/>
            <Text id="cmdScelta" text="" font="%s" fontSize="14" color="White"
                  alignment="MiddleCenter" preferredHeight="%d"/>
%s
            <Text id="cmdNota" text="" font="%s" fontSize="11" color="%s"
                  alignment="MiddleCenter" preferredHeight="%d"/>
        </VerticalLayout>
    </Panel>
]], P.rectAlignment, P.offsetXY, P.width, command_panelHeight(P.righeMax), P.bg,
        P.padding, P.padding, P.padding, P.padding, P.spacing,
        P.font, P.titleColor, P.headerHeight,
        P.font, P.sceltaHeight,
        righe, P.font, P.noteColor, P.footerHeight)
end
-- ============================================================
-- FUNZIONE: command_rowText(d)
-- Testo dello stato (i dadi si vedono come facce).
-- ============================================================
function command_rowText(d)
    return COMMAND_PANEL.statoTesto[d.stato] or d.stato
end
-- ============================================================
-- FUNZIONE: command_panelRows(slot)
-- Righe del pannello in ordine: { tipo = "div", divId } e
-- { tipo = "gruppo", key }.
-- ============================================================
function command_panelRows(slot)
    local st = COMMAND_STATE[slot]
    local righe = {}
    for _, key in ipairs(st.ordine) do
        table.insert(righe, { tipo = "gruppo", key = key })
    end
    return righe
end
-- ============================================================
-- FUNZIONE: command_redrawPanel()
-- Aggiorna il pannello; lo spegne fuori dalla fase di Comando.
-- COMMAND_ROWS[i] = chiave del gruppo della riga i (per i click).
-- ============================================================
COMMAND_ROWS = {}

function command_redrawPanel()
    local P = COMMAND_PANEL
    local slot = TURN and TURN.activeSide
    local st = slot and COMMAND_STATE[slot]
    COMMAND_ROWS = {}

    if not ENGINE or ENGINE.phase ~= PHASE.COMMAND or not st then
        UI.setAttribute("cmdPanel", "active", "false")
        return
    end

    local elenco = command_panelRows(slot)
    local righe = math.min(#elenco, P.righeMax)
    UI.setAttribute("cmdPanel", "active", "true")
    UI.setAttribute("cmdPanel", "height", tostring(command_panelHeight(math.max(righe, 1))))
    UI.setAttribute("cmdTitolo", "text", "COMANDO - " .. string.upper(main_sideName(slot)))

    local visibili = main_sideVisibility(slot)
    local inVolo = COMMAND_ROLLING or COMMAND_PENDING ~= nil

    for i = 1, P.righeMax do
        local r = elenco[i]
        if not r then
            UI.setAttribute("cmdRow" .. i, "active", "false")
        elseif r.tipo == "div" then
            local div = st.divisioni[r.divId]
            UI.setAttribute("cmdRow" .. i, "active", "true")
            UI.setAttribute("cmdNome" .. i, "text", div and div.nome or tostring(r.divId))
            UI.setAttribute("cmdNome" .. i, "textColor", P.titleColor)
            UI.setAttribute("cmdGen" .. i, "text", div and ("Gen " .. tostring(div.valore)) or "")
            UI.setAttribute("cmdStato" .. i, "text", "")
            for _, nome in ipairs({ "cmdTira", "cmdRitira", "cmdHolds" }) do
                UI.setAttribute(nome .. i, "active", "false")
            end
        else
            local key = r.key
            local d = st.gruppi[key]
            COMMAND_ROWS[i] = key
            UI.setAttribute("cmdRow" .. i, "active", "true")
            UI.setAttribute("cmdNome" .. i, "text", "  " .. d.nome)
            UI.setAttribute("cmdNome" .. i, "textColor", (COMMAND_FOCUS and COMMAND_FOCUS.key == key) and P.titleColor or P.textColor)
            UI.setAttribute("cmdGen" .. i, "text", d.valore and ("Gen " .. tostring(d.valore)) or "-")
            UI.setAttribute("cmdStato" .. i, "text", command_rowText(d))
            UI.setAttribute("cmdStato" .. i, "color", P.statoColor[d.stato] or P.textColor)

            -- Bottoni: solo lo schieramento attivo, solo quelli utili
            local scelta = COMMAND_PENDING and COMMAND_PENDING.key == key
            local tira   = d.stato == COMMAND_STATO.DA_TIRARE and (not inVolo or scelta)
            local ritira = d.stato == COMMAND_STATO.FALLITA and command_canReroll(slot, key) and (not inVolo or scelta)
            local holds  = d.stato == COMMAND_STATO.FALLITA and not COMMAND_ROLLING
            for nome, acceso in pairs({ cmdTira = tira, cmdRitira = ritira, cmdHolds = holds }) do
                UI.setAttribute(nome .. i, "active", acceso and "true" or "false")
                UI.setAttribute(nome .. i, "visibility", visibili)
            end
            -- bottone del tiro scelto: si tira coi dadi del vassoio
            UI.setAttribute("cmdTira" .. i, "text", (scelta and COMMAND_PENDING.tipo == "tiro") and "Dadi" or "Attiva")
            UI.setAttribute("cmdRitira" .. i, "text", (scelta and COMMAND_PENDING.tipo == "ritiro") and "Dadi" or "Riprova")
            -- facce dei dadi tirati (asset d1..d6)
            UI.setAttribute("cmdDado" .. i, "active", d.tiro and "true" or "false")
            if d.tiro then UI.setAttribute("cmdDado" .. i, "image", "d" .. tostring(d.tiro)) end
            UI.setAttribute("cmdDadoR" .. i, "active", d.ritiro and "true" or "false")
            if d.ritiro then UI.setAttribute("cmdDadoR" .. i, "image", "d" .. tostring(d.ritiro)) end
        end
    end

    -- Nota: CiC e ritiri
    local nota
    if not st.cic then
        nota = "Nessun CiC: niente Riprova"
    else
        nota = string.format("CiC %d - Riprova usati %d", st.cic.valore, st.ritiriUsati)
        if COMMAND_RITIRI_MAX then nota = nota .. " su " .. COMMAND_RITIRI_MAX end
        nota = nota .. " - raggio " .. COMMAND_RITIRO_D .. " D"
    end
    if #elenco > P.righeMax then
        nota = nota .. string.format(" (righe %d su %d)", P.righeMax, #elenco)
    end
    UI.setAttribute("cmdNota", "text", nota)
    UI.setAttribute("cmdScelta", "text", command_sceltaText(slot))
    UI.setAttribute("cmdScelta", "color", (COMMAND_ESITO and COMMAND_ESITO.colore) or "White")
end
-- ============================================================
-- FUNZIONE: command_sceltaText(slot)
-- Riga in cima: tiro scelto (cosa si attiva, chi tira, cosa
-- serve) o l'esito dell'ultimo tiro.
-- ============================================================
function command_sceltaText(slot)
    local pend = COMMAND_PENDING
    if pend and pend.slot == slot then
        local g = command_group(slot, pend.key)
        local chi = pend.tipo == "ritiro" and "CiC" or (g and g.brigId and "Gen. di Brigata" or "Gen. di Divisione")
        return string.format("%s: %s %d, serve %d o meno su 1D6 - premi Roll sul vassoio",
            g and g.nome or pend.key, chi, pend.valore, pend.valore)
    end
    if COMMAND_ESITO then return COMMAND_ESITO.testo end
    return "Scegli una Brigata: Attiva"
end
