-- ============================================================
-- WARFORGE LDC — 5_command/state.ttslua
-- Stato della fase (salvato in 0_main/persistence).
-- ============================================================

-- Esito del Comando per schieramento, valido per tutta la sua
-- metà turno (Fuoco, Manovre, Mischie lo leggono con
-- command_unitInHolds). Si rifà al suo Comando successivo.
-- COMMAND_STATE[slot] = {
--   turno       = ENGINE.turn del Comando,
--   ordine      = { "D1/B1", "D1/B2", "D2/B1", "D2/-" },
--   cic         = { valore, guid, nome } o nil,
--   ritiriUsati = 0,
--   gruppi      = { [key] = { divId, brigId, nome, valore, guid, basi,
--                             tiro, ritiro, stato, motivo } },
--   divisioni   = { [divId] = { nome, valore, guid, ord } },
-- }
COMMAND_STATE = COMMAND_STATE or { [1] = nil, [2] = nil }

-- Gruppi che vanno in HOLDS al prossimo Comando dello
-- schieramento (Generale ucciso, Azione Gloriosa):
-- COMMAND_FORCED_HOLDS[slot][key] = "motivo"
COMMAND_FORCED_HOLDS = COMMAND_FORCED_HOLDS or { [1] = {}, [2] = {} }

-- Tiro scelto nel pannello, in attesa del Roll sul vassoio (non
-- salvato): { slot, key, tipo = "tiro"|"ritiro", valore }
COMMAND_PENDING = nil

-- Dadi in volo (non salvato): blocca un secondo Roll
COMMAND_ROLLING = false
