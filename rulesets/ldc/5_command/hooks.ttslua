-- ============================================================
-- WARFORGE LDC — 5_command/hooks.ttslua
-- ============================================================

-- ============================================================
-- FUNZIONE: before_command(phaseName, phase)
-- Nuovo Comando dello schieramento attivo: elenco delle
-- Brigate dal tavolo, pannello acceso.
-- ============================================================
function before_command(phaseName, phase)
    local slot = TURN.activeSide
    if slot then
        command_start(slot)
        main_warningToSide(slot, "Tira per ogni Brigata dal pannello Comando", "Yellow", 5)
        -- il pannello si apre sul CiC: camera sul CiC (Max 14/11);
        -- al primo turno dopo il ritorno della camera dei dadi
        local attesa = (ENGINE.turn or 1) <= 1 and 3.5 or 0.5
        Wait.time(function()
            if ENGINE.phase == PHASE.COMMAND and TURN.activeSide == slot then command_cameraToCic(slot) end
        end, attesa)
    end
    callHandler("updateCenterPanel")
end
-- ============================================================
-- FUNZIONE: after_command(phaseName, phase)
-- Gli stati restano per tutta la metà turno; si spengono
-- pannello e tiro in sospeso.
-- ============================================================
function after_command(phaseName, phase)
    COMMAND_FILTRO = nil
    if TURN.activeSide then command_closeFailed(TURN.activeSide) end
    COMMAND_PENDING = nil
    COMMAND_ROLLING = false
    COMMAND_ESITO = nil
    if TURN.activeSide then command_focus(TURN.activeSide, nil) end
    if TURN.activeSide then
        engine_dicePanelCloseAfter(TURN.activeSide, COMMAND_DICEPANEL_CLOSE)
    end
    engine_uiSet("cmdPanel", "active", "false")
end

-- ============================================================
-- FUNZIONE: resume_command(phaseName, phase)
-- Partita caricata: Brigate attivate, fallite e Riprova usati
-- restano; un tiro interrotto si rifà (la Brigata è ancora da
-- tirare). Pannello del CiC riaperto.
-- ============================================================
function resume_command(phaseName, phase)
    local slot = TURN.activeSide
    if slot and not COMMAND_STATE[slot] then
        return before_command(phaseName, phase)   -- salvataggio senza Comando: si parte
    end
    COMMAND_PENDING = nil
    COMMAND_ROLLING = false
    if slot then
        COMMAND_APERTE[slot] = COMMAND_APERTE[slot] or {}
        COMMAND_ANELLI_SLOT = slot
        COMMAND_FILTRO = { slot = slot, tipo = "tutte" }
        command_redrawPanel()
        command_drawStatusRings()
    end
    callHandler("updateCenterPanel")
end
