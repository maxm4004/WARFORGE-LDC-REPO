-- WARFORGE LDC — 5_command/hooks.ttslua
-- ============================================================

-- ============================================================
-- FUNZIONE: before_command(phaseName, phase)
-- Nuovo Comando dello schieramento attivo: elenco delle
-- Brigate dal tavolo, pannello acceso.
-- ============================================================
function before_command(phaseName, phase)
    local slot = TURN.activeSide
    if slot then
        command_start(slot)
        main_warningToSide(slot, "Tira per ogni Brigata dal pannello Comando", "Yellow", 5)
    end
    callHandler("updateCenterPanel")
end
-- ============================================================
-- FUNZIONE: after_command(phaseName, phase)
-- Gli stati restano per tutta la metà turno; si spengono
-- pannello e tiro in sospeso.
-- ============================================================
function after_command(phaseName, phase)
    if TURN.activeSide then command_closeFailed(TURN.activeSide) end
    COMMAND_PENDING = nil
    COMMAND_ROLLING = false
    COMMAND_ESITO = nil
    if TURN.activeSide then command_focus(TURN.activeSide, nil) end
    if TURN.activeSide then
        engine_dicePanelCloseAfter(TURN.activeSide, COMMAND_DICEPANEL_CLOSE)
    end
    engine_uiSet("cmdPanel", "active", "false")
end
