-- WARFORGE LDC — 5_command/callbacks.ttslua
-- ============================================================

-- ============================================================
-- FUNZIONE: command_btn(player, value, id, buttonConfig)
-- "Comando completato": lo schieramento attivo chiude la fase
-- (solo lui arriva qui: main_canUseButton, modalità ACTIVE),
-- solo quando tutte le Brigate sono ATTIVE o in HOLDS.
-- ============================================================
function command_btn(player, value, id)
    local slot = TURN.activeSide
    if COMMAND_ROLLING then
        warningToColor("Aspetta che i dadi si fermino", player, "Yellow", 3, false)
        return false
    end
    if not command_allResolved(slot) then
        warningToColor("Prima attiva tutte le Brigate", player, "Yellow", 5, false)
        return false
    end
    -- niente Fermo (Max 12/11): i test falliti non ripresi vanno in HOLDS
    command_closeFailed(slot)
    return true
end

-- ============================================================
--                     BOTTONI DEL PANNELLO
-- onClick dell'XML: (player, value, id), id = "cmdTira3" ecc.
-- ============================================================

-- ============================================================
-- FUNZIONE: command_rowClick(player, id, prefisso)
-- Gruppo della riga cliccata, se il click è valido.
-- Ritorna slot, key.
-- ============================================================
function command_rowClick(player, id, prefisso)
    if not ENGINE or ENGINE.phase ~= PHASE.COMMAND or ENGINE.transitionPending then return nil end
    local slot = TURN.activeSide
    if not player or not main_colorInSide(player.color, slot) then return nil end
    local i = tonumber((id or ""):match("^" .. prefisso .. "(%d+)$"))
    local key = i and COMMAND_ROWS[i]
    if not key or not command_group(slot, key) then return nil end
    return slot, key
end
-- ============================================================
-- FUNZIONE: command_clickTira(player, value, id)
-- ============================================================
function command_clickTira(player, value, id)
    local slot, key = command_rowClick(player, id, "cmdTira")
    if slot then command_choose(player, slot, key, "tiro") end
end
-- ============================================================
-- FUNZIONE: command_clickRitira(player, value, id)
-- ============================================================
function command_clickRitira(player, value, id)
    local slot, key = command_rowClick(player, id, "cmdRitira")
    if slot then command_choose(player, slot, key, "ritiro") end
end
-- ============================================================
-- FUNZIONE: command_clickNome(player, value, id)
-- Nome della Brigata: la inquadra e ne illumina le basi.
-- ============================================================
function command_clickNome(player, value, id)
    if not ENGINE or ENGINE.phase ~= PHASE.COMMAND or ENGINE.transitionPending then return end
    local slot = TURN.activeSide
    local i = tonumber((id or ""):match("^cmdNome(%d+)$"))
    -- Divisione: apre o chiude le sue Brigate (solo chi comanda)
    local divId = i and COMMAND_DIVROWS[i]
    if divId then
        if player and main_colorInSide(player.color, slot) then command_toggleDivision(slot, divId) end
        return
    end
    local s, key = command_rowClick(player, id, "cmdNome")
    if not s then return end
    command_focus(s, key, false)
    command_cameraToGroup(player, s, key)
    command_redrawPanel()
end
