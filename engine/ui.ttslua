-- ============================================================
-- WARFORGE — engine/ui.ttslua
-- Pannelli comuni a ogni ruleset e costruzione della UI.
-- ============================================================

-- ============================================================
-- FUNZIONE: getEngineUiXml()
-- Logo, messaggi al giocatore, versione.
-- ============================================================
function getEngineUiXml()
    return [[
        <!--
        <Panel id="logo_panel" rectAlignment="UpperCenter" width="650" height="500" offsetXY="-700 80" active="true">
            <Image image="https://raw.githubusercontent.com/maxm4004/warforge-ief/refs/heads/main/images/warforge.png" preserveAspect="1"/>
        </Panel>
        -->
        <Panel rectAlignment="LowerCenter" width="1100" height="60" color="rgba(0,0,0,0)" offsetXY="0 300">
            <Text id="playerGameMessage" text="" font="warforge_font" fontSize="18" color="rgba(212,175,55,0.9)" outline="#000000"
            outlineSize="1" alignment="LeftCenter"/>
        </Panel>
        <Panel id="phaseBanner" rectAlignment="MiddleCenter" width="]] .. BANNER.width .. [[" height="]] .. BANNER.height .. [["
            offsetXY="]] .. BANNER.offsetXY .. [[" color="]] .. BANNER.bg .. [[" active="false">
            <Text id="phaseBannerText" text="" font="warforge_font" fontSize="]] .. BANNER.fontSize .. [["
                color="]] .. BANNER.textColor .. [[" outline="#000000" outlineSize="2" alignment="MiddleCenter"/>
        </Panel>
        <Panel id="panelVersion" active="true"
            rectAlignment="UpperLeft"
            width="420"
            height="30"
            color="rgba(0,0,0,0.00)"
            offsetXY="0 0">
            <Text id="versione" text="" font="warforge_font" fontSize="13" color="Yellow" alignment="MiddleCenter" outline="#000000" outlineSize="1"/>
        </Panel>
    ]]
end
-- ============================================================
-- FUNZIONE: buildUI()
-- Ruleset + pannelli comuni + sottofasi + pannello dadi.
-- UI.setXml è asincrono: un setAttribute fatto mentre
-- UI.loading è vero può andare perso.
-- ============================================================
-- ============================================================
-- FUNZIONE: engine_uiSet(id, attr, valore)
-- UI.setAttribute solo se il valore cambia (prestazioni: i
-- pannelli si ridisegnano interi a ogni click). Cache svuotata
-- a ogni UI.setXml; mentre la UI carica si passa sempre (e non
-- si ricorda: il valore potrebbe andare perso). Cambiare il
-- testo di un bottone in TTS ne resetta il textColor: si
-- dimentica anche quello.
-- ============================================================
ENGINE_UI_CACHE = {}

function engine_uiSet(id, attr, valore)
    local v = tostring(valore)
    if UI.loading then
        ENGINE_UI_CACHE[id] = nil
        return UI.setAttribute(id, attr, valore)
    end
    local c = ENGINE_UI_CACHE[id]
    if not c then c = {}; ENGINE_UI_CACHE[id] = c end
    if c[attr] == v then return true end
    c[attr] = v
    if attr == "text" then c.textColor = nil end
    return UI.setAttribute(id, attr, valore)
end
-- ============================================================
-- FUNZIONE: engine_uiSetButtonText(id, testo, textColor)
-- Testo di un BOTTONE: TTS al cambio del testo rimette il
-- textColor di default (nero). Se il testo cambia, il colore si
-- riapplica subito e un frame dopo.
-- ============================================================
function engine_uiSetButtonText(id, testo, textColor)
    local c = ENGINE_UI_CACHE[id]
    local cambia = not c or c.text ~= tostring(testo)
    engine_uiSet(id, "text", testo)
    if not textColor then return end
    if cambia then
        engine_uiSet(id, "textColor", textColor)
        Wait.frames(function()
            if ENGINE_UI_CACHE[id] then ENGINE_UI_CACHE[id].textColor = nil end
            engine_uiSet(id, "textColor", textColor)
        end, 1)
    else
        engine_uiSet(id, "textColor", textColor)
    end
end
-- ============================================================
-- FUNZIONE: engine_uiForget()
-- ============================================================
function engine_uiForget()
    ENGINE_UI_CACHE = {}
end

function buildUI()
    engine_uiForget()
    local rulesetXml = callHandler("getRulesetUiXml") or ""
    local header = [[<XmlLayout xmlns="XmlLayout"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="XmlLayout ../../../Configuration/XmlLayout.xsd">]]
    local bottom = "</XmlLayout>"
    UI.setXml(header .. rulesetXml .. getEngineUiXml() .. engine_subPanelsXml() .. engine_dicePanelsXml() .. bottom)
end
-- ============================================================
-- FUNZIONE: engine_bannerShow(testo, secondi)
-- Annuncio grande al centro, visibile a tutti, che sparisce
-- da solo. Un annuncio nuovo sostituisce quello in corso.
-- ============================================================
ENGINE_BANNER_GEN = ENGINE_BANNER_GEN or 0

function engine_bannerShow(testo, secondi)
    ENGINE_BANNER_GEN = ENGINE_BANNER_GEN + 1
    local gen = ENGINE_BANNER_GEN

    engine_uiWhenReady(function()
        if gen ~= ENGINE_BANNER_GEN then return end
        engine_uiSet("phaseBannerText", "text", testo or "")
        engine_uiSet("phaseBanner", "active", "true")
    end)

    Wait.time(function()
        if gen ~= ENGINE_BANNER_GEN then return end
        engine_uiWhenReady(function()
            if gen ~= ENGINE_BANNER_GEN then return end
            engine_uiSet("phaseBanner", "active", "false")
        end)
    end, secondi or BANNER.seconds)
end
-- ============================================================
-- FUNZIONE: engine_uiWhenReady(fn)
-- Esegue fn quando la UI non sta caricando (un setAttribute
-- durante UI.setXml andrebbe perso).
-- ============================================================
function engine_uiWhenReady(fn)
    if UI.loading then
        Wait.condition(function()
            Wait.frames(fn, 1)
        end, function() return not UI.loading end, 10)
    else
        fn()
    end
end
