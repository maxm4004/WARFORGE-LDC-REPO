-- ============================================================
-- WARFORGE — engine/constants.ttslua
-- Costanti del motore (valori fissi). Le costanti di gioco
-- stanno nel ruleset (rulesets/<nome>/0_main/constants).
-- ============================================================

-- Attesa fra il click che chiude una fase e il passaggio alla
-- successiva (secondi): i bottoni si vedono grigi prima del cambio
ENGINE_TRANSITION_DELAY = 1.5

-- ------------------------------------------------------------
-- Annuncio di fase (engine/ui.ttslua): scritta grande al centro
-- ------------------------------------------------------------
BANNER = {
    seconds   = 2.5,
    offsetXY  = "0 220",
    width     = 900,
    height    = 80,
    bg        = "rgba(0,0,0,0.00)",
    fontSize  = 36,
    textColor = "#FFD833",
}

-- ------------------------------------------------------------
-- Dadi fisici (engine/dice.ttslua)
-- Vassoi e sacchetti dipendono dal tavolo del mod: una
-- postazione per colore giocatore, fornita dal ruleset con
-- main_diceStation(color). I dadi arrivano sul vassoio.
-- ------------------------------------------------------------

-- Parabola del lancio (valori di partenza, tarati su IEF; il
-- ruleset può sostituirli ridefinendo DICE_THROW)
DICE_THROW = {
    rollHeight = 4,      -- altezza della parabola: più alta = più lenta
    forza      = 0.68,   -- moltiplicatore della velocità: < 1 corto, > 1 lungo
    spread     = 3,      -- dispersione casuale della velocità
    stagger    = 0.15,   -- secondi fra un dado e il successivo
    spawnY     = 4,      -- altezza di comparsa sopra il sacchetto
}

-- Colori dei bottoni 3D Roll / Cestino sui vassoi dei dadi
ENGINE_DICE_BTN_COLORS = {
    [1] = "#BA1307|#F55E51|#3f3f3f|#1f1f1f",
    [2] = "#05754D|#07BA7A|#3f3f3f|#1f1f1f",
}

-- ------------------------------------------------------------
-- Pannello dadi condiviso (engine/dicepanel.ttslua)
-- ------------------------------------------------------------
DICEPANEL = DICEPANEL or {
    rectAlignment = "MiddleCenter",
    offsetXY      = "0 -345",
    colWidth      = 330,      -- larghezza di una colonna
    colGap        = 16,       -- spazio fra le due colonne
    bg            = "rgba(0,0,0,0.70)",
    padding       = 12,
    spacing       = 2,
    font          = "warforge_font",
    titleColor    = "#FFD833",   -- titolo, intestazioni di sezione, "serve"
    textColor     = "White",
    subColor      = "#BBBBBB",   -- sottotitolo (nota sotto il titolo)
    titleHeight   = 24,
    subHeight     = 16,
    rowHeight     = 17,
    needHeight    = 22,
    outcomeHeight = 26,
    noteHeight    = 30,       -- nota sotto l'esito (2 righe)
    valueWidth    = 90,       -- colonna dei valori delle righe
    maxRows       = 14,
    maxFaces      = 24,
    faceSize      = 28,
    faceSpacing   = 4,
    faceKoColor   = "rgba(1,1,1,0.3)",   -- dado non riuscito (con soglia)
    okColor       = "#5BD35B",            -- esito positivo, dado a segno, bonus
    koColor       = "#FF6B6B",            -- esito negativo, malus
}

-- ------------------------------------------------------------
-- Pannelli sottofase (engine/subphase.ttslua)
-- ------------------------------------------------------------
SUBPANEL = {
    offsetXY   = "0 -280",
    width      = 450,
    height     = 55,
    bg         = "rgba(0,0,0,0.70)",
    btnColor   = "#B8902E",
    btnWidth   = 200,
    btnHeight  = 40,
    btnMax     = 4,      -- bottoni disponibili per pannello
    btnSpacing = 8,      -- spazio fra i bottoni
}
