-- ============================================================
-- WARFORGE — engine/utils.ttslua
-- Messaggi al giocatore, chat e utilità generiche.
-- ============================================================

-- Contatore dei messaggi: il timer di un messaggio vecchio non
-- spegne quello arrivato dopo
ENGINE_MSG_GEN = ENGINE_MSG_GEN or 0
ENGINE_WARNING_ACTIVE = false

-- ============================================================
-- FUNZIONE: engine_handleChat(message, player)
-- Chiamata dal Global comune in onChat.
-- ============================================================
function engine_handleChat(message, player)
    if message == "!restart" then callHandler("restart") return false end
    if message == "!clear"   then clear()                return false end
    return true
end

-- ============================================================
-- FUNZIONE: warningToColor(warning, player, textColor, second, inConsole)
-- Messaggio a un solo giocatore (oggetto Player).
-- ============================================================
function warningToColor(warning, player, textColor, second, inConsole)

    local color = textColor == "Yellow" and "#FFD833" or textColor

    if player then
        ENGINE_MSG_GEN = ENGINE_MSG_GEN + 1
        local gen = ENGINE_MSG_GEN

        UI.setAttribute("playerGameMessage", "Color", color)
        UI.setAttribute("playerGameMessage", "text", warning)
        UI.setAttribute("playerGameMessage", "active", "true")
        UI.setAttribute("playerGameMessage", "visibility", player.color)

        Wait.time(function()
            engine_hideGameMessage(gen)
        end, not second and 5 or second)

        if not inConsole then
            return
        end

        if player.seated then
            Wait.time(function()
                printToColor("[LOG] " .. warning, player.color, {1, 1, 1})
            end, 2)
        end
    end
end
-- ============================================================
-- FUNZIONE: warningListToColor(warnings, player, textColor, second)
-- Più messaggi a rotazione a un solo giocatore.
-- ============================================================
function warningListToColor(warnings, player, textColor, second)

    local color = textColor == "Yellow" and "#FFD833" or textColor

    if player then
        ENGINE_MSG_GEN = ENGINE_MSG_GEN + 1
        local gen = ENGINE_MSG_GEN

        UI.setAttribute("playerGameMessage", "Color", color)
        UI.setAttribute("playerGameMessage", "active", "true")
        UI.setAttribute("playerGameMessage", "visibility", player.color)

        ENGINE_WARNING_ACTIVE = true
        local a = true

        local function step(i)
            if not ENGINE_WARNING_ACTIVE or gen ~= ENGINE_MSG_GEN then return end

            UI.setAttribute("playerGameMessage", "text", warnings[i])
            if a then
                printToColor("[LOG] " .. warnings[i], player.color, {1, 1, 1})
            end

            local nextI = i + 1
            if nextI > #warnings then nextI = 1; a = false end

            Wait.time(function()
                step(nextI)
            end, second or 3)
        end

        step(1)
    end
end
-- ============================================================
-- FUNZIONE: warning(warning, textColor)
-- Messaggio a tutti i giocatori.
-- ============================================================
function warning(warning, textColor)

    local color = textColor == "Yellow" and "#FFD833" or textColor

    ENGINE_MSG_GEN = ENGINE_MSG_GEN + 1
    local gen = ENGINE_MSG_GEN

    UI.setAttribute("playerGameMessage", "Color", color)
    UI.setAttribute("playerGameMessage", "text", warning)
    UI.setAttribute("playerGameMessage", "visibility", "")
    UI.setAttribute("playerGameMessage", "active", "true")

    Wait.time(function()
        engine_hideGameMessage(gen)
    end, 5)
end
-- ============================================================
-- FUNZIONE: engine_hideGameMessage(gen)
-- Spegne il messaggio solo se nel frattempo non ne è arrivato
-- uno più recente; aspetta la fine di UI.loading.
-- ============================================================
function engine_hideGameMessage(gen)
    if gen ~= ENGINE_MSG_GEN then return end
    if UI.loading then
        Wait.condition(function()
            Wait.frames(function() engine_hideGameMessage(gen) end, 1)
        end, function() return not UI.loading end, 10)
        return
    end
    UI.setAttribute("playerGameMessage", "active", "false")
end
-- ============================================================
-- FUNZIONE: printLog(message, color)
-- ============================================================
function printLog(message, color)
    printToAll("[LOG] " .. message, color)
end
-- ============================================================
-- FUNZIONE: printTable(t, indent)
-- ============================================================
function printTable(t, indent)
    indent = indent or 0
    if type(t) ~= "table" then
        print(tostring(t))
        return
    end
    for k, v in pairs(t) do
        local prefix = string.rep("  ", indent) .. tostring(k) .. ": "
        if type(v) == "table" then
            print(prefix)
            printTable(v, indent + 1)
        else
            print(prefix .. tostring(v))
        end
    end
end
-- ============================================================
-- FUNZIONE: clear()
-- Svuota la chat.
-- ============================================================
function clear()
    for i = 0, 250 do
        printToAll("")
    end
end
